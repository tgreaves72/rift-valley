# Public portfolio allowlist. Local archives and session evidence stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/docs/
!/src/
!/tests/
!/build/
!/assets/
!/deploy/
!/dist/

**/__pycache__/
*.pyc
*.log
*.lock
.env
.env.*
*.pem
*.key

# Historical release tools require local archives that are not distributed.
/build/finalize_*.py
/build/combine_multiplayer_checks.py
/build/verify_release.py
/build/collect_activity_results.py
/build/collect_studio_results.py

/deploy/*
!/deploy/CATCHER-DESIGN.txt
!/deploy/CHANGELOG.txt
!/deploy/COSMETICS.txt
!/deploy/DEPLOYMENT.txt
!/deploy/gamepasses.json
!/deploy/MASTERY.txt
!/deploy/MONETIZATION.txt
!/deploy/MUSIC.txt
!/deploy/PLAYTEST.txt
!/deploy/Publish.ps1
!/deploy/checksums.json
!/deploy/release.json

/dist/*
!/dist/RiftValley.rbxl
!/dist/RiftValley-0.15.0.rbxl
!/dist/RiftValley.rbxlx
!/dist/RiftStalker-Design.rbxm
!/dist/RiftStalker-Animations.rbxm
