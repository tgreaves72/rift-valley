	Passes = {
		{ key = "VIP", name = "Valley VIP", tagline = "MAKE AN ENTRANCE", description = "Sky lounge, exclusive cosmetics, and speed coil, jump coil and Rift Blaster for the VIP Arena. Gear works only in the VIP Arena.", rgb = { 255, 196, 99 } },
		{ key = "DoubleCoins", name = "Double Coins", tagline = "MORE COINS. MORE STYLE.", description = "Permanently earn 2x coins from multiplayer crossings, tags, crystals and wins.", rgb = { 108, 255, 204 } },
		{ key = "StylePack", name = "Prism Trail Pack", tagline = "LIGHT UP EVERY CHASE", description = "Unlock Aurora, Prism and Ember animated color trails. Equip them in Trails.", rgb = { 190, 139, 255 } },
	},
	Trails = {
