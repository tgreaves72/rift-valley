		{ id = "RiftHunter", slot = "Title", name = "Rift Hunter", requirement = { stat = "Tags", amount = 10 }, text = "RIFT HUNTER", rgb = { 181, 130, 255 } },
		{ id = "ValleySurvivor", slot = "Title", name = "Valley Survivor", requirement = { stat = "Wins", amount = 1 }, text = "VALLEY SURVIVOR", rgb = { 255, 211, 126 } },
