voteTally.AnchorPoint, voteTally.Visible = Vector2.new(1, 0), false
label(voteTally, "Title", "Next Map", UDim2.fromOffset(186, 24), UDim2.fromOffset(12, 6), 16, palette.paper).TextXAlignment = Enum.TextXAlignment.Left
