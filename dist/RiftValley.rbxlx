goalLabel.TextStrokeTransparency = 0.45

local sprinting = false
local dashUntil = 0
local dashDirection = Vector3.zero
local function sprint(_, inputState)
	if inputState == Enum.UserInputState.Begin then sprinting = true
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then sprinting = false end
	Remote:FireServer("Sprint", sprinting)
	return Enum.ContextActionResult.Sink
end

local function dash(_, inputState)
	if inputState ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Sink end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root then
		local move = humanoid.MoveDirection
		if move.Magnitude &lt; 0.1 then move = root.CFrame.LookVector end
		Remote:FireServer("Dash", Vector3.new(move.X, 0, move.Z).Unit)
	end
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindAction("RiftSprint", sprint, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
ContextActionService:BindAction("RiftDash", dash, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
ContextActionService:SetTitle("RiftSprint", "SPRINT")
ContextActionService:SetTitle("RiftDash", "DASH")
ContextActionService:SetPosition("RiftSprint", UDim2.new(1, -190, 1, -155))
ContextActionService:SetPosition("RiftDash", UDim2.new(1, -120, 1, -210))
UserInputService.WindowFocusReleased:Connect(function() sprinting = false Remote:FireServer("Sprint", false) end)
local function characterReady(character)
	sprinting = false dashUntil = 0 Remote:FireServer("Sprint", false)
	task.spawn(function()
		local root=character:WaitForChild("HumanoidRootPart",10)
		if not root then return end
		RunService.RenderStepped:Wait()
		if player.Character==character then Remote:FireServer("CharacterReady",character) end
	end)
end
player.CharacterAdded:Connect(characterReady)
if player.Character then characterReady(player.Character) end

local rng = Random.new()
local function burst(position, color, count)
	for _ = 1, count do
		local part = Instance.new("Part")
		part.Name, part.Size = "LocalCelebration", Vector3.new(.28, .28, .28)
		part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
		part.Color, part.Material, part.CFrame = color, Enum.Material.Neon, CFrame.new(position)
		part.Parent = workspace
		TweenService:Create(part, TweenInfo.new(.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-7, 7), rng:NextNumber(2, 9), rng:NextNumber(-7, 7))) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), Transparency = 1,
		}):Play()
		Debris:AddItem(part, .9)
	end
end

Remote.OnClientEvent:Connect(function(action, payload, kind)
	if action == "Notice" then showNotice(payload)
	elseif action == "MasteryResult" and type(payload) == "table" and (payload.practice or payload.stage == #Config.Courses) then
		noticeToken += 1
		notice.Visible = false
	elseif action == "ScoutUnlocked" then
		-- The equipped title and collection update without covering a running course.
		if player:GetAttribute("Role") ~= "Runner" then showNotice("Rift Scout Unlocked!", 2.5) end
	elseif action == "DashStop" then dashUntil = 0
	elseif action == "CourseClear" then burst(payload.position, palette.mint, 12)
	elseif action == "Dash" then
		dashDirection, dashUntil = payload, os.clock() + Config.DashDuration
	elseif action == "OpenPasses" then openShop(true)
	elseif action == "OpenCosmetics" then openShop("cosmetics") updateCosmetics()
	elseif action == "Confetti" then burst(payload, palette.violet, 20)
	elseif action == "Recharge" then burst(payload + Vector3.new(0, 2, 0), kind == "Stamina" and Color3.fromRGB(108, 255, 204) or Color3.fromRGB(123, 224, 255), 12)
	elseif action == "Crystal" then
		if typeof(payload) == "Instance" and payload:IsA("BasePart") and payload.Parent then
			payload.LocalTransparencyModifier = .9
			burst(payload.Position, payload.Color, 8)
		end
	elseif action == "Results" then
		if not player:GetAttribute("CoursePractice") then showNotice(payload.won and "You Win!" or "Nice Try!", 2.5) end
	end
end)

local function updateProfile()
	coins.Text = tostring(player:GetAttribute("Coins") or 0) .. " Coins"
	local owned = "," .. (player:GetAttribute("OwnedTrails") or "None") .. ","
	local equipped = player:GetAttribute("Equipped") or "None"
	for _, trail in ipairs(Config.Trails) do
		local available = string.find(owned, "," .. trail.id .. ",", 1, true) ~= nil
		shopRows[trail.id].Text = trail.id == equipped and "EQUIPPED" or (available and "EQUIP" or (trail.pass and "VIEW PASS" or (trail.requirement and "LOCKED" or "UNLOCK")))
		shopRows[trail.id].Active = trail.id ~= equipped and (not trail.requirement or available)
		shopRows[trail.id].Selectable = shopRows[trail.id].Active
	end
	updateCosmetics()
	saveLabel.Text = passesContent.Visible and "One-time Robux purchases. Everyone shares the same chase abilities." or (cosmeticsContent.Visible and ((player:GetAttribute("SaveStatus") or "Loading profile") .. "\nEarn coins or complete goals. Wear one aura + one title.") or ((player:GetAttribute("SaveStatus") or "Loading profile") .. "\nCosmetic trails change appearance."))
end
passesTab.Activated:Connect(updateProfile)
trailsTab.Activated:Connect(updateProfile)
for _, attribute in ipairs({ "Coins", "Level", "Wins", "Tags", "Crossings", "OwnedTrails", "Equipped", "SaveStatus", "CosmeticsUnlocked", "AuraEquipped", "TitleEquipped", "SkinEquipped", "VictoryEquipped", "MedalPoints", "SilverMedals", "GoldMedals", "GroveMedals", "RuinsMedals", "HarborMedals" }) do
	player:GetAttributeChangedSignal(attribute):Connect(updateProfile)
end
updateProfile()
player:GetAttributeChangedSignal("MasteryMenuOpen"):Connect(function()
	if player:GetAttribute("MasteryMenuOpen") then shop.Visible,help.Visible,vote.Visible = false,false,false end
end)
player:GetAttributeChangedSignal("MasteryRewardsOpen"):Connect(function()
	if player:GetAttribute("MasteryRewardsOpen") then player:SetAttribute("MasteryRewardsOpen",false) openShop("cosmetics") updateCosmetics() end
end)

local function updateLayout()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local width, height = camera.ViewportSize.X, camera.ViewportSize.Y
	local compact = width &lt; 820
	header.Size = UDim2.fromOffset(compact and 306 or 340, 76)
	header.Position = UDim2.new(0.5, compact and -153 or -170, 0, 10)
	status.TextSize = compact and 22 or 25
	resources.Size = UDim2.fromOffset(132, 46)
	resources.Position = compact and UDim2.fromOffset(10, 100) or UDim2.fromOffset(14, 14)
	local mobile = UserInputService.TouchEnabled
	local tallyScale = voteTally:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	local narrowTally = width &lt; 370
	tallyScale.Scale, tallyScale.Parent = math.min(height &lt; 480 and .82 or 1, (width-(narrowTally and 140 or 24))/210), voteTally
	voteTally.Position = UDim2.new(1, compact and -10 or -14, 0, narrowTally and 154 or (compact and 100 or 104))
	staminaPanel.Size = UDim2.fromOffset(mobile and 230 or 250, 64)
	staminaPanel.Position = UDim2.new(0.5, mobile and -115 or -125, 1, mobile and -112 or -80)
	local short = compact and height &lt; 480
	if short then
		leftButtons.Size, leftButtons.Position = UDim2.fromOffset(140, 152), UDim2.fromOffset(10, 158)
	elseif compact then
		leftButtons.Size, leftButtons.Position = UDim2.fromOffset(108, 262), UDim2.fromOffset(10, 158)
	else
		leftButtons.Size, leftButtons.Position = UDim2.fromOffset(130, 262), UDim2.new(0, 14, 1, -278)
	end
	for index, item in ipairs({shopButton, vipButton, voteButton, masteryButton, helpButton, journeyButton}) do
		item.Size = short and UDim2.fromOffset(59, 42) or UDim2.new(1, -16, 0, 34)
		item.Position = short and UDim2.fromOffset(8+((index-1)%2)*65, 7+math.floor((index-1)/2)*48) or UDim2.fromOffset(8, 8+(index-1)*42)
		item.TextSize = short and 12 or 15
	end
	controls.Text = mobile and "Tap Dash  /  Hold Sprint" or (UserInputService.GamepadEnabled and "B Dash  /  L3 Sprint" or "Q Dash  /  Shift Sprint")
	for _, frame in ipairs({ help, shop, vote }) do
		local scale = frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		scale.Scale = math.min(1, (width - 24) / frame.Size.X.Offset, (height - 32) / frame.Size.Y.Offset)
		scale.Parent = frame
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
	end
	local noticeScale = notice:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	noticeScale.Scale, noticeScale.Parent = math.min(1, (width-24)/240), notice
	notice.AnchorPoint = Vector2.new(.5, 0)
	notice.Position = compact and height &lt; 480 and UDim2.new(.5, 0, 0, 94) or UDim2.new(.5, 0, 1, -212)
end

local watchedCamera
local cameraConnection
local function watchCamera()
	watchedCamera = workspace.CurrentCamera
	if cameraConnection then cameraConnection:Disconnect() end
	if watchedCamera then cameraConnection = watchedCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLayout) end
	updateLayout()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

local lastRefresh = 0
local performanceTime, performanceFrames = 0, 0
local cosmeticAt = 0
local shownPhase = ""
RunService.RenderStepped:Connect(function(dt)
	performanceTime += dt
	performanceFrames += 1
	if performanceTime &gt;= 30 then
		Remote:FireServer("Playtest", { fps = math.clamp(performanceFrames/performanceTime, 1, 240), touch = UserInputService.TouchEnabled })
		performanceTime, performanceFrames = 0, 0
	end
	local phase = ReplicatedStorage:GetAttribute("Phase") or "Starting"
	local currentRole = player:GetAttribute("Role") or "Spectator"
	local training = player:GetAttribute("CoursePractice") == true
	local lesson=player:GetAttribute("TutorialActive")==true
	local journey=player:GetAttribute("JourneyMenuOpen")==true
	if journey or lesson then shop.Visible,help.Visible,vote.Visible=false,false,false player:SetAttribute("MasteryMenuOpen",false) end
	local now = workspace:GetServerTimeNow()
	local seconds = math.max(0, math.ceil((ReplicatedStorage:GetAttribute("Deadline") or now) - now))
	timer.Text = training and string.format("%.1f",player:GetAttribute("PracticeFinalTime") or math.max(0,now-(player:GetAttribute("PracticeStartedAt") or now))) or (phase == "Starting" and "..." or tostring(seconds))
	timer.TextSize = training and 20 or 27
	local labels = { Starting = "Loading...", Intermission = "Next Run!", Ready = "Get Ready!", Crossing = "Run to Finish!", Results = "Nice Run!" }
	status.Text = labels[phase] or "Get Ready!"
	local wave = player:GetAttribute("CourseStage") or 0
	local course = Config.Courses[wave]
	local racing = training or ((phase == "Crossing" or phase == "Ready") and wave &gt; 0)
	status.Position = UDim2.fromOffset(18, racing and 8 or 20)
	detail.Text = racing and tostring(wave) .. " / " .. #Config.Courses or ""
	for index, dot in ipairs(courseDots) do
		dot.Visible = racing
		dot.BackgroundColor3 = index &lt; wave and palette.mint or (index == wave and palette.amber or palette.muted)
		dot.BackgroundTransparency = index &gt; wave and .6 or 0
	end
	local inLobby = currentRole == "Spectator" or currentRole == "Escaped"
	leftButtons.Visible = inLobby and not lesson
	parkourRetry.Visible = inLobby and not training and player:GetAttribute("ParkourRetryAvailable")==true
		and not shop.Visible and not help.Visible and not vote.Visible and not player:GetAttribute("MasteryMenuOpen") and not journey and not lesson
	parkourRetry.Active,parkourRetry.Selectable = not player:GetAttribute("ParkourRetryPending"),not player:GetAttribute("ParkourRetryPending")
	parkourRetry.Text = player:GetAttribute("ParkourRetryPending") and "Respawning..." or "Retry Parkour"
	voteTally.Visible = inLobby and not training and phase == "Intermission" and ReplicatedStorage:GetAttribute("VotingOpen") == true
		and not shop.Visible and not help.Visible and not vote.Visible and not player:GetAttribute("MasteryMenuOpen") and not journey and not lesson
	staminaPanel.Visible = lesson or training or ((phase == "Crossing" or phase == "Ready") and (currentRole == "Runner" or currentRole == "Catcher")) or (inLobby and player:GetAttribute("ParkourActive") == true)
	starterGoal.Visible = inLobby and phase ~= "Results" and not player:GetAttribute("ParkourActive") and (player:GetAttribute("Crossings") or 0) &lt; 3 and not shop.Visible and not help.Visible and not vote.Visible and not player:GetAttribute("MasteryMenuOpen") and not journey and not lesson
	starterProgress.Text = tostring(math.min(3, player:GetAttribute("Crossings") or 0)) .. " / 3"
	retryButton.Visible = not training and ((phase == "Results" and ReplicatedStorage:GetAttribute("Practice") == true) or (phase == "Intermission" and player:GetAttribute("SoloPaused") == true))
	retryButton.Text = player:GetAttribute("SoloPaused") and "Play!" or "Run Again!"
	lobbyButton.Visible = not training and phase == "Results" and ReplicatedStorage:GetAttribute("Practice") == true and not player:GetAttribute("SoloPaused")
	voteButton.Text = "Maps"
	local readyIn = math.max(0, (player:GetAttribute("DashReadyAt") or 0) - now)
	role.Text = readyIn &gt; 0 and string.format("Dash %.1fs", readyIn) or "Dash Ready!"
	role.TextColor3 = currentRole == "Catcher" and palette.violet or palette.mint
	if phase == "Crossing" then
		if currentRole == "Catcher" then status.Text = "Catch Runners!"
		elseif currentRole == "Escaped" then status.Text = "You Made It!"
		elseif currentRole == "Captured" then status.Text = "Gotcha!"
		elseif currentRole == "Spectator" then status.Text = "Next Run Soon!" end
	end
	if currentRole == "Captured" then role.Text = "Gotcha!" role.TextColor3 = palette.violet end
	if lesson then status.Text=({"Jump!","Sprint!","Dash!"})[player:GetAttribute("TutorialStep") or 1] timer.Text="★" end
	if training then status.Text = player:GetAttribute("PracticeFinished") and "Nice Practice!" or (now &lt; (player:GetAttribute("PracticeStartedAt") or 0) and "Get Ready!" or "Practice Run!") end
	if inLobby and player:GetAttribute("ParkourActive") then
		role.Text = "Parkour " .. tostring(player:GetAttribute("ParkourCheckpoint") or 0) .. " / " .. tostring(Config.ParkourSteps)
		local elapsed = now - (player:GetAttribute("ParkourStartedAt") or now)
		local best = player:GetAttribute("ParkourBest")
		controls.Text = string.format("%.1fs%s", elapsed, best and string.format("  /  Best %.1fs", best) or "")
	else
		controls.Text = UserInputService.TouchEnabled and "Tap Dash  /  Hold Sprint" or (UserInputService.GamepadEnabled and "B Dash  /  L3 Sprint" or "Q Dash  /  Shift Sprint")
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if currentRole == "Runner" and phase == "Crossing" and wave == 1 and root then
			if not player:GetAttribute("SprintLearned") and root.Position.Z &lt; -95 then
				controls.Text = UserInputService.TouchEnabled and "Hold Sprint!" or (UserInputService.GamepadEnabled and "Press L3 to Sprint!" or "Hold Shift to Sprint!")
			elseif not player:GetAttribute("DashLearned") and root.Position.Z &gt; -110 and root.Position.Z &lt; -45 then
				controls.Text = UserInputService.TouchEnabled and "Tap Dash!" or (UserInputService.GamepadEnabled and "Press B to Dash!" or "Press Q to Dash!")
			end
		end
	end
	if currentRole == "Runner" and (player:GetAttribute("SafeUntil") or 0) &gt; now then role.Text = "Safe Landing" end
	if player:GetAttribute("RouteBoost") then role.Text = "Speed Boost!" end
	local stamina = player:GetAttribute("Stamina") or 100
	fill.Size = UDim2.fromScale(stamina / Config.StaminaMax, 1)
	fill.BackgroundColor3 = stamina &lt; 25 and palette.amber or palette.mint
	ContextActionService:SetTitle("RiftDash", readyIn &gt; 0 and string.format("%.1f", readyIn) or "DASH")
	beacon.Enabled = training or ((phase == "Crossing" or phase == "Ready") and currentRole == "Runner")
	goal.Position = Vector3.new(course and course.x or 0, 2+(training and (player:GetAttribute("PracticeOffsetY") or 0) or 0), (course and course.z or 0) + Config.StartZ)
	goalLabel.Text = "Finish!"
	local camera = workspace.CurrentCamera
	if camera and camera.CameraType ~= Enum.CameraType.Scriptable then
		local desired = os.clock() &lt; dashUntil and 88 or (sprinting and (training or phase == "Crossing") and stamina &gt; 0 and 80 or 72)
		camera.FieldOfView += (desired - camera.FieldOfView) * math.min(1, dt * 7)
	end
	if os.clock() &lt; dashUntil and (lesson or training or phase == "Crossing") and (lesson or training or currentRole == "Runner" or currentRole == "Catcher") and not player:GetAttribute("BeingCaptured") then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then root.AssemblyLinearVelocity = dashDirection * Config.DashSpeed + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0) end
	end
	if os.clock() - lastRefresh &gt; 0.8 then
		lastRefresh = os.clock()
		Remote:FireServer("Sprint", sprinting)
	end
	if phase ~= shownPhase then
		shownPhase = phase
		if phase == "Ready" and not training then
			shop.Visible, help.Visible, vote.Visible = false, false, false
			notice.Visible, noticeToken = false, noticeToken+1
		end
		if phase == "Crossing" then
			TweenService:Create(header, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(57, 44, 91) }):Play()
		else
			TweenService:Create(header, TweenInfo.new(0.2), { BackgroundColor3 = palette.ink }):Play()
		end
	end
	if os.clock() - cosmeticAt &gt;= .1 then
		cosmeticAt = os.clock()
		for _, other in ipairs(Players:GetPlayers()) do
			local root = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			local trail = root and root:FindFirstChild("RiftTrail")
			if trail and trail:GetAttribute("PaletteId") then
				for _, definition in ipairs(Config.Trails) do
					if definition.id == trail:GetAttribute("PaletteId") and definition.colors then
						local keys = {}
						for index = 1, #definition.colors do
							local offset = cosmeticAt * .5 + index - 1
							local a = 1 + math.floor(offset) % #definition.colors
							local b = 1 + a % #definition.colors
							local color = Color3.fromRGB(unpack(definition.colors[a])):Lerp(Color3.fromRGB(unpack(definition.colors[b])), offset % 1)
							table.insert(keys, ColorSequenceKeypoint.new((index - 1) / (#definition.colors - 1), color))
						end
						trail.Color = ColorSequence.new(keys)
					end
				end
			end
		end
	end
end)

</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006104">
        <Properties>
          <string name="Name">CreatureAnimation</string>
          <ProtectedString name="Source">-- Pose only the cosmetic skeleton. Root motion and tag checks stay server-authoritative.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Motion = require(game:GetService("ReplicatedStorage"):WaitForChild("RiftShared").CreatureMotion)
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("RiftShared").Config)
local rigs = {}
local function scan(model, state)
	local count = 0
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("Motor6D") and item:GetAttribute("RestPose") then
			count += 1
			if not state.motors[item.Name] then state.motors[item.Name] = { motor = item, rest = item:GetAttribute("RestPose"), pose = CFrame.identity } end
		end
	end
	state.count = count
end
local function track(model)
	if not model:IsA("Model") then return end
	local state = { motors = {}, blend = 0, stride = 0, speed = 0, landing = 0, nextScan = 0 }
	scan(model, state)
	rigs[model] = state
end
for _, model in ipairs(CollectionService:GetTagged("RiftCreature")) do track(model) end
CollectionService:GetInstanceAddedSignal("RiftCreature"):Connect(track)
CollectionService:GetInstanceRemovedSignal("RiftCreature"):Connect(function(model) rigs[model] = nil end)
RunService.PreSimulation:Connect(function(dt)
	local now = os.clock()
	for model, state in pairs(rigs) do
		if state.count &lt; 6 and now &gt;= state.nextScan then scan(model, state) state.nextScan = now + .25 end
		local root = model.PrimaryPart
		if not model.Parent or not root then continue end
		local camera = workspace.CurrentCamera
		if camera and (camera.CFrame.Position - root.Position).Magnitude &gt; 180 then continue end
		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		if state.position and dt &gt; 0 then
			local delta = root.Position - state.position
			local observed = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
			if observed &lt; 75 then speed = math.max(speed, observed) end
		end
		state.position = root.Position
		state.speed += (speed - state.speed) * math.min(1, dt * 12)
		state.blend += (math.clamp(state.speed / 7, 0, 1) - state.blend) * math.min(1, dt * 10)
		local clipName = Motion.clipForSpeed(state.speed)
		state.stride += math.min(dt, .1) / Motion.Clips[clipName].duration * math.clamp(state.speed / (clipName == "Sprint" and 36 or 25), .65, 1.4)
		local poses = Motion.sample(clipName, state.stride)
		local idle = Motion.idle(now)
		local humanoid = model:FindFirstChildOfClass("Humanoid") or (model.Parent and model.Parent:FindFirstChildOfClass("Humanoid"))
		local inAir = humanoid and humanoid.FloorMaterial == Enum.Material.Air
		if state.inAir and not inAir then state.landing = .18 end
		state.inAir = inAir
		state.landing = math.max(0, state.landing - dt)
		if inAir then poses = Motion.airborne(velocity.Y &gt; 0) end
		local dashStarted = model.Parent:GetAttribute("DashStartedAt") or 0
		local dashAge = workspace:GetServerTimeNow() - dashStarted
		local dashing = dashStarted &gt; 0 and dashAge &gt;= 0 and dashAge &lt; Config.DashDuration + .16
		if dashing then poses = Motion.dash(dashAge, Config.DashDuration) end
		local grabStage = model:GetAttribute("GrabStage")
		local charge = model:GetAttribute("ChargeStage")
		local recovering = workspace:GetServerTimeNow() &lt; (model:GetAttribute("RecoverUntil") or 0)
		if charge then poses = Motion.charge(charge == "Warning") end
		if recovering then poses = Motion.idle(now) end
		if grabStage then poses = Motion.grab(workspace:GetServerTimeNow() - (model:GetAttribute("GrabStartedAt") or 0), grabStage) end
		for name, joint in pairs(state.motors) do
			local pose = (idle[name] or CFrame.identity):Lerp(poses[name] or CFrame.identity, (inAir or grabStage or dashing or charge or recovering) and 1 or state.blend)
			if name == "CreatureSpine" and state.landing &gt; 0 then pose *= CFrame.new(0, -.16 * state.landing / .18, 0) end
			joint.pose = joint.pose:Lerp(pose, math.min(1, dt * 18))
			joint.motor.Transform = joint.pose
		end
	end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006105">
        <Properties>
          <string name="Name">CaptureEffects</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Replicated = game:GetService("ReplicatedStorage")
local Remote = Replicated:WaitForChild("RiftAction")
local localPlayer = Players.LocalPlayer
local effects = {}

local function finish(id)
	local effect = effects[id]
	if not effect then return end
	effects[id] = nil
	if effect.clone then effect.clone:Destroy() end
	for part, size in pairs(effect.mouthSizes) do if part.Parent then part.Size = size end end
	if effect.camera and workspace.CurrentCamera then
		workspace.CurrentCamera.CameraType = effect.camera.type
		workspace.CurrentCamera.CameraSubject = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") or effect.camera.subject
		workspace.CurrentCamera.FieldOfView = effect.camera.fov
	end
end

Remote.OnClientEvent:Connect(function(action, payload)
	if action == "CaptureEnd" then finish(payload) return end
	if action ~= "Capture" or not payload.victim.Character or not payload.model.Parent then return end
	local victim = payload.victim
	finish(victim.UserId)
	local source = victim.Character
	local archivable = source.Archivable
	source.Archivable = true
	local ok, clone = pcall(function() return source:Clone() end)
	source.Archivable = archivable
	if not ok or not clone then return end
	for _, item in ipairs(clone:GetDescendants()) do
		if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("ModuleScript") or item:IsA("Humanoid") or item:IsA("Highlight") then item:Destroy()
		elseif item:IsA("BasePart") then
			item.Anchored, item.CanCollide, item.CanTouch, item.CanQuery = true, false, false, false
			item.Transparency = item:GetAttribute("CaptureTransparency") or (item.Name == "HumanoidRootPart" and 1 or 0)
		elseif item:IsA("Decal") or item:IsA("Texture") then item.Transparency = item:GetAttribute("CaptureTransparency") or 0 end
	end
	clone.Name = "LocalCaptureVictim"
	clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart")
	if not clone.PrimaryPart then clone:Destroy() return end
	clone.Parent = workspace
	local effect = { clone = clone, model = payload.model, started = payload.started, duration = payload.duration, mouthSizes = {} }
	for _, name in ipairs({ "Mouth", "LowerJaw", "Tongue" }) do
		local part = payload.model:FindFirstChild(name)
		if part then effect.mouthSizes[part] = part.Size end
	end
	if victim == localPlayer and workspace.CurrentCamera then
		local camera = workspace.CurrentCamera
		effect.camera = { type = camera.CameraType, subject = camera.CameraSubject, fov = camera.FieldOfView }
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 68
	end
	effects[victim.UserId] = effect
end)

RunService.RenderStepped:Connect(function()
	local now = workspace:GetServerTimeNow()
	for id, effect in pairs(effects) do
		local root, head = effect.model.PrimaryPart, effect.model:FindFirstChild("Head")
		if not effect.model.Parent or not root or not head or now - effect.started &gt; effect.duration + .5 then finish(id) continue end
		local elapsed = now - effect.started
		local lift = math.clamp(elapsed / 1.1, 0, 1)
		lift = lift * lift * (3 - 2 * lift)
		local consume = math.clamp((elapsed - 1.1) / .7, 0, 1)
		local mouth = head.CFrame:PointToWorldSpace(Vector3.new(0, -.6, -1.25))
		local held = root.CFrame:PointToWorldSpace(Vector3.new(0, .3, -3))
		local position = held:Lerp(mouth + Vector3.new(0, .6 * (1 - consume), 0), lift)
		effect.clone:ScaleTo(math.max(.04, 1 - consume * .96))
		effect.clone:PivotTo(CFrame.lookAt(position, position - root.CFrame.LookVector))
		for part, size in pairs(effect.mouthSizes) do
			part.Size = size * Vector3.new(1 + lift*.2, 1 + lift * (part.Name == "Mouth" and 2.6 or .6), 1)
		end
		if consume &gt;= 1 then
			for _, part in ipairs(effect.clone:GetDescendants()) do if part:IsA("BasePart") or part:IsA("Decal") then part.Transparency = 1 end end
		end
		if effect.camera and workspace.CurrentCamera then
			workspace.CurrentCamera.CFrame = CFrame.lookAt(root.CFrame:PointToWorldSpace(Vector3.new(8, 5.5, -10)), root.Position + Vector3.new(0, 2, 0))
		end
	end
end)
localPlayer.CharacterAdded:Connect(function() finish(localPlayer.UserId) end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006106">
        <Properties>
          <string name="Name">HoverIcons</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local player = Players.LocalPlayer
local icons = {}
local function track(anchor)
	if not anchor or not anchor:IsA("BasePart") or icons[anchor] then return end
	local marker = anchor:FindFirstChild("HoverIcon")
	if not marker or not marker:FindFirstChild("Glyph") or not marker:FindFirstChild("Title") or not marker:FindFirstChild("Tint") then return end
	if marker:FindFirstChild("Kind") or marker:FindFirstChild("NativeVisual") then return end
	local gui = Instance.new("BillboardGui")
	gui.Name, gui.Adornee, gui.Size, gui.MaxDistance = "RiftHoverIcon", anchor, UDim2.fromOffset(176, 94), 24
	gui.AlwaysOnTop, gui.Active = true, true
	local button = Instance.new("TextButton")
	button.Size, button.Position = UDim2.fromOffset(50, 50), UDim2.fromOffset(63, 0)
	button.Text, button.Font, button.TextSize = marker.Glyph.Value, Enum.Font.FredokaOne, 32
	button.BackgroundColor3, button.TextColor3 = marker.Tint.Value, Color3.fromRGB(48, 35, 82)
	button.BorderSizePixel, button.Parent = 0, gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(.5, 0), button
	local stroke = Instance.new("UIStroke")
	stroke.Color, stroke.Thickness, stroke.Parent = marker.Tint.Value, 2, button
	local title = Instance.new("TextLabel")
	title.Size, title.Position, title.BackgroundTransparency = UDim2.fromOffset(176, 23), UDim2.fromOffset(0, 53), 1
	local names = { ["RECHARGE / AUTO"] = "Dash", ["VALLEY OUTFITTERS"] = "Shop", ["VIP SKY LOUNGE"] = "VIP", ["STYLE STUDIO"] = "Styles", ["RIFT PARKOUR"] = "Parkour", ["RETURN TO OVERLOOK"] = "Lobby", ["RETURN TO LOBBY"] = "Lobby" }
	title.Text, title.Font, title.TextSize = names[marker.Title.Value] or marker.Title.Value, Enum.Font.FredokaOne, 14
	title.TextColor3, title.TextStrokeTransparency, title.Parent = Color3.fromRGB(240, 240, 228), .35, gui
	local hint = Instance.new("TextLabel")
	hint.Size, hint.Position, hint.BackgroundTransparency = UDim2.fromOffset(176, 18), UDim2.fromOffset(0, 75), 1
	hint.Text, hint.Font, hint.TextSize = "", Enum.Font.GothamBold, 10
	hint.TextColor3, hint.Parent = marker.Tint.Value, gui
	local prompt = anchor:FindFirstChildOfClass("ProximityPrompt")
	button.Activated:Connect(function()
		if prompt and button.Active then prompt:InputHoldBegin() prompt:InputHoldEnd() end
	end)
	gui.Parent = player:WaitForChild("PlayerGui")
	icons[anchor] = { gui = gui, button = button, prompt = prompt, hint = hint, seed = math.random()*6 }
end
for _, item in ipairs(workspace:GetDescendants()) do track(item) end
workspace.DescendantAdded:Connect(function(item)
	if item:IsA("BasePart") then task.defer(track, item)
	elseif item.Name == "HoverIcon" then task.defer(track, item.Parent) end
	if item.Parent and item.Parent.Name == "HoverIcon" then task.defer(track, item.Parent.Parent) end
end)
RunService.RenderStepped:Connect(function()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for anchor, icon in pairs(icons) do
		if not anchor.Parent then icon.gui:Destroy() icons[anchor] = nil continue end
		local distance = root and (root.Position - anchor.Position).Magnitude or math.huge
		local role = player:GetAttribute("Role")
		local canUse = icon.prompt and distance &lt;= icon.prompt.MaxActivationDistance and (role == "Spectator" or role == "Escaped")
		icon.gui.Enabled = distance &lt; 24
		icon.button.Active, icon.button.Selectable = canUse == true, canUse == true
		icon.gui.StudsOffset = Vector3.new(0, math.sin(os.clock()*2 + icon.seed)*.2, 0)
		icon.hint.Text = canUse and (Input.TouchEnabled and "Tap" or (Input.GamepadEnabled and "X" or "E")) or ""
	end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006107">
        <Properties>
          <string name="Name">BuffEffects</string>
          <ProtectedString name="Source">-- Native 3D objects remain visible without a GUI. Only their cosmetic motion
-- and per-player collection cooldown brightness run on the client.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Remote = game:GetService("ReplicatedStorage"):WaitForChild("RiftAction")
local player = Players.LocalPlayer
local models = {}
local function track(model)
	if not model or not model:IsA("Model") or models[model] or not model.PrimaryPart then return end
	local vote = model.Name == "MapVoteVisual" and model:FindFirstChild("MapId")
	local coin = model.Name == "CoinVisual"
	if model.Name ~= "BuffVisual" and not vote and not coin then return end
	local marker = model.Parent and model.Parent:FindFirstChild("HoverIcon")
	local kind = marker and marker:FindFirstChild("Kind")
	if not kind and not vote and not coin then return end
	local parts = {}
	for _,part in ipairs(model:GetDescendants()) do if part:IsA("BasePart") and part.Transparency &lt; 1 then table.insert(parts,part) end end
	models[model] = {base=model.PrimaryPart.CFrame,kind=coin and "Coin" or (vote and "MapVote" or kind.Value),mapId=vote and vote.Value,
		anchor=model.Parent,parts=parts,light=model.PrimaryPart:FindFirstChild(coin and "CoinGlow" or (vote and "VoteGlow" or "BuffGlow")),seed=math.random()*6}
end
for _,obj in ipairs(workspace:GetDescendants()) do track(obj) end
workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then task.defer(track,obj)
	elseif obj.Name == "BuffCore" or obj.Name == "VoteCore" or obj.Name == "CoinCore" or obj.Name == "MapId" then task.defer(track,obj.Parent) end
end)
Remote.OnClientEvent:Connect(function(action, anchor)
	if action ~= "Crystal" then return end
	for _,record in pairs(models) do
		if record.kind == "Coin" and record.anchor == anchor then
			record.collected = true
			for _,part in ipairs(record.parts) do part.LocalTransparencyModifier = 1 end
			if record.light then record.light.Enabled = false end
		end
	end
end)
local last = 0
RunService.RenderStepped:Connect(function()
	local now = workspace:GetServerTimeNow()
	if now-last &lt; 1/30 then return end
	last = now
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for model,record in pairs(models) do
		if not model.Parent then models[model] = nil continue end
		if not root or (root.Position-record.base.Position).Magnitude &gt; 90 then continue end
		local voting = record.kind == "MapVote"
		local cooling = not voting and record.kind ~= "Coin" and now &lt; (player:GetAttribute(record.kind .. "BuffReadyAt") or 0)
		for _,part in ipairs(record.parts) do part.LocalTransparencyModifier = record.collected and 1 or (cooling and .65 or 0) end
		local selected = voting and player:GetAttribute("MapVote") == record.mapId
		if record.light then
			record.light.Enabled = not record.collected
			record.light.Brightness = cooling and .2 or (selected and 2.25 or (1.35+.35*math.sin(now*3+record.seed)))
		end
		-- Gentle height motion keeps every icon's original orientation fixed.
		if not record.collected then model:PivotTo(record.base*CFrame.new(0,math.sin(now*2+record.seed)*.3,0)) end
	end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006108">
        <Properties>
          <string name="Name">Music</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local Replicated = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Ids = require(Replicated:WaitForChild("RiftShared").MusicIds)
local player = Players.LocalPlayer
local muted = false
local current, key, generation = nil, nil, 0
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.Parent = "RiftMusic", false, player:WaitForChild("PlayerGui")
local button = Instance.new("TextButton")
button.Size, button.Position = UDim2.fromOffset(90, 29), UDim2.new(1, -105, 1, -42)
button.Text, button.Font, button.TextSize = "♫ ON", Enum.Font.FredokaOne, 13
button.BackgroundColor3, button.TextColor3 = Color3.fromRGB(48, 35, 82), Color3.fromRGB(201, 173, 255)
button.BorderSizePixel, button.Parent = 0, gui
local corner = Instance.new("UICorner")
corner.CornerRadius, corner.Parent = UDim.new(0, 15), button

local function update()
	local phase, role = Replicated:GetAttribute("Phase"), player:GetAttribute("Role")
	local training = player:GetAttribute("CoursePractice") == true
	local racing = training or ((role == "Runner" or role == "Catcher" or role == "Captured") and (phase == "Ready" or phase == "Crossing"))
	local nextKey = training and player:GetAttribute("PracticeMapId") or (racing and Replicated:GetAttribute("MapId") or "Lobby")
	if not Ids[nextKey] then button.Text = "♫ OFF" return end
	button.Text = muted and "♫ OFF" or "♫ ON"
	if nextKey == key then
		if current then TweenService:Create(current, TweenInfo.new(.35), { Volume = muted and 0 or (racing and .3 or .22) }):Play() end
		return
	end
	key, generation = nextKey, generation + 1
	local token, old = generation, current
	local sound = Instance.new("Sound")
	sound.Name, sound.SoundId, sound.Looped, sound.Volume = "RiftScore_" .. nextKey, "rbxassetid://" .. Ids[nextKey], true, 0
	sound.Parent = SoundService
	current = sound
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(1.5), { Volume = muted and 0 or (racing and .3 or .22) }):Play()
	if old then
		TweenService:Create(old, TweenInfo.new(1.5), { Volume = 0 }):Play()
		task.delay(1.6, function() if old ~= current then old:Destroy() end end)
	end
	task.delay(12, function()
		if token == generation and sound.Parent and not sound.IsLoaded then button.Text = "♫ OFF" end
	end)
end
button.Activated:Connect(function() muted = not muted update() end)
for _, name in ipairs({ "Phase", "MapId" }) do Replicated:GetAttributeChangedSignal(name):Connect(update) end
player:GetAttributeChangedSignal("Role"):Connect(update)
player:GetAttributeChangedSignal("CoursePractice"):Connect(update)
player:GetAttributeChangedSignal("PracticeMapId"):Connect(update)
update()
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006109">
        <Properties>
          <string name="Name">SkyAmbience</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Replicated=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local player=Players.LocalPlayer
local backdrop=workspace:WaitForChild("RiftBackdrop")
local ribbons,shards,stars={},{},{}
for _,part in ipairs(backdrop:GetChildren()) do
	local list=part.Name=="AuroraRibbon" and ribbons or (part.Name=="FloatingShard" and shards or (part.Name=="RiftStar" and stars))
	if list then table.insert(list,{part=part,frame=part.CFrame,seed=#list*.71}) end
end
local themes={Lobby=Color3.fromRGB(151,128,225),CrystalGrove=Color3.fromRGB(107,228,192),SunsetRuins=Color3.fromRGB(240,168,125),NeonHarbor=Color3.fromRGB(133,157,244)}
local tint=themes.Lobby
local function theme()
	local role,phase=player:GetAttribute("Role"),Replicated:GetAttribute("Phase")
	local racing=(role=="Runner" or role=="Catcher" or role=="Captured") and (phase=="Ready" or phase=="Crossing")
	local id=player:GetAttribute("CoursePractice") and player:GetAttribute("PracticeMapId") or (racing and Replicated:GetAttribute("MapId") or "Lobby")
	tint=themes[id] or themes.Lobby
	for _,item in ipairs(ribbons) do item.part.Color=tint end
	local mist=Lighting:FindFirstChild("ValleyMist")
	if mist then mist.Color=Color3.fromRGB(175,165,198):Lerp(tint,.17) end
end
for _,name in ipairs({"Phase","MapId"}) do Replicated:GetAttributeChangedSignal(name):Connect(theme) end
for _,name in ipairs({"Role","CoursePractice","PracticeMapId"}) do player:GetAttributeChangedSignal(name):Connect(theme) end
theme()
local elapsed,accumulated,cursor=0,0,0
Run.Heartbeat:Connect(function(dt)
	elapsed+=dt accumulated+=dt
	if accumulated&lt;.1 then return end accumulated=0
	for _,item in ipairs(ribbons) do
		item.part.CFrame=item.frame*CFrame.new(math.sin(elapsed*.07+item.seed)*6,math.sin(elapsed*.19+item.seed)*3,0)
		item.part.Transparency=.4+math.sin(elapsed*.3+item.seed)*.16
	end
	for _,item in ipairs(shards) do item.part.CFrame=item.frame*CFrame.new(0,math.sin(elapsed*.23+item.seed)*2.2,0) end
	-- Rotate through four stars per update rather than updating every star each frame.
	for _=1,math.min(4,#stars) do
		cursor=cursor%#stars+1
		local item=stars[cursor]
		item.part.Transparency=.12+(math.sin(elapsed*.6+item.seed)+1)*.24
	end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006110">
        <Properties>
          <string name="Name">DashEffects</string>
          <ProtectedString name="Source">-- Server-approved wind and procedural poses, visible to nearby players.
local Replicated = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(Replicated:WaitForChild("RiftShared").Config)
local Remote = Replicated:WaitForChild("RiftAction")
local effects = {}
local duration = Config.DashDuration + .16

local function restore(effect)
	for joint, original in pairs(effect.originals) do
		if joint.Parent then joint.Transform = original end
	end
	effect.originals = {}
end

local function cleanup(player)
	local effect = effects[player]
	if not effect then return end
	restore(effect)
	for _, item in ipairs(effect.items) do item:Destroy() end
	effects[player] = nil
end

local function jointPose(joint, strength, root)
	local name = string.lower(string.gsub(joint.Name, "[ _]", ""))
	local angle
	if name == "rootjoint" or name == "root" or name == "waist" then
		angle = name == "root" and -10 or (name == "waist" and -18 or -28)
	elseif name == "neck" then angle = 12
	elseif name == "leftshoulder" or name == "rightshoulder" then
		angle = -65
	elseif name == "leftelbow" or name == "rightelbow" then angle = -20
	end
	if not angle then return nil end
	local frame
	if joint:IsA("Motor6D") and joint.Part0 then frame = joint.Part0.CFrame * joint.C0
	elseif joint:IsA("AnimationConstraint") and joint.Attachment0 then frame = joint.Attachment0.WorldCFrame end
	if not frame then return nil end
	return CFrame.fromAxisAngle(frame:VectorToObjectSpace(root.CFrame.RightVector), math.rad(angle)*strength)
end

local function start(payload)
	if type(payload) ~= "table" or typeof(payload.direction) ~= "Vector3" or type(payload.started) ~= "number" then return end
	local player = payload.player
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or workspace:GetServerTimeNow() - payload.started &gt; duration then return end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - root.Position).Magnitude &gt; 180 then return end
	cleanup(player)
	local effect = { root = root, character = character, began = payload.started, direction = payload.direction,
		joints = {}, originals = {}, items = {}, ribbons = {}, streaks = {} }
	for _, joint in ipairs(character:GetDescendants()) do
		if (joint:IsA("Motor6D") or joint:IsA("AnimationConstraint")) and jointPose(joint, 1, root) then table.insert(effect.joints, joint) end
	end
	local tint = player:GetAttribute("Role") == "Catcher" and Color3.fromRGB(190, 148, 255) or Color3.fromRGB(175, 255, 231)
	for index = 1, 6 do
		local a, b = Instance.new("Attachment"), Instance.new("Attachment")
		a.Name, b.Name = "DashWindA", "DashWindB"
		a.Parent, b.Parent = root, root
		local trail = Instance.new("Trail")
		trail.Name, trail.Attachment0, trail.Attachment1 = "DashWind", a, b
		trail.Color, trail.Lifetime, trail.LightEmission = ColorSequence.new(tint), .18, 1
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, .1), NumberSequenceKeypoint.new(1, 1) })
		trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		trail.MinLength, trail.FaceCamera, trail.Parent = .05, true, root
		table.insert(effect.ribbons, { a = a, b = b, trail = trail, angle = index*math.pi/3 })
		local streak = Instance.new("Part")
		streak.Name, streak.Size, streak.Color, streak.Material = "DashGust", Vector3.new(.065, .065, 2 + index*.25), tint, Enum.Material.Neon
		streak.Anchored, streak.CanCollide, streak.CanTouch, streak.CanQuery, streak.CastShadow = true, false, false, false, false
		streak.CFrame = CFrame.new(root.Position)
		streak.Parent = workspace
		table.insert(effect.streaks, streak)
		for _, instance in ipairs({ a, b, trail, streak }) do table.insert(effect.items, instance) end
	end
	effects[player] = effect
end

Remote.OnClientEvent:Connect(function(action, payload)
	if action == "DashFX" then start(payload) end
	if action == "DashCancel" then cleanup(payload) end
end)

-- Remove our last offset before the Animator writes this frame's pose.
RunService.PreAnimation:Connect(function()
	for _, effect in pairs(effects) do restore(effect) end
end)

RunService.PreSimulation:Connect(function()
	local now = workspace:GetServerTimeNow()
	for player, effect in pairs(effects) do
		local age = now - effect.began
		if not player.Parent or player.Character ~= effect.character or not effect.root.Parent or age &gt; duration + .18
			or player:GetAttribute("BeingCaptured") then
			cleanup(player)
			continue
		end
		local strength = math.clamp(age/.04, 0, 1) * math.clamp((duration - age)/.16, 0, 1)
		if age &lt; duration then
			for _, joint in ipairs(effect.joints) do
				if joint.Parent then
					local original = joint.Transform
					effect.originals[joint] = original
					joint.Transform = original * (jointPose(joint, strength, effect.root) or CFrame.identity)
				end
			end
		end
		local frame = CFrame.lookAt(effect.root.Position, effect.root.Position + effect.direction)
		for index, ribbon in ipairs(effect.ribbons) do
			local angle = ribbon.angle + age*12
			local offset = Vector3.new(math.cos(angle)*1.5, math.sin(angle)*1.5, .9 + age*3)
			local localFrame = effect.root.CFrame:ToObjectSpace(frame)
			ribbon.a.Position = localFrame:PointToWorldSpace(offset)
			ribbon.b.Position = localFrame:PointToWorldSpace(offset + Vector3.new(.12, .12, 0))
			ribbon.trail.Enabled = age &lt; Config.DashDuration
			local streak = effect.streaks[index]
			streak.CFrame = frame * CFrame.new(offset + Vector3.new(0, 0, 2 + age*12))
			streak.Transparency = age &lt; duration and (.2 + .8*(1 - strength)) or 1
		end
	end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006111">
        <Properties>
          <string name="Name">ThreatEffects</string>
          <ProtectedString name="Source">-- The floor outline comes from the same contact limits as the server hit test.
local Rep=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Debris=game:GetService("Debris")
local Shared=Rep:WaitForChild("RiftShared")
local Rules,Config=require(Shared.Rules),require(Shared.Config)
local Remote=Rep:WaitForChild("RiftAction")
local warnings={}
local function clear(model)
 local record=warnings[model]
 if record then record.folder:Destroy() warnings[model]=nil end
end
local function edge(parent,name,a,b,color)
 local part=Instance.new("Part")
 part.Name,part.Size=name,Vector3.new(.2,.07,(b-a).Magnitude)
 part.Material,part.Color,part.Transparency=Enum.Material.Neon,color,.15
 part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery,part.CastShadow=true,false,false,false,false
 part.Parent=parent
 return {part=part,a=a,b=b}
end
local function position(record)
 local root=record.root
 local rayParams=RaycastParams.new()
 rayParams.FilterType,rayParams.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{root.Parent}
 local ground=workspace:Raycast(root.Position+Vector3.new(0,1,0),Vector3.new(0,-12,0),rayParams)
 local height=ground and ground.Position.Y+.08 or root.Position.Y-2.8
 local forward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
 if forward.Magnitude&lt;.1 then return end
 local pose=CFrame.lookAt(Vector3.new(root.Position.X,height,root.Position.Z),Vector3.new(root.Position.X,height,root.Position.Z)+forward)
 for _,line in ipairs(record.edges) do
  local a,b=pose:PointToWorldSpace(line.a),pose:PointToWorldSpace(line.b)
  line.part.CFrame=CFrame.lookAt((a+b)/2,b)
 end
end
Remote.OnClientEvent:Connect(function(action,payload)
 if action=="WarningEnd" then clear(payload) return end
 if action~="GrabWarning" and action~="ChargeWarning" then return end
 if type(payload)~="table" then return end
 local model=payload.model
 local root=model and model.PrimaryPart
 local camera=workspace.CurrentCamera
 if not root or not model.Parent or (camera and (camera.CFrame.Position-root.Position).Magnitude&gt;90) then return end
 clear(model)
 local kind=model:GetAttribute("Archetype")
 local color=action=="ChargeWarning" and Color3.fromRGB(107,226,255) or Color3.fromRGB(255,194,102)
 local folder=Instance.new("Folder")
 folder.Name,folder.Parent="RiftWarning",workspace
 local gui=Instance.new("BillboardGui")
 gui.Adornee,gui.Size,gui.StudsOffset=root,UDim2.fromOffset(42,48),Vector3.new(0,6.5,0)
 gui.MaxDistance,gui.AlwaysOnTop,gui.Parent=65,false,folder
 local label=Instance.new("TextLabel")
 label.Size,label.BackgroundTransparency,label.Text=UDim2.fromScale(1,1),1,"!"
 label.Font,label.TextSize,label.TextColor3,label.TextStrokeTransparency,label.Parent=Enum.Font.FredokaOne,40,color,.2,gui
 local highlight=Instance.new("Highlight")
 highlight.Adornee,highlight.FillColor,highlight.OutlineColor=model,color,color
 highlight.FillTransparency,highlight.OutlineTransparency,highlight.DepthMode,highlight.Parent=.88,.1,Enum.HighlightDepthMode.Occluded,folder
 local marker=Instance.new("Model") marker.Name,marker.Parent="ReachWarning",folder
 local bounds=Rules.grabBounds(kind)
 marker:SetAttribute("HalfWidth",bounds.width) marker:SetAttribute("ContactRadius",bounds.radius) marker:SetAttribute("Depth",bounds.depth)
 local polygon=Rules.grabOutline(kind)
 local edges={}
 for index,a in ipairs(polygon) do
  local b=polygon[index%#polygon+1]
  table.insert(edges,edge(marker,"ContactEdge_"..index,Vector3.new(a.x,0,a.z),Vector3.new(b.x,0,b.z),color))
 end
 if action=="ChargeWarning" then
  local reach=41*Config.ChargeDuration+bounds.depth
  for _,side in ipairs({-1,1}) do table.insert(edges,edge(marker,"ChargeRail",Vector3.new(side*bounds.width,0,0),Vector3.new(side*bounds.width,0,-reach),color)) end
  table.insert(edges,edge(marker,"ChargeEnd",Vector3.new(-bounds.width,0,-reach),Vector3.new(bounds.width,0,-reach),color))
 else
  local distance=Config.GrabLungeDistance
  for _,side in ipairs({-1,1}) do table.insert(edges,edge(marker,"LungeChevron",Vector3.new(side*.8,0,-bounds.depth-distance+1),Vector3.new(0,0,-bounds.depth-distance),color)) end
 end
 local record={folder=folder,root=root,edges=edges,untilAt=workspace:GetServerTimeNow()+math.clamp(payload.duration or .75,.1,2)}
 warnings[model]=record position(record)
 local sound=Instance.new("Sound")
 sound.SoundId,sound.Volume,sound.PlaybackSpeed="rbxasset://sounds/oof.ogg",.25,.6
 sound.RollOffMaxDistance,sound.RollOffMinDistance,sound.Parent=65,8,root
 sound:Play() Debris:AddItem(sound,2)
end)
Run.RenderStepped:Connect(function()
 local now=workspace:GetServerTimeNow()
 for model,record in pairs(warnings) do
  if not model.Parent or not record.root.Parent or now&gt;=record.untilAt then clear(model)
  else position(record) end
 end
end)

</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006112">
        <Properties>
          <string name="Name">Mastery</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local Replicated = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer
local Config = require(Replicated:WaitForChild("RiftShared").Config)
local Remote = Replicated:WaitForChild("RiftAction")
local ink, paper, mint = Color3.fromRGB(48,35,82), Color3.fromRGB(246,245,255), Color3.fromRGB(145,255,214)
local violet, muted = Color3.fromRGB(201,173,255), Color3.fromRGB(185,177,216)
local medalColors = { Color3.fromRGB(219,161,120), Color3.fromRGB(211,226,250), Color3.fromRGB(255,221,137) }
local medalNames = { "Bronze", "Silver", "Gold" }
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior, gui.Parent = "RiftMastery", false, Enum.ZIndexBehavior.Sibling, player:WaitForChild("PlayerGui")
gui.DisplayOrder = 3
local function round(parent,radius)
	local corner = Instance.new("UICorner") corner.CornerRadius,corner.Parent = UDim.new(0,radius or 20),parent
end
local function frame(name,w,h,parent)
	local item = Instance.new("Frame")
	item.Name,item.Size,item.BackgroundColor3,item.BorderSizePixel,item.Parent = name,UDim2.fromOffset(w,h),ink,0,parent or gui
	round(item)
	local edge=Instance.new("UIStroke")
	edge.Name,edge.Color,edge.Transparency,edge.Thickness,edge.Parent="Glow",violet,.55,1.5,item
	return item
end

local function sculpture(parent,name,x,y,w,h,trophy)
	local view=Instance.new("ViewportFrame")
	view.Name,view.Position,view.Size,view.BackgroundTransparency=name,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h),1
	view.Ambient,view.LightColor,view.LightDirection=Color3.fromRGB(60,52,82),Color3.fromRGB(180,165,140),Vector3.new(-1,-1,-1)
	view.Parent=parent
	local world=Instance.new("WorldModel") world.Parent=view
	local camera=Instance.new("Camera")
	camera.CFrame,camera.FieldOfView,camera.Parent=CFrame.lookAt(Vector3.new(2,1.2,6),Vector3.new(0,0,0)),30,view
	view.CurrentCamera=camera
	local colored={}
	local function piece(size,offset,color,shape,tilt)
		local p=Instance.new("Part")
		p.Size,p.CFrame,p.Color=size,CFrame.new(offset)*(tilt or CFrame.identity),color
		p.Anchored,p.CanCollide,p.Material=true,false,Enum.Material.SmoothPlastic
		if shape then p.Shape=shape end
		p.Parent=world
		table.insert(colored,p)
		return p
	end
	local gold=medalColors[3]
	if trophy then
		piece(Vector3.new(2.2,.35,1.4),Vector3.new(0,-1.3,0),violet)
		piece(Vector3.new(.35,.9,.35),Vector3.new(0,-.7,0),gold)
		piece(Vector3.new(1.8,1.3,1.1),Vector3.new(0,.25,0),gold)
		piece(Vector3.new(2,.18,1.3),Vector3.new(0,.95,0),mint)
		for side=-1,1,2 do
			for index=0,7 do
				local a=index*math.pi/4
				piece(Vector3.new(.35,.2,.3),Vector3.new(side*1+math.cos(a)*.5,.3+math.sin(a)*.6,0),gold,nil,CFrame.Angles(0,0,a))
			end
		end
	else
		piece(Vector3.new(.28,2.5,2.5),Vector3.zero,gold,Enum.PartType.Cylinder,CFrame.Angles(0,math.pi/2,0))
		piece(Vector3.new(.16,2.05,2.05),Vector3.new(0,0,.2),gold,Enum.PartType.Cylinder,CFrame.Angles(0,math.pi/2,0))
		local rune=piece(Vector3.new(.85,.85,.18),Vector3.new(0,0,.36),paper,nil,CFrame.Angles(0,0,math.pi/4))
		table.remove(colored,table.find(colored,rune))
	end
	return view,colored
end
local function text(parent,name,value,x,y,w,h,size,color)
	local label = Instance.new("TextLabel")
	label.Name,label.Text,label.Position,label.Size = name,value,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h)
	label.BackgroundTransparency,label.Font,label.TextSize = 1,Enum.Font.FredokaOne,size
	label.TextColor3,label.TextWrapped,label.TextXAlignment,label.Parent = color or paper,true,Enum.TextXAlignment.Left,parent
	return label
end
local function button(parent,name,value,x,y,w,h,color)
	local item = Instance.new("TextButton")
	item.Name,item.Text,item.Position,item.Size = name,value,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h)
	item.Font,item.TextSize,item.TextColor3,item.BackgroundColor3 = Enum.Font.FredokaOne,14,ink,color or mint
	item.BorderSizePixel,item.Parent = 0,parent
	round(item,14)
	return item
end
local menu = frame("Menu",460,548)
menu.AnchorPoint,menu.Position,menu.Visible = Vector2.new(.5,.5),UDim2.fromScale(.5,.5),false
local chatBefore,chatHidden=nil,false
local function syncChat()
	if menu.Visible and not chatHidden then
		local ok,value=pcall(function() return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Chat) end)
		if ok then
			chatBefore=value
			chatHidden=pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false) end)
		end
	elseif not menu.Visible and chatHidden then
		if pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,chatBefore) end) then chatHidden=false end
	end
end
local outline = menu.Glow outline.Color,outline.Thickness,outline.Transparency = violet,2,.2
sculpture(menu,"MasteryTrophy",8,2,66,58,true)
text(menu,"Title","Rift Mastery",78,12,195,38,25,mint)
local points = text(menu,"Points","0 / 45",279,16,92,30,20,medalColors[3])
button(menu,"Close","X",394,15,48,32,violet).Activated:Connect(function() player:SetAttribute("MasteryMenuOpen",false) end)
local selected = Config.Maps[1].id
local themes, rows = {}, {}
for index,map in ipairs(Config.Maps) do
	local item = button(menu,map.id,map.name,12+(index-1)*147,60,142,36,Color3.fromRGB(unpack(map.rgb)))
	item.TextSize = 13
	themes[map.id] = item
	item.Activated:Connect(function() selected=map.id player:SetAttribute("MasterySelectedMap",selected) end)
end
for stage,course in ipairs(Config.Courses) do
	local row = frame("Course"..stage,436,73,menu)
	row.Position,row.BackgroundColor3 = UDim2.fromOffset(12,105+(stage-1)*76),Color3.fromRGB(64,50,99)
	local badge,medalParts = sculpture(row,"Medal",5,10,48,48,false)
	text(row,"Name",course.name,58,5,256,24,17,paper)
	local best = text(row,"Best","No chase time yet",58,29,252,19,12,muted)
	local target = text(row,"Targets","",58,50,252,18,11,medalColors[3])
	local play = button(row,"Practice","Practice",321,15,104,42)
	play.Activated:Connect(function()
		if not play.Active then return end
		Remote:FireServer("PracticeCourse",{mapId=selected,stage=stage})
	end)
	rows[stage] = {badge=badge,medalParts=medalParts,best=best,target=target,play=play}
end
local footer = text(menu,"Hint","Medals come from chase runs.",18,490,280,22,13,muted)
local rewards = button(menu,"Rewards","Rewards",322,490,120,40,violet)
rewards.Activated:Connect(function()
	player:SetAttribute("MasteryMenuOpen",false)
	player:SetAttribute("MasteryRewardsOpen",true)
end)
text(menu,"SaveStatus","",18,517,290,18,11,muted)
local function allowed()
	local role = player:GetAttribute("Role")
	return role == "Spectator" or role == "Escaped" or player:GetAttribute("CoursePractice") == true
end
local function refresh()
	menu.Visible = player:GetAttribute("MasteryMenuOpen") == true and allowed()
	points.Text = tostring(player:GetAttribute("MedalPoints") or 0) .. " / 45"
	menu.SaveStatus.Text = player:GetAttribute("SaveStatus") or "Loading progress..."
	for _,map in ipairs(Config.Maps) do
		themes[map.id].BackgroundTransparency = map.id == selected and 0 or .55
	end
	for stage,row in ipairs(rows) do
		local key = selected .. "_" .. stage
		local medal, best = player:GetAttribute("Medal_" .. key) or 0, player:GetAttribute("Best_" .. key)
		row.badge:SetAttribute("MedalRank",medal)
		for _,part in ipairs(row.medalParts) do part.Color=medalColors[medal] or muted end
		local practiceBest = player:GetAttribute("PracticeBest_" .. key)
		row.best.Text = best and string.format("Best %.2fs",best) or (practiceBest and string.format("Practice %.2fs",practiceBest) or "No chase time yet")
		local scale = Config.Mastery.ThemeScale[selected]
		row.target.Text = string.format("Gold %.1fs / Silver %.1fs",Config.Mastery.GoldSeconds[stage]*scale,Config.Mastery.SilverSeconds[stage]*scale)
		local reached = stage &lt;= (player:GetAttribute("UnlockedCourse") or 1)
		row.play.Active = reached and (player:GetAttribute("Role") ~= "Escaped")
		row.play.Selectable,row.play.AutoButtonColor = row.play.Active,row.play.Active
		row.play.BackgroundColor3 = row.play.Active and mint or muted
		row.play.Text = not reached and "Reach course "..stage or (row.play.Active and "Practice" or "After Run")
	end
	footer.Text = player:GetAttribute("CoursePractice") and "Practice times stay separate." or "Medals come from chase runs."
end

local card = frame("FinishCard",248,56)
card.AnchorPoint,card.Position,card.Visible = Vector2.new(.5,0),UDim2.new(.5,0,1,-212),false
local cardOutline = Instance.new("UIStroke")
cardOutline.Color,cardOutline.Thickness,cardOutline.Transparency,cardOutline.Parent = violet,1,.65,card
local medallion = text(card,"Medallion","G",10,12,32,32,18,ink)
medallion.BackgroundTransparency,medallion.TextXAlignment = 0,Enum.TextXAlignment.Center round(medallion,16)
local heading = text(card,"Heading","Gold Finish!",52,7,184,22,17,mint)
local resultTime = text(card,"Time","",52,30,90,17,13,paper)
local improvement = text(card,"Improvement","",146,30,90,17,11,muted)
local cardToken = 0
local function cardPosition(view)
	local compact = view and view.ViewportSize.X &lt; 820
	if compact and view.ViewportSize.Y &lt; 480 then return UDim2.new(.5,0,0,94) end
	return UDim2.new(.5,0,1,-212)
end
local controls = frame("PracticeControls",264,44)
controls.Position,controls.Visible = UDim2.fromOffset(14,88),false
button(controls,"Retry","Retry",6,5,80,34).Activated:Connect(function() Remote:FireServer("PracticeRetry") end)
button(controls,"Courses","Courses",92,5,80,34,violet).Activated:Connect(function() player:SetAttribute("MasteryMenuOpen",true) end)
button(controls,"Lobby","Lobby",178,5,80,34,muted).Activated:Connect(function() Remote:FireServer("PracticeLeave") end)
local function hideCard() cardToken += 1 card.Visible = false end
Remote.OnClientEvent:Connect(function(action,data)
	if action == "OpenMastery" then player:SetAttribute("MasteryMenuOpen",true)
	elseif action == "MasteryResult" and type(data) == "table" then
		-- Intermediate medals and bests update Mastery silently during the chase.
		if not data.practice and data.stage ~= #Config.Courses then return end
		cardToken += 1
		local token = cardToken
		local medal = data.medal or 0
		local tint = medalColors[medal] or mint
		medallion.Text,medallion.BackgroundColor3 = medal &gt; 0 and string.sub(medalNames[medal],1,1) or "P",tint
		heading.Text,heading.TextColor3 = data.practice and "Practice Clear!" or (medalNames[medal] or "Rift") .. " Finish!",tint
		resultTime.Text = string.format("%.2fs",data.time)
		improvement.Text = data.newBest and "New Best!" or ""
		local view = workspace.CurrentCamera
		local position = cardPosition(view)
		card.Position,card.BackgroundTransparency,card.Visible = position+UDim2.fromOffset(0,6),.35,true
		TweenService:Create(card,TweenInfo.new(.2),{Position=position,BackgroundTransparency=.08}):Play()
		task.delay(data.practice and 3 or 2.5,function() if token == cardToken then card.Visible=false end end)
	end
end)
player:GetAttributeChangedSignal("MasterySelectedMap"):Connect(function()
	local value = player:GetAttribute("MasterySelectedMap")
	for _,map in ipairs(Config.Maps) do if map.id == value then selected=value end end
	refresh()
end)
for _,name in ipairs({"MasteryMenuOpen","Role","UnlockedCourse","MedalPoints","SaveStatus","CoursePractice"}) do player:GetAttributeChangedSignal(name):Connect(refresh) end
player:GetAttributeChangedSignal("PracticeStartedAt"):Connect(function() hideCard() player:SetAttribute("MasteryMenuOpen",false) end)
local function browsing()
	Remote:FireServer("MasteryMenu",player:GetAttribute("MasteryMenuOpen") == true and allowed())
end
player:GetAttributeChangedSignal("MasteryMenuOpen"):Connect(browsing)
player:GetAttributeChangedSignal("Role"):Connect(function()
	if not allowed() then player:SetAttribute("MasteryMenuOpen",false) end
	browsing()
end)
for _,map in ipairs(Config.Maps) do
	for stage=1,#Config.Courses do
		for _,prefix in ipairs({"Best_","Medal_","PracticeBest_"}) do player:GetAttributeChangedSignal(prefix..map.id.."_"..stage):Connect(refresh) end
	end
end
local camera, connection
local function layout()
	local view = workspace.CurrentCamera
	if not view then return end
	local scale = menu:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Scale,scale.Parent = math.min(1,(view.ViewportSize.X-20)/460,(view.ViewportSize.Y-32)/548),menu
	local cardScale = card:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	cardScale.Scale,cardScale.Parent = math.min(1,(view.ViewportSize.X-24)/248),card
	card.Position = cardPosition(view)
	controls.Position = UDim2.fromOffset(view.ViewportSize.X &lt; 820 and 10 or 14,view.ViewportSize.X &lt; 820 and 158 or 88)
end
RunService.RenderStepped:Connect(function()
	syncChat()
	controls.Visible = player:GetAttribute("CoursePractice") == true and not menu.Visible
	local view = workspace.CurrentCamera
	if view then controls.Position = UDim2.fromOffset(view.ViewportSize.X &lt; 820 and 10 or 14,view.ViewportSize.X &lt; 820 and 158 or 88) end
	if view ~= camera then
		if connection then connection:Disconnect() end
		camera=view
		if view then connection=view:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
		layout()
	end
end)
refresh() layout()
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006113">
        <Properties>
          <string name="Name">VictoryEffects</string>
          <ProtectedString name="Source">local Replicated = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Remote = Replicated:WaitForChild("RiftAction")
local rng = Random.new()
local colors = { Bloom=Color3.fromRGB(123,255,176),Sparks=Color3.fromRGB(255,187,125),Fireworks=Color3.fromRGB(140,209,255),Confetti=Color3.fromRGB(201,173,255) }
local live = 0
Remote.OnClientEvent:Connect(function(action,data)
	if action ~= "Victory" or type(data) ~= "table" or typeof(data.position) ~= "Vector3" or not colors[data.effect] then return end
	local root = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position-data.position).Magnitude &gt; 140 or live &gt;= 90 then return end
	local count = data.effect == "Fireworks" and 30 or (data.effect == "Bloom" and 16 or 20)
	for index=1,count do
		if live &gt;= 90 then break end
		local part = Instance.new(data.effect == "Bloom" and "WedgePart" or "Part")
		part.Name,part.Anchored,part.CanCollide,part.CanQuery,part.CanTouch,part.CastShadow = "MasteryVictory",true,false,false,false,false
		part.Color,part.Material = colors[data.effect],Enum.Material.Neon
		part.Size = data.effect == "Bloom" and Vector3.new(.5,1.2,.5) or (data.effect == "Sparks" and Vector3.new(.16,1.1,.16) or Vector3.new(.3,.3,.3))
		local angle = index*math.pi*2/count
		local center = data.position+Vector3.new(0,2,0)
		if data.effect == "Fireworks" then center += Vector3.new(math.floor((index-1)/10)*4-4,6+index%3,0) end
		part.CFrame,part.Parent = CFrame.new(center),workspace
		local radius = data.effect == "Bloom" and 5 or 8
		local target = center+Vector3.new(math.cos(angle)*radius,rng:NextNumber(2,8),math.sin(angle)*radius)
		TweenService:Create(part,TweenInfo.new(1.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=CFrame.new(target)*CFrame.Angles(angle,angle*.5,angle),Transparency=1}):Play()
		live += 1
		Debris:AddItem(part,1.3)
		task.delay(1.35,function() live=math.max(0,live-1) end)
	end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006114">
        <Properties>
          <string name="Name">VIPGear</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Rep=game:GetService("ReplicatedStorage")
local Input=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local Debris=game:GetService("Debris")
local player=Players.LocalPlayer
local Remote=Rep:WaitForChild("RiftAction")
local gui=Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn,gui.Parent="RiftVIPGear",false,player:WaitForChild("PlayerGui")
local cross=Instance.new("TextLabel")
cross.Name,cross.Size,cross.Position,cross.AnchorPoint="Crosshair",UDim2.fromOffset(28,28),UDim2.fromScale(.5,.5),Vector2.new(.5,.5)
cross.BackgroundTransparency,cross.Text,cross.TextSize,cross.TextColor3,cross.Parent=1,"+",26,Color3.fromRGB(145,255,214),gui
local hint=Instance.new("TextLabel")
hint.Name,hint.Size,hint.Position,hint.AnchorPoint="Hint",UDim2.fromOffset(210,28),UDim2.new(.5,0,1,-124),Vector2.new(.5,0)
hint.BackgroundTransparency,hint.Font,hint.TextSize,hint.TextColor3,hint.Parent=1,Enum.Font.FredokaOne,15,Color3.fromRGB(255,221,137),gui
local connected=setmetatable({}, {__mode="k"})
local function watch(tool)
	if not tool:IsA("Tool") or not tool:GetAttribute("RiftVIPGear") or connected[tool] then return end
	connected[tool]=true
	tool.Activated:Connect(function()
		if tool:GetAttribute("RiftVIPGear")~="Blaster" or not player:GetAttribute("VIPGearActive") then return end
		local camera=workspace.CurrentCamera
		if not camera then return end
		local aim
		if Input.TouchEnabled or Input.GamepadEnabled then aim=camera.CFrame.Position+camera.CFrame.LookVector*180
		else aim=player:GetMouse().Hit.Position end
		Remote:FireServer("VIPFire",aim)
	end)
end
local function characterAdded(character)
	for _,tool in ipairs(character:GetChildren()) do watch(tool) end
	character.ChildAdded:Connect(watch)
end
if player.Character then characterAdded(player.Character) end
player.CharacterAdded:Connect(characterAdded)
Run.RenderStepped:Connect(function()
	local equipped=player.Character and player.Character:FindFirstChildOfClass("Tool")
	local kind=equipped and equipped:GetAttribute("RiftVIPGear")
	local active=player:GetAttribute("VIPGearActive")==true
	cross.Visible=kind=="Blaster" and active and (Input.TouchEnabled or Input.GamepadEnabled)
	hint.Visible=kind~=nil
	hint.Text=active and (kind=="Blaster" and "Tap / Click to Fire" or (kind=="Speed" and "Speed Coil" or "Jump Coil")) or "VIP Arena only"
end)
Remote.OnClientEvent:Connect(function(action,data)
	if action~="VIPShot" or type(data)~="table" or typeof(data.from)~="Vector3" or typeof(data.to)~="Vector3" then return end
	local camera=workspace.CurrentCamera
	if not camera or (camera.CFrame.Position-data.from).Magnitude&gt;180 then return end
	local length=(data.to-data.from).Magnitude
	if length&lt;.01 then return end
	local beam=Instance.new("Part")
	beam.Name,beam.Size,beam.CFrame="VIPPulse",Vector3.new(.12,.12,length),CFrame.lookAt((data.from+data.to)/2,data.to)
	beam.Anchored,beam.CanCollide,beam.CanTouch,beam.CanQuery=true,false,false,false
	beam.Material,beam.Color,beam.Parent=Enum.Material.Neon,Color3.fromRGB(68,174,215),workspace
	Debris:AddItem(beam,.1)
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX006115">
        <Properties>
          <string name="Name">Journey</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Rep=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Starter=game:GetService("StarterGui")
local player=Players.LocalPlayer
local Remote=Rep:WaitForChild("RiftAction")
local Rules=require(Rep:WaitForChild("RiftShared").Rules)
local gui=Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="RiftJourney",false,20
gui.Parent=player:WaitForChild("PlayerGui")
local ink,mint,paper,violet=Color3.fromRGB(48,35,82),Color3.fromRGB(145,255,214),Color3.fromRGB(246,245,255),Color3.fromRGB(201,173,255)
local function rounded(obj,radius)
	local c=Instance.new("UICorner") c.CornerRadius,c.Parent=UDim.new(0,radius or 18),obj
end
local function text(parent,name,value,x,y,width,height,size,color)
	local t=Instance.new("TextLabel")
	t.Name,t.Text,t.Position,t.Size=name,value,UDim2.fromOffset(x,y),UDim2.fromOffset(width,height)
	t.BackgroundTransparency,t.TextColor3,t.Font,t.TextSize,t.TextWrapped=1,color or paper,Enum.Font.FredokaOne,size or 17,true
	t.Parent=parent return t
end
local function button(parent,name,value,x,y,width,height,color)
	local b=Instance.new("TextButton")
	b.Name,b.Text,b.Position,b.Size=name,value,UDim2.fromOffset(x,y),UDim2.fromOffset(width,height)
	b.BackgroundColor3,b.TextColor3,b.Font,b.TextSize,b.BorderSizePixel=color or mint,ink,Enum.Font.FredokaOne,16,0
	b.Parent=parent rounded(b) return b
end
local function panel(name,width,height)
	local f=Instance.new("Frame") f.Name,f.Size,f.AnchorPoint=name,UDim2.fromOffset(width,height),Vector2.new(.5,.5)
	f.Position,f.BackgroundColor3,f.BackgroundTransparency,f.BorderSizePixel=UDim2.fromScale(.5,.5),ink,.04,0
	f.Parent=gui rounded(f,24)
	local stroke=Instance.new("UIStroke") stroke.Color,stroke.Transparency,stroke.Thickness,stroke.Parent=violet,.25,2,f
	return f
end
local goals=panel("GoalsPanel",390,430) goals.Visible=false
text(goals,"Title","Rift Goals",20,14,280,36,26,mint).TextXAlignment=Enum.TextXAlignment.Left
local close=button(goals,"Close","×",334,14,40,34,violet)
close.Activated:Connect(function() player:SetAttribute("JourneyMenuOpen",false) end)
local rows={}
for index=1,3 do
	local y=62+(index-1)*79
	local label=text(goals,"Goal"..index,"",20,y,350,27,18) label.TextXAlignment=Enum.TextXAlignment.Left
	local reward=text(goals,"Reward"..index,"",20,y+29,270,19,13,violet) reward.TextXAlignment=Enum.TextXAlignment.Left
	local count=text(goals,"Count"..index,"",300,y+29,70,19,14,mint)
	local track=Instance.new("Frame") track.Name,track.Position,track.Size="GoalTrack",UDim2.fromOffset(20,y+55),UDim2.fromOffset(350,7)
	track.BackgroundColor3,track.BorderSizePixel,track.Parent=Color3.fromRGB(83,65,120),0,goals rounded(track,4)
	local fill=Instance.new("Frame") fill.Name,fill.Size,fill.BackgroundColor3,fill.BorderSizePixel,fill.Parent="Fill",UDim2.fromScale(0,1),mint,0,track rounded(fill,4)
	rows[index]={label=label,reward=reward,count=count,fill=fill}
end
local reset=text(goals,"Reset","",20,301,350,20,12,violet)
local learn=button(goals,"Learn","Learn to Run",20,330,350,36)
learn.Activated:Connect(function() player:SetAttribute("JourneyMenuOpen",false) Remote:FireServer("TutorialStart") end)
local ghostEnabled=true
local ghostToggle=button(goals,"GhostToggle","Parkour Ghost: On",20,378,350,34,violet)
ghostToggle.Activated:Connect(function() ghostEnabled=not ghostEnabled end)
local invite=panel("FirstRun",284,84)
invite.AnchorPoint,invite.Position=Vector2.new(.5,1),UDim2.new(.5,0,1,-106)
text(invite,"Title","Learn to Run?",12,6,260,25,20,mint)
button(invite,"Learn","Train",12,40,124,32).Activated:Connect(function() Remote:FireServer("TutorialStart") end)
button(invite,"Skip","Later",148,40,124,32,violet).Activated:Connect(function() Remote:FireServer("TutorialSkip") end)
local exit=button(gui,"ExitLesson","Skip Lesson",0,0,140,38,violet)
exit.AnchorPoint,exit.Position=Vector2.new(1,0),UDim2.new(1,-12,0,100)
exit.Activated:Connect(function() Remote:FireServer("TutorialSkip") end)
local replay,ghost,body,frameIndex=nil,nil,{},1
local function removeGhost()
	if ghost then ghost:Destroy() end
	ghost,body=nil,{}
end
local function makeGhost()
	ghost=Instance.new("Model") ghost.Name,ghost.Parent="RiftParkourGhost",workspace
	for _,definition in ipairs({{"Head",Vector3.new(1.7,1.7,1.7)},{"Body",Vector3.new(2,2,1)},
		{"LeftArm",Vector3.new(.8,2,.8)},{"RightArm",Vector3.new(.8,2,.8)},
		{"LeftLeg",Vector3.new(.8,2,.8)},{"RightLeg",Vector3.new(.8,2,.8)}}) do
		local part=Instance.new("Part")
		part.Name,part.Size,part.Color,part.Material,part.Transparency=definition[1],definition[2],mint,Enum.Material.SmoothPlastic,.64
		part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery,part.CastShadow=true,false,false,false,false
		part.Parent=ghost body[definition[1]]=part
	end
	local tag=Instance.new("BillboardGui") tag.Name,tag.Adornee,tag.Size,tag.StudsOffset,tag.MaxDistance="GhostName",body.Head,UDim2.fromOffset(100,22),Vector3.new(0,2,0),50
	local label=text(tag,"Name","Your Best",0,0,100,22,13,mint) label.TextStrokeTransparency=.35 tag.Parent=ghost
end
local function frame(value) return CFrame.new(value[2]/10,value[3]/10,value[4]/10)*CFrame.Angles(0,value[5]/1000,0) end
Remote.OnClientEvent:Connect(function(action,data)
	if action=="ParkourGhost" then replay=Rules.sanitizeGhost(data) frameIndex=1 removeGhost() end
end)
local chatWasEnabled
Run.RenderStepped:Connect(function()
	local camera=workspace.CurrentCamera
	if not camera then return end
	local width,height=camera.ViewportSize.X,camera.ViewportSize.Y
	local scale=goals:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Scale,scale.Parent=math.min(1,(width-24)/390,(height-24)/430),goals
	local role=player:GetAttribute("Role")
	local lobby=(role=="Spectator" or role=="Escaped") and not player:GetAttribute("CoursePractice")
	local tutorial=player:GetAttribute("TutorialActive")==true
	local open=lobby and not tutorial and player:GetAttribute("JourneyMenuOpen")==true
	goals.Visible=open exit.Visible=tutorial
	if open and chatWasEnabled==nil then
		local ok,enabled=pcall(function() return Starter:GetCoreGuiEnabled(Enum.CoreGuiType.Chat) end)
		if ok then chatWasEnabled=enabled Starter:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false) end
	elseif not open and chatWasEnabled~=nil then
		pcall(function() Starter:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,chatWasEnabled) end) chatWasEnabled=nil
	end
	local hud=player.PlayerGui:FindFirstChild("RiftHUD")
	local other=player:GetAttribute("MasteryMenuOpen") or (hud and ((hud:FindFirstChild("Shop") and hud.Shop.Visible) or (hud:FindFirstChild("Help") and hud.Help.Visible) or (hud:FindFirstChild("Vote") and hud.Vote.Visible)))
	invite.Visible=lobby and not tutorial and not open and not other and not player:GetAttribute("ParkourActive")
		and player:GetAttribute("TutorialSeen")==false and player:GetAttribute("GoalText1")~=nil
	if not lobby then player:SetAttribute("JourneyMenuOpen",false) end
	for index,row in ipairs(rows) do
		local progress,target=player:GetAttribute("GoalProgress"..index) or 0,player:GetAttribute("GoalTarget"..index) or 1
		row.label.Text=player:GetAttribute("GoalText"..index) or "Loading..."
		row.reward.Text=player:GetAttribute("GoalDone"..index) and "Reward earned!" or tostring(player:GetAttribute("GoalReward"..index) or 0).." Coins"
		row.count.Text=string.format("%d / %d",progress,target)
		row.fill.Size=UDim2.fromScale(math.clamp(progress/target,0,1),1)
	end
	local seconds=math.max(0,(player:GetAttribute("ChallengesResetAt") or os.time())-os.time())
	reset.Text=string.format("New goals in %dh %dm",math.floor(seconds/3600),math.floor(seconds%3600/60))
	learn.Text=player:GetAttribute("TutorialCompleted") and "Replay Training" or "Learn to Run"
	ghostToggle.Text="Parkour Ghost: "..(ghostEnabled and "On" or "Off")..(player:GetAttribute("HasParkourGhost") and "" or " / Set a Best!")
	local elapsed=workspace:GetServerTimeNow()-(player:GetAttribute("ParkourStartedAt") or 0)
	if not ghostEnabled or not replay or not player:GetAttribute("ParkourActive") or elapsed&lt;0 or elapsed*1000&gt;replay.durationMs then removeGhost() return end
	if not ghost then makeGhost() frameIndex=1 end
	local frames=replay.frames
	if elapsed*1000&lt;frames[frameIndex][1] then frameIndex=1 end
	while frameIndex&lt;#frames-1 and elapsed*1000&gt;frames[frameIndex+1][1] do frameIndex+=1 end
	local a,b=frames[frameIndex],frames[frameIndex+1]
	local pose=frame(a):Lerp(frame(b),math.clamp((elapsed*1000-a[1])/(b[1]-a[1]),0,1))
	local swing=math.sin(elapsed*12)*.65
	body.Body.CFrame=pose body.Head.CFrame=pose*CFrame.new(0,1.6,0)
	body.LeftArm.CFrame=pose*CFrame.new(-1.45,0,0)*CFrame.Angles(swing,0,0)
	body.RightArm.CFrame=pose*CFrame.new(1.45,0,0)*CFrame.Angles(-swing,0,0)
	body.LeftLeg.CFrame=pose*CFrame.new(-.5,-2,0)*CFrame.Angles(-swing,0,0)
	body.RightLeg.CFrame=pose*CFrame.new(.5,-2,0)*CFrame.Angles(swing,0,0)
end)
Remote:FireServer("JourneyReady")
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
    </Item>
