    <Item class="ModuleScript" referent="RBX006089">
      <Properties>
        <string name="Name">ProfileStore</string>
        <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
-- A local, unpublished place cannot even create a DataStore handle.
-- Acquire it only inside the guarded live load path, after the Studio check.
local Store = nil
local Profiles = {}
local entries = {}
local leaseSeconds = 180

local function key(player) return "Player_" .. player.UserId end

function Profiles.load(player)
	local token = HttpService:GenerateGUID(false)
	local entry = { data = Rules.sanitizeProfile(nil, Config.Trails, Config.Cosmetics), token = token, writable = false, busy = false }
	entries[player] = entry
	if RunService:IsStudio() or game.GameId == 0 then
		player:SetAttribute("SaveStatus", "Studio session")
		entry.writable = false
		return entry.data
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			if not Store then Store = DataStoreService:GetDataStore(Config.DataStoreName) end
			return Store:UpdateAsync(key(player), function(old)
				old = type(old) == "table" and old or {}
				local lock = old.Session
				if type(lock) == "table" and lock.Token ~= token and type(lock.Expires) == "number" and lock.Expires &gt; os.time() then
					return nil
				end
				local data = Rules.sanitizeProfile(old, Config.Trails, Config.Cosmetics)
				data.Session = { Token = token, Expires = os.time() + leaseSeconds }
				return data
			end)
		end)
		if ok and result and result.Session and result.Session.Token == token then
			entry.data = Rules.sanitizeProfile(result, Config.Trails, Config.Cosmetics)
			entry.writable = true
			if not player.Parent then
				-- A disconnect can race a yielding load. Release a lease acquired after removal.
				entries[player] = entry
				Profiles.save(player, true)
				return entry.data
			end
			player:SetAttribute("SaveStatus", "Saved")
			return entry.data
		end
		if ok and result == nil then break end
		task.wait(attempt)
	end
	-- Keep the stored profile untouched if loading fails or another server owns it.
	player:SetAttribute("SaveStatus", "Session only: profile unavailable")
	return entry.data
end

function Profiles.get(player)
	local entry = entries[player]
	return entry and entry.data
end

function Profiles.save(player, release)
	local entry = entries[player]
	if not entry then return true end
	if entry.busy then
		local deadline = os.clock() + 12
		repeat task.wait(0.1) until not entry.busy or os.clock() &gt; deadline
		if entry.busy then return false end
	end
	if not entry.writable then
		if release then entries[player] = nil end
		return true
	end
	entry.busy = true
	local snapshot = Rules.sanitizeProfile(entry.data, Config.Trails, Config.Cosmetics)
	local success = false
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return Store:UpdateAsync(key(player), function(old)
				if type(old) ~= "table" or type(old.Session) ~= "table" or old.Session.Token ~= entry.token then return nil end
				local nextData = table.clone(snapshot)
				if not release then
					nextData.Session = { Token = entry.token, Expires = os.time() + leaseSeconds }
				end
				return nextData
			end)
		end)
		if ok and result then success = true break end
		if ok and result == nil then
			entry.writable = false
			break
		end
		task.wait(attempt)
	end
	entry.busy = false
	if player.Parent then player:SetAttribute("SaveStatus", success and "Saved" or "Save delayed") end
	if release then entries[player] = nil end
	return success
end

return Profiles
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006090">
      <Properties>
        <string name="Name">PassService</string>
        <ProtectedString name="Source">local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Config = require(Shared.Config)
local Ids = require(Shared.PassIds)
local Passes = {}
local entries = {}
local changed, notice

function Passes.owns(player, key)
	local entry = entries[player]
	return entry ~= nil and entry.owned[key] == true
end

function Passes.entitlements(player)
	local entry = entries[player]
	return entry and entry.owned or {}
end

local function check(player, key)
	local entry = entries[player]
	local id = Ids[key]
	if not entry or entry.busy[key] or type(id) ~= "number" or id &lt;= 0 or RunService:IsStudio() or game.GameId == 0 then return end
	entry.busy[key] = true
	local ok, owned = false, false
	for attempt = 1, 3 do
		ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id) end)
		if ok or entries[player] ~= entry then break end
		task.wait(attempt)
	end
	entry.busy[key] = nil
	if entries[player] ~= entry or not player.Parent then return end
	if ok then
		local newlyOwned = owned == true and entry.owned[key] ~= true
		entry.owned[key] = owned == true
		player:SetAttribute("Pass_" .. key, owned == true)
		player:SetAttribute("PassStatus_" .. key, "Ready")
		if changed then changed(player) end
		if newlyOwned and notice then notice(player, "Game pass activated! Your perks are ready.") end
	else
		player:SetAttribute("PassStatus_" .. key, "Check unavailable")
		if notice then notice(player, "Could not check game passes. Reopen Passes to retry.") end
	end
end

function Passes.load(player)
	entries[player] = { owned = {}, busy = {}, refreshedAt = -100 }
	for _, pass in ipairs(Config.Passes) do
		player:SetAttribute("Pass_" .. pass.key, false)
		player:SetAttribute("PassStatus_" .. pass.key, Ids[pass.key] and "Checking" or "Not configured")
		if Ids[pass.key] and (RunService:IsStudio() or game.GameId == 0) then player:SetAttribute("PassStatus_" .. pass.key, "Live game only") end
	end
	task.spawn(function() for _, pass in ipairs(Config.Passes) do check(player, pass.key) end end)
end

function Passes.refresh(player)
	local entry = entries[player]
	if not entry or os.clock() - entry.refreshedAt &lt; 10 then return end
	entry.refreshedAt = os.clock()
	task.spawn(function() for _, pass in ipairs(Config.Passes) do check(player, pass.key) end end)
end

function Passes.remove(player)
	entries[player] = nil
end

function Passes.init(onChanged, onNotice)
	changed, notice = onChanged, onNotice
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, purchased)
		if purchased ~= true or not entries[player] then return end
		for _, pass in ipairs(Config.Passes) do
			if Ids[pass.key] == id then task.spawn(check, player, pass.key) return end
		end
	end)
end

return Passes
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006091">
      <Properties>
        <string name="Name">WorldService</string>
        <ProtectedString name="Source">local Storage = game:GetService("ServerStorage")
local Replicated = game:GetService("ReplicatedStorage")
local Shared = Replicated:WaitForChild("RiftShared")
local Config, Rules = require(Shared.Config), require(Shared.Rules)
local Arena = workspace:WaitForChild("RiftArena")
local Templates = Storage:WaitForChild("RiftMaps")
local Lobby = workspace:WaitForChild("RiftLobby")
local World = {}
local votes, active, previous = {}, Arena:FindFirstChild("ActiveMap"), nil
local callbacks, interactions = nil, {}
local courseInteractions = {}
local function resourceKind(part)
	local marker = part:FindFirstChild("HoverIcon")
	local kind = marker and marker:FindFirstChild("Kind")
	assert(kind and (kind.Value == "Stamina" or kind.Value == "Dash"), "Missing resource pickup kind: " .. part.Name)
	return kind.Value
end
for stage = 2, #Config.Courses do
	courseInteractions[stage] = {}
	local section = Arena.ChaseCourses:WaitForChild("Course_" .. stage)
	for _, part in ipairs(section:GetChildren()) do
		if part:IsA("BasePart") and string.sub(part.Name, 1, 8) == "Recharge" then
			table.insert(courseInteractions[stage], { part = part, kind = resourceKind(part) })
		end
	end
end
local voting = false
local course = Lobby:WaitForChild("Parkour")
local parkour, best, retry = {}, {}, {}
local plateDown, votePlates = {}, {}
for _,map in ipairs(Config.Maps) do table.insert(votePlates,Lobby:WaitForChild("Vote_"..map.id)) end
local courseSteps = {}
for index = 1, Config.ParkourSteps do courseSteps[index] = course:WaitForChild("ParkourStep_" .. index) end
local function ghostFrame(state,position,now,force)
	if not force and now-state.sampledAt&lt;.2 then return end
	local delta=position-state.last
	local elapsed=math.max(.05,now-state.checkedAt)
	if Vector3.new(delta.X,0,delta.Z).Magnitude&gt;31*elapsed+3 then state.valid=false end
	local movement=position-state.framePosition
	if movement.X*movement.X+movement.Z*movement.Z&gt;.01 then state.yaw=math.atan2(-movement.X,-movement.Z) end
	local ms=math.floor((now-state.started)*1000+.5)
	if #state.frames&lt;602 and ms&lt;=120000 and (#state.frames==0 or ms&gt;state.frames[#state.frames][1]) then
		table.insert(state.frames,{ms,math.floor(position.X*10+.5),math.floor(position.Y*10+.5),math.floor(position.Z*10+.5),math.floor(state.yaw*1000+.5)})
	end
	state.sampledAt,state.framePosition=now,position
end

local function closeEnough(player, part, radius)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return root and humanoid and humanoid.Health &gt; 0 and (root.Position - part.Position).Magnitude &lt;= radius
end

local function voteCounts()
	for _, map in ipairs(Config.Maps) do
		local count = 0
		for _, id in pairs(votes) do if id == map.id then count += 1 end end
		Replicated:SetAttribute("Votes_" .. map.id, count)
	end
end

local function activate(id)
	local template = Templates:FindFirstChild(id)
	assert(template, "Missing map template: " .. id)
	local replacement = template:Clone()
	replacement.Name = "ActiveMap"
	if active then active:Destroy() end
	active = replacement
	active.Parent = Arena
	interactions = {}
	for _, part in ipairs(active:GetDescendants()) do
		if part:IsA("BasePart") and (string.sub(part.Name, 1, 7) == "Crystal" or string.sub(part.Name, 1, 8) == "Recharge") then
			table.insert(interactions, { part = part, kind = string.sub(part.Name, 1, 7) == "Crystal" and "Crystal" or resourceKind(part) })
		end
	end
	for _, map in ipairs(Config.Maps) do
		if map.id == id then
			Replicated:SetAttribute("MapId", id)
			Replicated:SetAttribute("MapName", map.name)
			game:GetService("Lighting").ClockTime = map.clock
			Arena.ArenaFloor.Color = Color3.fromRGB(unpack(map.floor))
			for _, part in ipairs(Arena.ChaseCourses:GetDescendants()) do
				if part:IsA("BasePart") then
					if part.Name == "CourseFloor" or part.Name == "CourseDeck" then part.Color = Color3.fromRGB(unpack(map.floor)) end
					if part.Name == "CourseAccent" or part.Name == "CourseFinish" then part.Color = Color3.fromRGB(unpack(map.rgb)) end
				end
			end
			break
		end
	end
	previous = id
end

function World.vote(player, id)
	if not voting or type(id) ~= "string" or not callbacks.inLobby(player) then return false end
	for _, map in ipairs(Config.Maps) do
		if map.id == id then
			votes[player] = id
			player:SetAttribute("MapVote", id)
			voteCounts()
			return true
		end
	end
	return false
end

function World.voteOnPlate(player,id)
	if type(id)~="string" then return false end
	local plate=Lobby:FindFirstChild("Vote_"..id)
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	return plate and root and humanoid and humanoid.Health&gt;0
		and Rules.onSurface(root.Position,plate,humanoid.FloorMaterial~=Enum.Material.Air) and World.vote(player,id) or false
end

function World.startVoting()
	votes, voting = {}, true
	for player,plate in pairs(plateDown) do if plate~=course.ParkourStart then plateDown[player]=nil end end
	Replicated:SetAttribute("VotingOpen", true)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do player:SetAttribute("MapVote", "") end
	voteCounts()
end

function World.choose(pick)
	voting = false
	Replicated:SetAttribute("VotingOpen", false)
	local id = Rules.chooseMap(Config.Maps, votes, previous, pick)
	activate(id)
	return id
end

function World.closeVoting()
	voting = false
	Replicated:SetAttribute("VotingOpen", false)
end

function World.getInteractions(stage)
	if not stage or stage == 1 then return interactions end
	return courseInteractions[stage] or {}
end

function World.resetParkour(player)
	parkour[player] = nil
	retry[player] = nil
	player:SetAttribute("ParkourRetryAvailable", false)
	player:SetAttribute("ParkourActive", false)
	player:SetAttribute("ParkourCheckpoint", 0)
end

function World.failParkour(player)
	if not parkour[player] then return false end
	World.resetParkour(player)
	retry[player] = true
	plateDown[player] = nil
	player:SetAttribute("ParkourRetryAvailable", true)
	return true
end

function World.canRetryParkour(player) return retry[player] == true end
function World.isParkouring(player) return parkour[player] ~= nil end

function World.retryParkour(player)
	if not retry[player] or not callbacks.inLobby(player) then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then return false end
	World.resetParkour(player)
	plateDown[player] = nil
	callbacks.moveLobby(player, course.ParkourStart.Position+Vector3.new(0, Config.FloorY, 0))
	return true
end

function World.beginParkour(player)
	if parkour[player] or not callbacks.inLobby(player) or not closeEnough(player, course.ParkourStart, 14) then return false end
	retry[player] = nil
	player:SetAttribute("ParkourRetryAvailable", false)
	local now=workspace:GetServerTimeNow()
	local position=player.Character:FindFirstChild("HumanoidRootPart").Position
	parkour[player] = { checkpoint = 0, saved = 0, falls = 0, started = now, sampledAt=now,checkedAt=now,
		last=position,framePosition=position,yaw=math.pi,valid=true,frames={{0,math.floor(position.X*10+.5),math.floor(position.Y*10+.5),math.floor(position.Z*10+.5),3142}} }
	player:SetAttribute("ParkourActive", true)
	player:SetAttribute("ParkourCheckpoint", 0)
	player:SetAttribute("ParkourFalls", 0)
	player:SetAttribute("ParkourStartedAt", parkour[player].started)
	if callbacks.parkourBegin then callbacks.parkourBegin(player) end
	callbacks.notice(player, "Jump to the Top!")
	return true
end

function World.stepLobby(player, root, humanoid)
	if not callbacks.inLobby(player) or humanoid.Health&lt;=0 then return end
	local position = root.Position
	local state = parkour[player]
	local zone = Rules.lobbyZone(position.X, position.Y, position.Z)
	local function recover()
		if state then World.failParkour(player) end
		callbacks.returnLobby(player)
	end
	if not zone or ((zone == "Lounge" or zone == "VIPBridge" or zone == "VIPActivity") and not callbacks.isVIP(player)) then
		recover()
		return
	end
	local tutorialPlate=Lobby:FindFirstChild("TutorialPlate")
	if tutorialPlate and Rules.onSurface(position,tutorialPlate,humanoid.FloorMaterial~=Enum.Material.Air) and callbacks.tutorial then
		callbacks.tutorial(player) return
	end
	if zone=="Tutorial" then recover() return end
	if zone == "Parkour" and position.Y &lt; Config.LobbyFloorY - 22 then recover() return end
	local pressed=nil
	local grounded=humanoid.FloorMaterial~=Enum.Material.Air
	for _,plate in ipairs(votePlates) do if Rules.onSurface(position,plate,grounded) then pressed=plate break end end
	if not pressed and Rules.onSurface(position,course.ParkourStart,grounded) then pressed=course.ParkourStart end
	if pressed~=plateDown[player] then
		plateDown[player]=pressed
		if pressed==course.ParkourStart then World.beginParkour(player)
		elseif pressed then World.vote(player,string.sub(pressed.Name,6)) end
	end
	state=parkour[player]
	if not state then return end
	if zone ~= "Parkour" and zone ~= "Bridge" then World.resetParkour(player) return end
	local now=workspace:GetServerTimeNow()
	ghostFrame(state,position,now,false)
	local movement=position-state.last
	if Vector3.new(movement.X,0,movement.Z).Magnitude&gt;31*math.max(.05,now-state.checkedAt)+3 then state.valid=false end
	state.last,state.checkedAt=position,now
	local nextStep = courseSteps[state.checkpoint + 1]
	local center, top = nextStep.Position, nextStep.Position.Y + nextStep.Size.Y/2
	if not Rules.onParkourStep(position.X, position.Y, position.Z, center.X, top, center.Z, humanoid.FloorMaterial ~= Enum.Material.Air, nextStep.Size.X/2 - .25, nextStep.Size.Z/2 - .25) then return end
	state.checkpoint += 1
	if state.checkpoint % Config.ParkourCheckpointEvery == 0 then state.saved = state.checkpoint end
	player:SetAttribute("ParkourCheckpoint", state.checkpoint)
	if state.checkpoint == #courseSteps then
		local elapsed = now - state.started
		ghostFrame(state,position,now,true)
		best[player] = math.min(best[player] or math.huge, elapsed)
		player:SetAttribute("ParkourBest", best[player])
		if callbacks.parkourFinish then callbacks.parkourFinish(player,elapsed,state.frames,state.valid) end
		World.resetParkour(player)
		retry[player] = true
		player:SetAttribute("ParkourRetryAvailable", true)
		callbacks.notice(player, string.format("You Did It! %.1fs", elapsed))
		callbacks.celebrate(position + Vector3.new(0, 3, 0))
	elseif state.checkpoint % Config.ParkourCheckpointEvery == 0 then callbacks.notice(player, "Checkpoint!") end
end

function World.remove(player)
	votes[player] = nil
	plateDown[player]=nil
	parkour[player], best[player], retry[player] = nil, nil, nil
	if voting then voteCounts() end
end

function World.init(handlers)
	callbacks = handlers
	activate(Config.Maps[1].id)
	for _, part in ipairs(Lobby:GetDescendants()) do
		local prompt = part:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				if not callbacks.inLobby(player) or not closeEnough(player, part, 14) then return end
				if string.sub(part.Name, 1, 5) == "Vote_" then
					World.vote(player, string.sub(part.Name, 6))
				elseif part.Name == "PassVendor" then callbacks.openShop(player)
				elseif part.Name == "MasteryPortal" then callbacks.openMastery(player)
				elseif part.Name == "StyleMirror" then
					if callbacks.isVIP(player) then callbacks.openStyles(player) else callbacks.openShop(player) end
				elseif part.Name == "VIPPortal" then callbacks.lounge(player)
				elseif part.Name == "LoungeExit" then callbacks.returnLobby(player)
				end
			end)
		end
	end
end

return World
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006092">
      <Properties>
        <string name="Name">CreatureRig</string>
        <ProtectedString name="Source">-- Original Rift Stalker: primitive geometry, no external meshes or asset IDs.
-- A standard invisible R6 skeleton keeps the NPC's previous collision footprint.
local CollectionService = game:GetService("CollectionService")
local Creature = {}
local costumes = setmetatable({}, { __mode = "k" })
local fur = Color3.fromRGB(27, 31, 37)
local mane = Color3.fromRGB(45, 48, 54)
local bone = Color3.fromRGB(224, 217, 193)
local eyes = Color3.fromRGB(159, 255, 95)
local violet = Color3.fromRGB(183, 122, 255)

local function part(parent, name, size, frame, color, invisible, class)
	local obj = Instance.new(class or "Part")
	obj.Name, obj.Size, obj.CFrame = name, size, frame
	obj.Color, obj.Material = color, Enum.Material.SmoothPlastic
	obj.CanCollide, obj.CanTouch, obj.CanQuery, obj.Massless = false, false, false, true
	obj.CollisionGroup, obj.Transparency = "RiftCharacters", invisible and 1 or 0
	obj.TopSurface, obj.BottomSurface, obj.Parent = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth, parent
	return obj
end

local function detail(model, base, name, size, offset, color, class, neon)
	local obj = part(model, name, size, base.CFrame * offset, color, false, class)
	if neon then obj.Material = Enum.Material.Neon end
	local weld = Instance.new("WeldConstraint")
	weld.Name, weld.Part0, weld.Part1, weld.Parent = name .. "Weld", base, obj, obj
	return obj
end

function Creature.create(name, cosmetic)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("RiftStalker", true)
	local root = part(model, cosmetic and "CreatureRoot" or "HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), fur, true)
	root.Massless = cosmetic == true
	local torso = part(model, "Torso", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), fur, true)
	torso.CanCollide, torso.CanQuery = not cosmetic, not cosmetic
	local head = part(model, "Head", Vector3.new(2, 1, 1), CFrame.new(0, 4.5, 0), fur, true)
	local limbs = {
		part(model, "Left Arm", Vector3.new(1, 2, 1), CFrame.new(-1.5, 3, 0), fur, true),
		part(model, "Right Arm", Vector3.new(1, 2, 1), CFrame.new(1.5, 3, 0), fur, true),
		part(model, "Left Leg", Vector3.new(1, 2, 1), CFrame.new(-.5, 1, 0), fur, true),
		part(model, "Right Leg", Vector3.new(1, 2, 1), CFrame.new(.5, 1, 0), fur, true),
	}
	local function joint(name_, a, b, c0, c1)
		local motor = Instance.new("Motor6D")
		motor.Name, motor.Part0, motor.Part1 = name_, a, b
		motor.C0, motor.C1 = c0, c1
		motor:SetAttribute("RestPose", c0)
		motor.Parent = a
		return motor
	end
	-- Names stay distinct from a human avatar's normal animation joints.
	joint("CreatureSpine", root, torso, CFrame.new(0, -.1, 0) * CFrame.Angles(math.rad(-18), 0, 0), CFrame.identity)
	joint("CreatureNeck", torso, head, CFrame.new(0, 1.25, -.65) * CFrame.Angles(math.rad(12), 0, 0), CFrame.new(0, -.45, 0))
	joint("CreatureLeftShoulder", torso, limbs[1], CFrame.new(-2.1, .85, -.1) * CFrame.Angles(.16, 0, -.12), CFrame.new(0, .85, 0))
	joint("CreatureRightShoulder", torso, limbs[2], CFrame.new(2.1, .85, -.1) * CFrame.Angles(.16, 0, .12), CFrame.new(0, .85, 0))
	joint("CreatureLeftHip", torso, limbs[3], CFrame.new(-.65, -1, 0), CFrame.new(0, 1, 0))
	joint("CreatureRightHip", torso, limbs[4], CFrame.new(.65, -1, 0), CFrame.new(0, 1, 0))

	detail(model, torso, "HulkingChest", Vector3.new(3.7, 2.65, 2), CFrame.new(0, .1, 0), fur)
	detail(model, torso, "ShoulderHump", Vector3.new(4.2, 1.35, 2.1), CFrame.new(0, 1.05, .4), mane)
	detail(model, torso, "ChestPlate", Vector3.new(2.6, 1.8, .3), CFrame.new(0, 0, -1.05), Color3.fromRGB(56, 58, 63))
	for _, side in ipairs({ -1, 1 }) do
		for index = 1, 3 do
			detail(model, torso, "ManeTuft", Vector3.new(.8, 1.7, 1.3), CFrame.new(side * (1.3 + .27 * index), .65 - .35 * index, .45) * CFrame.Angles(0, 0, side * math.rad(30)), mane, "WedgePart")
		end
		detail(model, head, "Ear", Vector3.new(.55, .8, .65), CFrame.new(side * 1.2, .25, .05) * CFrame.Angles(0, 0, side * .25), fur)
		detail(model, head, "Horn", Vector3.new(.5, 1.15, .6), CFrame.new(side * .83, 1.05, .15) * CFrame.Angles(-.15, 0, -side * .25), mane, "WedgePart")
		detail(model, head, "EyeSocket", Vector3.new(.85, .58, .25), CFrame.new(side * .52, .2, -.95), fur)
		detail(model, head, "GlowingEye", Vector3.new(.48, .25, .15), CFrame.new(side * .52, .19, -1.12) * CFrame.Angles(0, 0, -side * .18), eyes, nil, true)
		detail(model, head, "Brow", Vector3.new(.9, .32, .42), CFrame.new(side * .52, .53, -1.02) * CFrame.Angles(0, 0, side * -.22), bone)
		detail(model, head, "Cheek", Vector3.new(.5, .9, .4), CFrame.new(side * .83, -.3, -.85) * CFrame.Angles(0, 0, -side * .16), bone)
		detail(model, head, "Fang", Vector3.new(.22, .6, .22), CFrame.new(side * .62, -.73, -1.14) * CFrame.Angles(math.pi, 0, 0), bone, "WedgePart")
	end
	detail(model, head, "HeadMane", Vector3.new(2.65, 2.05, 1.6), CFrame.new(0, .15, .15), mane)
	detail(model, head, "PaleMask", Vector3.new(2.1, 1.7, .7), CFrame.new(0, -.02, -.65), bone)
	-- Eyes and mouth sit forward of the face, keeping features readable in motion.
	detail(model, head, "Nose", Vector3.new(.48, .45, .4), CFrame.new(0, -.16, -1.06), fur)
	detail(model, head, "Mouth", Vector3.new(1.35, .5, .2), CFrame.new(0, -.56, -1.1), Color3.fromRGB(31, 19, 31))
	detail(model, head, "LowerJaw", Vector3.new(1.35, .3, .6), CFrame.new(0, -.88, -.78), bone)
	detail(model, head, "Tongue", Vector3.new(.42, .65, .19), CFrame.new(0, -.93, -1.16) * CFrame.Angles(.25, 0, 0), Color3.fromRGB(154, 97, 160))
	for index, limb in ipairs(limbs) do
		if index &lt;= 2 then
			detail(model, limb, "LongForearm", Vector3.new(1.3, 3.25, 1.35), CFrame.new(0, -.6, 0), fur)
			detail(model, limb, "KnuckleHand", Vector3.new(1.6, 1.05, 1.7), CFrame.new(0, -2, -.28), mane)
			for finger = -1, 1 do detail(model, limb, "Claw", Vector3.new(.22, .3, .65), CFrame.new(finger * .45, -2.25, -1.24) * CFrame.Angles(.15, 0, 0), bone, "WedgePart") end
		else
			detail(model, limb, "Haunch", Vector3.new(1.25, 1.65, 1.4), CFrame.new(0, .12, 0), fur)
			detail(model, limb, "BroadFoot", Vector3.new(1.3, .65, 1.9), CFrame.new(0, -.72, -.38), mane)
		end
	end
	model.PrimaryPart = root
	if not cosmetic then
		local humanoid = Instance.new("Humanoid")
		humanoid.DisplayName = "RIFT STALKER"
		humanoid.WalkSpeed, humanoid.JumpPower, humanoid.UseJumpPower = 29, 0, true
		humanoid.RequiresNeck = false
		humanoid.NameDisplayDistance = 40
		humanoid.Parent = model
		local outline = Instance.new("Highlight")
		outline.FillColor, outline.FillTransparency, outline.OutlineColor = violet, .96, violet
		outline.OutlineTransparency, outline.DepthMode, outline.Parent = .45, Enum.HighlightDepthMode.Occluded, model
	end
	return model
end

function Creature.track(model) CollectionService:AddTag(model, "RiftCreature") end

function Creature.variant(model, kind)
	model:SetAttribute("Archetype", kind)
	local tint = kind == "Bruiser" and Color3.fromRGB(255, 194, 102) or Color3.fromRGB(107, 226, 255)
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") and (obj.Name == "GlowingEye" or obj.Name == "ChestPlate") then obj.Color = tint end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.DisplayName = kind == "Bruiser" and "RIFT BRUISER" or "CHARGE STALKER" end
end

-- Recolor only existing decorative parts. Skeleton, hitbox, eyes and movement
-- remain identical so mastery cosmetics never hide the archetype warning color.
function Creature.skin(model, key)
	local palettes = {
		Grove = { body = {35,73,61}, mane = {63,113,78}, mask = {210,245,197}, accent = {123,255,176} },
		Ruins = { body = {76,47,40}, mane = {118,73,52}, mask = {255,220,160}, accent = {255,187,125} },
		Harbor = { body = {35,44,82}, mane = {70,74,132}, mask = {202,229,255}, accent = {140,209,255} },
	}
	local palette = palettes[key]
	for _, part in ipairs(model:GetDescendants()) do
		if not part:IsA("BasePart") or part.Transparency &gt;= 1 then continue end
		local name = part.Name
		if name == "GlowingEye" or name == "ChestPlate" then continue end
		local original = part:GetAttribute("SkinBaseColor")
		if not original then original = part.Color part:SetAttribute("SkinBaseColor",original) end
		if not palette then part.Color = original continue end
		local color = palette.body
		if name == "PaleMask" or name == "Brow" or name == "Cheek" or name == "Fang" or name == "Claw" or name == "LowerJaw" then color = palette.mask
		elseif name == "Horn" then color = palette.accent
		elseif name == "HeadMane" or name == "ManeTuft" or name == "ShoulderHump" or name == "KnuckleHand" then color = palette.mane
		elseif name == "EyeSocket" or name == "Mouth" or name == "Tongue" then continue end
		part.Color = Color3.fromRGB(unpack(color))
	end
	model:SetAttribute("MasterySkin", key)
end

function Creature.apply(character, enabled)
	local current = costumes[character]
	if enabled and current and current.model.Parent then return current.model end
	if current then
		current.connection:Disconnect()
		for obj, transparency in pairs(current.hidden) do if obj.Parent then obj.Transparency = transparency end end
		CollectionService:RemoveTag(current.model, "RiftCreature")
		current.model:Destroy()
		costumes[character] = nil
	end
	if not enabled then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local model = Creature.create("RiftCatcherCreature", true)
	local state = { model = model, hidden = {} }
	local function hide(obj)
		if obj:IsDescendantOf(model) or obj:FindFirstAncestor("RiftCosmetics") then return end
		if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
			if state.hidden[obj] == nil then state.hidden[obj] = obj.Transparency end
			obj.Transparency = 1
		end
	end
	for _, obj in ipairs(character:GetDescendants()) do hide(obj) end
	state.connection = character.DescendantAdded:Connect(hide)
	model:PivotTo(root.CFrame)
	local weld = Instance.new("WeldConstraint")
	weld.Name, weld.Part0, weld.Part1, weld.Parent = "AvatarCreatureMount", root, model.PrimaryPart, model.PrimaryPart
	model.Parent = character
	costumes[character] = state
	Creature.track(model)
	return model
end

return Creature
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006093">
      <Properties>
        <string name="Name">CaptureService</string>
        <ProtectedString name="Source">local Replicated = game:GetService("ReplicatedStorage")
local Config = require(Replicated:WaitForChild("RiftShared").Config)
local Remote = Replicated:WaitForChild("RiftAction")
local Capture = {}
local records, victims, cooldowns = {}, {}, setmetatable({}, { __mode = "k" })
local attempts = {}
local handlers

local function anchor(root)
	local original = root.Anchored
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	return original
end

local function cleanup(record, completed)
	records[record.actorRoot] = nil
	attempts[record.victim] = nil
	if record.actorRoot.Parent then record.actorRoot.Anchored = record.actorAnchored end
	if record.actorRoot.Parent and not record.actorAnchored and not record.actorPlayer then pcall(function() record.actorRoot:SetNetworkOwner(nil) end) end
	local now = workspace:GetServerTimeNow()
	Remote:FireAllClients("WarningEnd",record.model)
	if record.model.Parent then
		record.model:SetAttribute("GrabStage", nil)
		record.model:SetAttribute("RecoverUntil", now + (record.captured and .7 or Config.MissRecovery))
	end
	cooldowns[record.actorRoot] = now + (record.captured and .7 or Config.MissRecovery)
	if not record.captured then
		if completed and handlers.dodged then handlers.dodged(record.victim) end
		return
	end
	victims[record.victim] = nil
	for part, value in pairs(record.visibility) do
		if part.Parent then part.Transparency = value part:SetAttribute("CaptureTransparency", nil) end
	end
	if record.victimRoot.Parent then record.victimRoot.Anchored = record.victimAnchored end
	record.victim:SetAttribute("BeingCaptured", false)
	Remote:FireAllClients("CaptureEnd", record.victim.UserId)
	handlers.finished(record.victim, completed)
end

function Capture.init(callbacks) handlers = callbacks end
function Capture.busy(root) return records[root] ~= nil end
function Capture.winding(root) local record = records[root] return record ~= nil and not record.captured and not record.lungeFrame end
function Capture.recovering(root) return workspace:GetServerTimeNow() &lt; (cooldowns[root] or 0) end
function Capture.hasActive() return next(records) ~= nil end
function Capture.isVictim(player) return victims[player] ~= nil end

function Capture.evade(player)
	local record=attempts[player]
	if not record or record.captured then return false end
	cleanup(record,true)
	return true
end

function Capture.tryGrab(victim, actorModel, actorRoot, actorPlayer)
	local now = workspace:GetServerTimeNow()
	if records[actorRoot] or attempts[victim] or victims[victim] or now &lt; (cooldowns[actorRoot] or 0) then return false end
	local root = handlers.valid(victim, actorRoot, actorPlayer)
	if not root or not actorModel or not actorModel.Parent then return false end
	local record = { victim = victim, model = actorModel, actorRoot = actorRoot, actorPlayer = actorPlayer,
		victimRoot = root, began = now, captured = false, actorFrame = actorRoot.CFrame, actorAnchored = actorRoot.Anchored }
	records[actorRoot] = record
	attempts[victim] = record
	actorModel:SetAttribute("GrabStage", "Reach")
	actorModel:SetAttribute("GrabStartedAt", now)
	Remote:FireAllClients("GrabWarning", { victim = victim, model = actorModel, duration = Config.GrabWindup })
	return true
end

function Capture.step(now)
	for actorRoot, record in pairs(records) do
		if not actorRoot.Parent or not record.model.Parent or not record.victim.Parent or not record.victimRoot.Parent then cleanup(record, false) continue end
		if not record.captured then
			-- Pursue during the readable reach, then commit to a short fixed lunge.
			local lungeSeconds = math.min(Config.GrabLungeSeconds,Config.GrabWindup)
			local lunge = math.clamp((now-record.began-Config.GrabWindup+lungeSeconds)/lungeSeconds, 0, 1)
			if lunge &gt; 0 then
				if not record.lungeFrame then
					record.lungeFrame = actorRoot.CFrame
					local ahead = (record.victimRoot.Position-actorRoot.Position):Dot(actorRoot.CFrame.LookVector)
					local forwardSpeed = math.max(0, record.victimRoot.AssemblyLinearVelocity:Dot(actorRoot.CFrame.LookVector))
					record.lungeDistance = math.clamp(ahead-1.8+forwardSpeed*lungeSeconds, 0, Config.GrabLungeDistance)
					anchor(actorRoot)
				end
				local target = record.lungeFrame + record.lungeFrame.LookVector * (lunge * record.lungeDistance)
				if not handlers.canLunge or handlers.canLunge(actorRoot.Position, target.Position) then actorRoot.CFrame = target end
			end
			if now - record.began &lt; Config.GrabWindup then continue end
			local root = handlers.valid(record.victim, actorRoot, record.actorPlayer)
			if not root or victims[record.victim] then cleanup(record, true) continue end
			record.captured, record.started = true, now
			record.victimRoot, record.victimAnchored = root, anchor(root)
			victims[record.victim] = record
			record.visibility = {}
			for _, part in ipairs(record.victim.Character:GetDescendants()) do
				if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
					record.visibility[part] = part.Transparency
					part:SetAttribute("CaptureTransparency", part.Transparency)
					part.Transparency = 1
				end
			end
			record.model:SetAttribute("GrabStage", "Consume")
			record.model:SetAttribute("GrabStartedAt", now)
			record.victim:SetAttribute("BeingCaptured", true)
			handlers.started(record.victim, record.actorPlayer)
			Remote:FireAllClients("Capture", { victim = record.victim, model = record.model, started = now, duration = Config.CaptureDuration })
		end
		local elapsed = now - record.started
		local lift = math.clamp(elapsed / 1.05, 0, 1)
		record.victimRoot.CFrame = actorRoot.CFrame * CFrame.new(0, 2.5 * lift, -3 + .9 * lift)
		if elapsed &gt;= Config.CaptureDuration then cleanup(record, true) end
	end
end

function Capture.cancelAll()
	local list = {}
	for _, record in pairs(records) do table.insert(list, record) end
	for _, record in ipairs(list) do cleanup(record, false) end
end
function Capture.remove(player)
	local list = {}
	for _, record in pairs(records) do if record.victim == player or record.actorPlayer == player then table.insert(list, record) end end
	for _, record in ipairs(list) do cleanup(record, false) end
end
function Capture.cancelActor(root)
	local record = records[root]
	if record then cleanup(record, false) end
end
return Capture
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006094">
      <Properties>
        <string name="Name">StyleService</string>
        <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Config, Rules = require(Shared.Config), require(Shared.Rules)
local Styles = {}

function Styles.sync(player, profile, entitlements)
	local unlocked, equipped = {}, { Aura = "NoAura", Title = "NoTitle", Skin = "DefaultSkin", Victory = "DefaultVictory" }
	for _, definition in ipairs(Config.Cosmetics) do
		if Rules.cosmeticAvailable(profile, definition, entitlements) then
			table.insert(unlocked, definition.id)
			if profile[definition.slot .. "Equipped"] == definition.id then equipped[definition.slot] = definition.id end
		end
	end
	player:SetAttribute("CosmeticsUnlocked", table.concat(unlocked, ","))
	for slot, id in pairs(equipped) do player:SetAttribute(slot .. "Equipped", id) end
end

local function ornament(model, root, name, size, offset, color, wedge)
	local part = Instance.new(wedge and "WedgePart" or "Part")
	part.Name, part.Size, part.CFrame = name, size, root.CFrame * offset
	part.Color, part.Material, part.Transparency = color, Enum.Material.Neon, .15
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow, part.Massless = false, false, false, false, true
	part.CollisionGroup = "RiftCharacters"
	part.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = root, part, part
end

function Styles.apply(player, profile, entitlements, role)
	local character = player.Character
	if not character then return end
	local old = character:FindFirstChild("RiftCosmetics")
	if old then old:Destroy() end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not profile or role == "Captured" then return end
	local aura, title
	for _, definition in ipairs(Config.Cosmetics) do
		if Rules.cosmeticAvailable(profile, definition, entitlements) then
			if definition.slot == "Aura" and profile.AuraEquipped == definition.id and definition.shape then aura = definition end
			if definition.slot == "Title" and profile.TitleEquipped == definition.id and definition.text then title = definition end
		end
	end
	if not aura and not title then return end
	local model = Instance.new("Model")
	model.Name = "RiftCosmetics"
	if aura then
		local color = Color3.fromRGB(unpack(aura.rgb))
		local count = aura.shape == "Sparks" and 6 or (aura.shape == "Bloom" and 8 or 12)
		local radius = aura.shape == "Sparks" and 2.2 or (aura.shape == "Bloom" and 2.5 or 1.25)
		local y = aura.shape == "Sparks" and -.3 or (aura.shape == "Bloom" and -2.5 or 3)
		if role == "Catcher" then
			if aura.shape == "Sparks" or aura.shape == "Bloom" then radius += .8 else y += .8 end
		end
		for index = 1, count do
			local angle = index*math.pi*2/count
			local halo = aura.shape == "Halo" or aura.shape == "Crown"
			local size = halo and Vector3.new(.62, .12, .18) or Vector3.new(.3, .65, .3)
			local offset = CFrame.new(math.cos(angle)*radius, y + (halo and 0 or index%2*.3), math.sin(angle)*radius) * CFrame.Angles(0, -angle-math.pi/2, 0)
			ornament(model, root, aura.id, size, offset, color, not halo)
			if aura.shape == "Crown" and index%3 == 0 then
				ornament(model, root, "CrownPoint", Vector3.new(.35, .65, .35), CFrame.new(math.cos(angle)*radius, y+.35, math.sin(angle)*radius), color, true)
			end
		end
	end
	if title then
		local creature = character:FindFirstChild("RiftCatcherCreature")
		local head = creature and creature:FindFirstChild("Head") or character:FindFirstChild("Head") or root
		local badge = Instance.new("BillboardGui")
		badge.Name, badge.Adornee, badge.Size = "StyleTitle", head, UDim2.fromOffset(230, 28)
		badge.StudsOffset, badge.MaxDistance, badge.AlwaysOnTop = Vector3.new(0, 4.4, 0), 65, false
		local text = Instance.new("TextLabel")
		text.Size, text.BackgroundTransparency, text.Text = UDim2.fromScale(1, 1), 1, title.text
		text.Font, text.TextSize, text.TextColor3 = Enum.Font.GothamBold, 12, Color3.fromRGB(unpack(title.rgb))
		text.TextStrokeTransparency, text.Parent = .45, badge
		badge.Parent = model
	end
	model.Parent = character
	return model
end

return Styles
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006095">
      <Properties>
        <string name="Name">CourseService</string>
        <ProtectedString name="Source">-- Only server-created map mechanics can change collision or grant route boosts.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Config, Rules = require(Shared.Config), require(Shared.Rules)
local Arena = workspace:WaitForChild("RiftArena")
local Templates = game:GetService("ServerStorage"):WaitForChild("RiftMechanics")
local function createService(targetArena)
local Arena = targetArena
local Courses = {}
local active, records, pickups = Arena:FindFirstChild("ActiveMechanics"), {}, {}

function Courses.activate(mapId)
	Courses.bind(Templates:WaitForChild(mapId):Clone())
end

function Courses.bind(model)
	if active then active:Destroy() end
	active = model
	active.Name, active.Parent = "ActiveMechanics", Arena
	records, pickups = {}, {}
	for _, group in ipairs(active:GetChildren()) do
		local stage = tonumber(group.Name)
		for _, part in ipairs(group:GetChildren()) do
			if not part:IsA("BasePart") then continue end
			if part.Name == "BonusCrystal" then
				pickups[stage] = pickups[stage] or {}
				table.insert(pickups[stage], { part = part, kind = "BonusCrystal" })
			elseif part.Name == "GroveBridge" or part.Name == "CrumbleTile" or part.Name == "CargoGate" then
				table.insert(records, { part = part, stage = stage, home = part.CFrame, color = part.Color, state = "Solid", phase = part.Position.Z*.07 })
			end
		end
	end
end

function Courses.interactions(stage) return pickups[stage] or {} end

function Courses.step(now, running)
	for _, record in ipairs(records) do
		local part = record.part
		if part.Name == "CargoGate" then
			part.CFrame = record.home + Vector3.new(running and math.sin(now*.7+record.phase)*5 or 0, 0, 0)
		elseif part.Name == "CrumbleTile" then
			if not running then
				record.state, part.CanCollide, part.Transparency, part.Color = "Solid", true, 0, record.color
			elseif record.state == "Warning" then
				part.Color = Color3.fromRGB(255, math.floor(150+80*math.abs(math.sin(now*12))), 89)
				if now &gt;= record.at then
					record.state, record.at, part.CanCollide, part.Transparency = "Gone", now+3, false, .9
				end
			elseif record.state == "Gone" and now &gt;= record.at then
				record.state, part.CanCollide, part.Transparency, part.Color = "Solid", true, 0, record.color
			end
		end
	end
end

function Courses.contact(position, stage, grounded, now)
	local boost = false
	for _, record in ipairs(records) do
		if record.stage == stage and Rules.onSurface(position, record.part, grounded) then
			if record.part.Name == "GroveBridge" then boost = true
			elseif record.part.Name == "CrumbleTile" and record.state == "Solid" then
				record.state, record.at = "Warning", now+1.1
			end
		end
	end
	return boost
end

return Courses
end

local Courses = createService(Arena)
Courses.new = createService
return Courses
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006096">
      <Properties>
        <string name="Name">PlaytestService</string>
        <ProtectedString name="Source">-- Aggregate local playtest evidence. Reports contain no names or user IDs and
-- stay in server Output. Human playtests still supply the actual observations.
local Metrics = {}
local people = {}
local totals, falls, catches, exits = {}, {}, {}, {}
local allowed = { join = true, start = true, finish = true, fall = true, catch = true, dodge = true, dash = true, retry = true, complete = true }
local fpsSum, fpsSamples, touchSamples, touchFps = 0, 0, 0, 0
function Metrics.join(player) people[player] = { joined = os.clock(), stage = 0, sampledAt = -100 } Metrics.event(player, "join", 0) end
function Metrics.stage(player, stage) if people[player] then people[player].stage = stage end end
function Metrics.event(player, name, stage)
	if not allowed[name] then return end
	totals[name] = (totals[name] or 0)+1
	local person = people[player]
	if person then person.stage = stage or person.stage end
	if name == "fall" then falls[stage] = (falls[stage] or 0)+1 end
	if name == "catch" then catches[stage] = (catches[stage] or 0)+1 end
	if name == "finish" and stage == 1 and person and not person.firstFinish then
		person.firstFinish = os.clock()-person.joined
		totals.firstFinishSeconds = (totals.firstFinishSeconds or 0)+person.firstFinish
		totals.firstFinishPlayers = (totals.firstFinishPlayers or 0)+1
	end
end
function Metrics.sample(player, payload)
	local person = people[player]
	if not person or type(payload) ~= "table" or os.clock()-person.sampledAt &lt; 15 then return false end
	local fps = payload.fps
	if type(fps) ~= "number" or fps ~= fps or fps &lt; 1 or fps &gt; 240 or type(payload.touch) ~= "boolean" then return false end
	person.sampledAt = os.clock()
	fpsSum, fpsSamples = fpsSum+fps, fpsSamples+1
	if payload.touch then touchSamples += 1 touchFps += fps end
	return true
end
function Metrics.leave(player)
	local person = people[player]
	if person then exits[person.stage] = (exits[person.stage] or 0)+1 people[player] = nil end
end
function Metrics.snapshot() return { totals = table.clone(totals), falls = table.clone(falls), catches = table.clone(catches), exits = table.clone(exits), fps = fpsSamples &gt; 0 and fpsSum/fpsSamples or 0, samples = fpsSamples, touchSamples = touchSamples,
	touchFps = touchSamples &gt; 0 and touchFps/touchSamples or 0, desktopFps = fpsSamples &gt; touchSamples and (fpsSum-touchFps)/(fpsSamples-touchSamples) or 0 } end
function Metrics.report(mapId, round)
	local report = Metrics.snapshot()
	local stages = {}
	for stage = 0, 5 do table.insert(stages, string.format("%d:falls=%d,catches=%d,exits=%d", stage, falls[stage] or 0, catches[stage] or 0, exits[stage] or 0)) end
	print(string.format("[RiftPlaytest] map=%s round=%d starts=%d finishes=%d escapes=%d retries=%d dodges=%d fps=%.1f samples=%d touch=%d", tostring(mapId), round, totals.start or 0, totals.finish or 0, totals.complete or 0, totals.retry or 0, totals.dodge or 0, report.fps, fpsSamples, touchSamples))
	print("[RiftPlaytest] " .. table.concat(stages, " | "))
	print(string.format("[RiftPlaytest] first-course=%.1fs first-finishes=%d touch-fps=%.1f desktop-fps=%.1f (client-reported samples)", (totals.firstFinishSeconds or 0)/math.max(1, totals.firstFinishPlayers or 0), totals.firstFinishPlayers or 0, report.touchFps, report.desktopFps))
	return report
end
return Metrics
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006097">
      <Properties>
        <string name="Name">CatcherNavigation</string>
        <ProtectedString name="Source">local Pathfinding = game:GetService("PathfindingService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Config = require(Shared.Config)
local Arena = workspace:WaitForChild("RiftArena")
local Navigation = {}
local params = RaycastParams.new()
params.FilterType, params.FilterDescendantsInstances, params.RespectCanCollide = Enum.RaycastFilterType.Include, { Arena }, true
local stable = { ArenaFloor = true, SafeDeck = true, CourseFloor = true, CourseDeck = true, CourseBypass = true, CourseBypassLane = true, CourseJunction = true }
local function flat(v) return Vector3.new(v.X, 0, v.Z) end
local function ground(point)
	local hit = workspace:Raycast(point+Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), params)
	if hit and hit.Normal.Y &gt; .7 and hit.Position.Y &lt;= point.Y-1 then return hit end
	return nil
end
local function clearBody(from, to)
	local travel = flat(to-from)
	if travel.Magnitude &lt; .01 then return true end
	local side = Vector3.new(-travel.Unit.Z, 0, travel.Unit.X)*1.4
	for _, offset in ipairs({ Vector3.new(0, -2, 0), side+Vector3.new(0, -2, 0), -side+Vector3.new(0, -2, 0), Vector3.new(0, 1.5, 0) }) do
		if workspace:Raycast(from+offset, travel, params) then return false end
	end
	return true
end

-- Charges/lunges must have a full body-width supported corridor. A chest-height
-- line alone misses low hurdles, vanished stones and the empty space over gaps.
function Navigation.safeSegment(from, to)
	if not clearBody(from, to) then return false end
	local travel = flat(to-from)
	local base = ground(from)
	if not base or base.Instance.Name == "CrumbleTile" then return false end
	local side = travel.Magnitude &gt; .01 and Vector3.new(-travel.Unit.Z, 0, travel.Unit.X)*1.4 or Vector3.new(1.4, 0, 0)
	local steps = math.max(1, math.ceil(travel.Magnitude/2))
	for i = 0, steps do
		local point = from+travel*(i/steps)
		for _, offset in ipairs({ Vector3.zero, side, -side }) do
			local hit = ground(point+offset)
			if not hit or hit.Instance.Name == "CrumbleTile" or math.abs(hit.Position.Y-base.Position.Y) &gt; .8 then return false end
		end
	end
	return true
end

function Navigation.reset(bot, now)
	local nav = bot.navigation
	if nav and nav.blocked then nav.blocked:Disconnect() end
	bot.navigation = { revision = nav and nav.revision+1 or 1, waypoints = {}, index = 1,
		computing = false, nextPath = now, progressAt = now, progressOrigin = bot.root.Position,
		lastSafe = nav and nav.lastSafe or bot.spawnPoint, previousSafe = nav and nav.previousSafe }
	bot.humanoid.Jump = false
end
function Navigation.remove(bot)
	Navigation.reset(bot, 0)
	bot.navigation.removed = true
end
function Navigation.recover(bot, now, stuck)
	local nav = bot.navigation
	local point = nav and nav.lastSafe or bot.spawnPoint
	if stuck and flat(point-bot.root.Position).Magnitude &lt; 4 then point = nav.previousSafe or bot.spawnPoint end
	local hit = ground(point)
	if not hit or not stable[hit.Instance.Name] then point = bot.spawnPoint hit = ground(point) end
	if hit then point = Vector3.new(point.X, hit.Position.Y+Config.FloorY, point.Z) end
	Navigation.reset(bot, now+.5)
	bot.chargeAt, bot.recoverAt, bot.nextCharge = nil, now+.9, now+Config.ChargeCooldown
	bot.model:SetAttribute("ChargeStage", nil)
	bot.model:SetAttribute("RecoverUntil", workspace:GetServerTimeNow()+.9)
	bot.model:SetAttribute("NavigationRecoverUntil", workspace:GetServerTimeNow()+.9)
	bot.model:PivotTo(CFrame.lookAt(point, point+Vector3.new(0, 0, 1)))
	bot.navigation.lastSafe, bot.navigation.progressOrigin = point, point
	bot.root.AssemblyLinearVelocity, bot.root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	bot.humanoid:Move(Vector3.zero)
end
function Navigation.idle(bot, now)
	if bot.navigation then bot.navigation.progressAt = now bot.navigation.progressOrigin = bot.root.Position end
	bot.humanoid:Move(Vector3.zero)
end

local function request(bot, target, now)
	local nav = bot.navigation
	if nav.computing or now &lt; nav.nextPath or bot.humanoid.FloorMaterial == Enum.Material.Air then return end
	nav.computing, nav.nextPath = true, now+1
	local origin, destination = bot.root.Position, target.Position
	task.spawn(function()
		local ok, path, points = pcall(function()
			local path = Pathfinding:CreatePath({ AgentRadius = 2, AgentHeight = 6, AgentCanJump = true, WaypointSpacing = 4,
				Costs = { Unstable = math.huge } })
			path:ComputeAsync(origin, destination)
			return path, path.Status == Enum.PathStatus.Success and path:GetWaypoints() or nil
		end)
		-- A fall, despawn, charge or completed course invalidates in-flight work.
		if bot.navigation ~= nav or nav.removed or not bot.model.Parent then return end
		nav.computing = false
		if not ok or not points or #points &lt; 2 then nav.failed = true return end
		if flat(bot.root.Position-origin).Magnitude &gt; 12 then nav.nextPath = 0 return end
		if nav.blocked then nav.blocked:Disconnect() end
		nav.waypoints, nav.index, nav.goal, nav.failed, nav.jumpIndex = points, 2, destination, false, nil
		if path.Blocked then
			nav.blocked = path.Blocked:Connect(function(index)
				if bot.navigation == nav and index &gt;= nav.index then nav.dirty = true nav.nextPath = 0 end
			end)
		end
		nav.dirty = false
	end)
end

function Navigation.prime(bot, target, now)
	if not bot.navigation then Navigation.reset(bot, now) end
	local nav = bot.navigation
	-- Ready time is preparation time, never evidence that the actor is stuck.
	nav.progressAt, nav.progressOrigin = now, bot.root.Position
	if #nav.waypoints == 0 then request(bot, target, now) end
end

function Navigation.follow(bot, target, now)
	if not bot.navigation then Navigation.reset(bot, now) end
	local nav, position = bot.navigation, bot.root.Position
	local distance = flat(target.Position-position).Magnitude
	if distance &lt; 1.8 then
		nav.progressAt, nav.progressOrigin = now, position
		if distance &gt; .1 then bot.root.CFrame = CFrame.lookAt(position, position+flat(target.Position-position)) end
		bot.humanoid:Move(Vector3.zero)
		return
	end
	if flat(position-nav.progressOrigin).Magnitude &gt; 1.2 then nav.progressAt, nav.progressOrigin = now, position end
	if bot.humanoid.FloorMaterial ~= Enum.Material.Air then
		local hit = ground(position)
		if hit and stable[hit.Instance.Name] and flat(position-nav.lastSafe).Magnitude &gt; 8 then nav.previousSafe, nav.lastSafe = nav.lastSafe, position end
	end
	if now-nav.progressAt &gt; 3.5 then Navigation.recover(bot, now, true) return end
	local travel = flat(target.Position-position)
	if math.abs(target.Position.Y-position.Y) &lt; 2 and clearBody(position, target.Position)
		and Navigation.safeSegment(position, position+travel.Unit*math.min(8, travel.Magnitude)) then
		-- A direct shortcut can pass old path nodes. Discard that route rather
		-- than walking backwards to it when the next bend needs pathfinding.
		if not nav.direct then Navigation.reset(bot, now) nav = bot.navigation nav.direct = true end
		bot.humanoid:Move(travel.Unit)
		return
	end
	if nav.direct then Navigation.reset(bot, now) nav = bot.navigation end
	local exhausted = nav.index &gt; #nav.waypoints
	if nav.dirty or exhausted or not nav.goal or flat(target.Position-nav.goal).Magnitude &gt; 8 or now-nav.progressAt &gt; 1.2 then request(bot, target, now) end
	if nav.dirty then bot.humanoid:Move(Vector3.zero) return end
	local waypoint = nav.waypoints[nav.index]
	-- Waypoints lie on the floor. Compare horizontal progress, not root-to-floor
	-- 3D distance, and select the next waypoint before issuing MoveTo.
	while waypoint and flat(position-waypoint.Position).Magnitude &lt; 2.2
		and position.Y &gt;= waypoint.Position.Y-1 and position.Y &lt;= waypoint.Position.Y+7
		and bot.humanoid.FloorMaterial ~= Enum.Material.Air do
		nav.index += 1
		waypoint = nav.waypoints[nav.index]
	end
	if not waypoint then bot.humanoid:Move(Vector3.zero) return end
	if waypoint.Action == Enum.PathWaypointAction.Jump and nav.jumpIndex ~= nav.index and bot.humanoid.FloorMaterial ~= Enum.Material.Air then
		bot.humanoid.Jump, nav.jumpIndex = true, nav.index
	end
	bot.humanoid:MoveTo(waypoint.Position)
end
return Navigation
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006098">
      <Properties>
        <string name="Name">MasteryService</string>
        <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Config, Rules = require(Shared.Config), require(Shared.Rules)
local Mastery = {}
local stats = { "MedalPoints", "BronzeMedals", "SilverMedals", "GoldMedals", "GroveMedals", "RuinsMedals", "HarborMedals" }

function Mastery.ensure(profile)
	if not profile.Mastery or profile.Mastery.Revision ~= Rules.MasteryRevision then profile.Mastery = Rules.sanitizeProfile(profile, Config.Trails, Config.Cosmetics).Mastery end
	Rules.refreshMastery(profile)
	return profile.Mastery
end

function Mastery.sync(player, profile)
	local data = Mastery.ensure(profile)
	player:SetAttribute("UnlockedCourse", data.UnlockedCourse)
	for _, stat in ipairs(stats) do player:SetAttribute(stat, profile[stat]) end
	for _, map in ipairs(Config.Maps) do
		for stage = 1, #Config.Courses do
			local key = Rules.masteryKey(map.id, stage)
			local race, practice = data.Races[key], data.Practice[key]
			player:SetAttribute("Best_" .. key, race and race.bestMs and race.bestMs/1000 or nil)
			player:SetAttribute("Medal_" .. key, race and race.medal or 0)
			player:SetAttribute("PracticeBest_" .. key, practice and practice.bestMs and practice.bestMs/1000 or nil)
		end
	end
end

function Mastery.reached(profile, stage)
	local data = Mastery.ensure(profile)
	if stage &gt;= 1 and stage &lt;= #Config.Courses then data.UnlockedCourse = math.max(data.UnlockedCourse, stage) end
end

function Mastery.finish(player, profile, mapId, stage, elapsed, training)
	Mastery.ensure(profile)
	local available = {}
	for _, definition in ipairs(Config.Trails) do available[definition.id] = Rules.trailAvailable(profile, definition, {}) end
	for _, definition in ipairs(Config.Cosmetics) do available[definition.id] = Rules.cosmeticAvailable(profile, definition, {}) end
	local result = Rules.recordCourse(profile, Config, mapId, stage, elapsed, training)
	if not result then return nil end
	result.unlocks = {}
	for _, definition in ipairs(Config.Trails) do
		if definition.requirement and not available[definition.id] and Rules.trailAvailable(profile, definition, {}) then table.insert(result.unlocks, definition.name) end
	end
	for _, definition in ipairs(Config.Cosmetics) do
		if definition.requirement and not available[definition.id] and Rules.cosmeticAvailable(profile, definition, {}) then table.insert(result.unlocks, definition.name) end
	end
	Mastery.sync(player, profile)
	return result
end

return Mastery
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006099">
      <Properties>
        <string name="Name">PracticeService</string>
        <ProtectedString name="Source">-- Training instances never share collision, hazards, rewards or chase clocks
-- with the main race. Equal course/theme choices share one bounded copy.
local Replicated = game:GetService("ReplicatedStorage")
local Storage = game:GetService("ServerStorage")
local Shared = Replicated:WaitForChild("RiftShared")
local Config, Rules = require(Shared.Config), require(Shared.Rules)
local Courses = require(script.Parent.CourseService)
local Arena = workspace:WaitForChild("RiftArena")
local Practice = {}
local groups, attempts = {}, {}
local handlers

local function shift(model, y)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then part.CFrame += Vector3.new(0,y,0) end
	end
end

local function acquire(mapId, stage)
	local key = Rules.masteryKey(mapId, stage)
	if groups[key] then groups[key].users += 1 return groups[key] end
	local map, index
	for i, definition in ipairs(Config.Maps) do if definition.id == mapId then map, index = definition, i end end
	local y = -Config.Mastery.PracticeLayerDepth*index
	local model = Instance.new("Model")
	model.Name = "Practice_" .. key
	local geometry = Instance.new("Model")
	geometry.Name, geometry.Parent = "CourseGeometry", model
	if stage == 1 then
		for _, part in ipairs(Arena:GetChildren()) do if part:IsA("BasePart") then part:Clone().Parent = geometry end end
		Storage.RiftMaps:FindFirstChild(mapId):Clone().Parent = geometry
	else
		Arena.ChaseCourses:FindFirstChild("Course_" .. stage):Clone().Parent = geometry
	end
	shift(geometry, y)
	for _, part in ipairs(geometry:GetDescendants()) do
		if part:IsA("BasePart") then
			if part.Name == "ArenaFloor" or part.Name == "SafeDeck" or part.Name == "CourseFloor" or part.Name == "CourseDeck" then part.Color = Color3.fromRGB(unpack(map.floor)) end
			if part.Name == "CourseAccent" or part.Name == "CourseFinish" then part.Color = Color3.fromRGB(unpack(map.rgb)) end
		end
	end
	local mechanics = Instance.new("Model")
	Storage.RiftMechanics:FindFirstChild(mapId):FindFirstChild(tostring(stage)):Clone().Parent = mechanics
	shift(mechanics, y)
	local service = Courses.new(model)
	service.bind(mechanics)
	-- A separate night canopy keeps the practice arena inside the Rift theme.
	local canopy = Instance.new("Part")
	canopy.Name, canopy.Size = "PracticeNight", Vector3.new(800, 2, 800)
	local course = Config.Courses[stage]
	canopy.CFrame, canopy.Color = CFrame.new(course.x,y+100,course.z), Color3.fromRGB(24,19,43)
	canopy.Anchored, canopy.CanCollide, canopy.CanTouch, canopy.CanQuery, canopy.CastShadow = true, false, false, false, false
	canopy.Material, canopy.Parent = Enum.Material.Neon, model
	local pickups = {}
	for _, part in ipairs(geometry:GetDescendants()) do
		if part:IsA("BasePart") and string.sub(part.Name,1,8) == "Recharge" then
			table.insert(pickups,{part=part,kind=part.HoverIcon.Kind.Value})
		end
	end
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances, params.RespectCanCollide = Enum.RaycastFilterType.Include, {model}, true
	model.Parent = workspace
	local group = { key=key, model=model, service=service, pickups=pickups, params=params, y=y, users=1, mapId=mapId, stage=stage }
	groups[key] = group
	return group
end

local function release(player)
	local attempt = attempts[player]
	if not attempt then return end
	attempt.group.users -= 1
	if attempt.group.users == 0 then attempt.group.model:Destroy() groups[attempt.group.key] = nil end
	attempts[player] = nil
end

function Practice.init(callbacks) handlers = callbacks end
function Practice.get(player) return attempts[player] end

function Practice.restart(player)
	local attempt = attempts[player]
	if not attempt then return false end
	local now = workspace:GetServerTimeNow()
	attempt.started, attempt.finished = now+Config.Mastery.PracticeCountdown, false
	player:SetAttribute("PracticeStartedAt", attempt.started)
	player:SetAttribute("PracticeFinished", false)
	player:SetAttribute("PracticeFinalTime",nil)
	handlers.reset(player)
	local course = Config.Courses[attempt.group.stage]
	handlers.move(player, Vector3.new(course.x,attempt.group.y+Config.FloorY,course.z-Config.StartZ),1)
	return true
end

function Practice.start(player, mapId, stage)
	if not Rules.masteryKey(mapId, stage) or not handlers.canStart(player) then return false end
	local profile = handlers.profile(player)
	if not profile or stage &gt; profile.Mastery.UnlockedCourse then return false end
	-- Acquire before release so restarting a shared course cannot delete it.
	local group = acquire(mapId,stage)
	release(player)
	attempts[player] = {group=group}
	player:SetAttribute("PracticeMapId",mapId)
	player:SetAttribute("PracticeOffsetY",group.y)
	player:SetAttribute("CoursePractice",true)
	player:SetAttribute("CourseStage",stage)
	handlers.enter(player)
	Practice.restart(player)
	return true
end

function Practice.leave(player, removed)
	if not attempts[player] then return end
	release(player)
	if removed then return end
	player:SetAttribute("CoursePractice",false)
	player:SetAttribute("PracticeFinished",false)
	player:SetAttribute("PracticeFinalTime",nil)
	player:SetAttribute("PracticeOffsetY",0)
	player:SetAttribute("PracticeMapId",nil)
	player:SetAttribute("CourseStage",0)
	handlers.leave(player)
end

function Practice.step(now)
	for _, group in pairs(groups) do group.service.step(now,true) end
end

function Practice.check(player, root, now, validMovement)
	local attempt = attempts[player]
	if not attempt then return end
	local course = Config.Courses[attempt.group.stage]
	local position = root.Position
	if position.Y-attempt.group.y &lt; -10 then Practice.restart(player) return "retry" end
	if not Rules.inCourse(position.X,position.Z,course,Config.StartZ,2) or position.Y-attempt.group.y &gt; 38 or not validMovement then
		-- Invalid movement cannot produce a practice personal best.
		Practice.restart(player) return "retry"
	end
	if now &lt; attempt.started then
		handlers.move(player,Vector3.new(course.x,attempt.group.y+Config.FloorY,course.z-Config.StartZ),1)
		return "ready"
	end
	if attempt.finished then return "finished" end
	if now-attempt.started &gt; Config.Mastery.PracticeTimeLimit then Practice.restart(player) return "retry" end
	if position.Z-course.z &gt;= Config.ArenaHalfLength and now-attempt.started &gt;= Config.MinCourseSeconds then
		attempt.finished = true
		player:SetAttribute("PracticeFinalTime",now-attempt.started)
		player:SetAttribute("PracticeFinished",true)
		handlers.finished(player,attempt.group.mapId,attempt.group.stage,now-attempt.started)
		return "finished"
	end
	return "running"
end

function Practice.contact(player, root, humanoid, now)
	local attempt = attempts[player]
	return attempt and attempt.group.service.contact(root.Position,attempt.group.stage,humanoid.FloorMaterial ~= Enum.Material.Air,now)
end

function Practice.pickups(player)
	local attempt = attempts[player]
	return attempt and attempt.group.pickups or {}
end

function Practice.clearLine(player, from, to)
	local attempt = attempts[player]
	return attempt and workspace:Raycast(from,to-from,attempt.group.params) == nil
end

return Practice
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006100">
      <Properties>
        <string name="Name">VIPGearService</string>
        <ProtectedString name="Source">-- All ownership, movement effects, hit tests and damage stay on the server.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RiftShared")
local Rules = require(Shared.Rules)
local Gear = {}
local callbacks, issued, enemies = nil, {}, {}
local catalog = {
	Speed = {name="Speed Coil", color=Color3.fromRGB(63,197,151)},
	Jump = {name="Jump Coil", color=Color3.fromRGB(130,81,218)},
	Blaster = {name="Rift Blaster", color=Color3.fromRGB(68,174,215)},
}

local function part(parent, name, size, frame, color, handle)
	local p = Instance.new("Part")
	p.Name,p.Size,p.CFrame,p.Color = name,size,frame,color
	p.Material,p.CanCollide,p.CanTouch,p.CanQuery,p.Massless = Enum.Material.Neon,false,false,false,true
	p.Parent = parent
	if handle then
		local weld = Instance.new("WeldConstraint")
		weld.Part0,weld.Part1,weld.Parent = handle,p,p
	end
	return p
end

local function makeTool(key)
	local definition = catalog[key]
	local tool = Instance.new("Tool")
	tool.Name,tool.ToolTip,tool.CanBeDropped = definition.name,"VIP Arena only",false
	tool:SetAttribute("RiftVIPGear",key)
	local handle = part(tool,"Handle",Vector3.new(.35,.9,.45),CFrame.new(),Color3.fromRGB(64,50,90))
	handle.Material = Enum.Material.SmoothPlastic
	if key == "Blaster" then
		part(tool,"Body",Vector3.new(.8,.65,1.5),CFrame.new(0,.65,-.35),Color3.fromRGB(80,55,123),handle).Material=Enum.Material.SmoothPlastic
		part(tool,"Barrel",Vector3.new(.3,.3,1.7),CFrame.new(0,.7,-1.6),definition.color,handle)
		part(tool,"Sight",Vector3.new(.18,.18,.6),CFrame.new(0,1.05,-.5),Color3.fromRGB(255,221,137),handle)
	else
		for index=0,29 do
			local a,b = index/30*math.pi*6,(index+1)/30*math.pi*6
			local from = Vector3.new(math.cos(a)*.55,.2+index/30*2.1,math.sin(a)*.55)
			local to = Vector3.new(math.cos(b)*.55,.2+(index+1)/30*2.1,math.sin(b)*.55)
			part(tool,"Coil",Vector3.new(.15,.15,(to-from).Magnitude+.04),CFrame.lookAt((from+to)/2,to),definition.color,handle)
		end
	end
	return tool
end

function Gear.init(handlers) callbacks=handlers end

function Gear.remove(player)
	local record = issued[player]
	if record then for _,tool in pairs(record.tools) do tool:Destroy() end end
	issued[player]=nil
	player:SetAttribute("VIPGearActive",false)
end

function Gear.inArena(player)
	if not callbacks or not callbacks.owns(player,"VIP") or not callbacks.inLobby(player) then return false end
	local char = player.Character
	local root,hum = char and char:FindFirstChild("HumanoidRootPart"),char and char:FindFirstChildOfClass("Humanoid")
	return root and hum and hum.Health&gt;0 and Rules.lobbyZone(root.Position.X,root.Position.Y,root.Position.Z)=="VIPActivity" or false
end

function Gear.update(player, humanoid)
	if not callbacks.owns(player,"VIP") or not callbacks.inLobby(player) then Gear.remove(player) return nil,nil end
	local bag = player:FindFirstChildOfClass("Backpack")
	if not bag then return nil,nil end
	local record = issued[player]
	if not record then record={tools={},lastShot=-100,inArena=false} issued[player]=record end
	for key in pairs(catalog) do
		if not record.tools[key] or not record.tools[key].Parent then
			local tool = makeTool(key)
			tool.Parent,record.tools[key] = bag,tool
		end
	end
	local active = Gear.inArena(player)
	player:SetAttribute("VIPGearActive",active)
	for _,tool in pairs(record.tools) do tool.Enabled=active end
	if record.inArena and not active and humanoid.Health&gt;0 then humanoid.Health=humanoid.MaxHealth end
	record.inArena=active
	if not active then return nil,nil end
	local char=player.Character
	return record.tools.Speed.Parent==char and 38 or nil,record.tools.Jump.Parent==char and 72 or nil
end

local function targetModel(part_)
	local node = part_
	while node and node~=workspace do
		if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then return node end
		node=node.Parent
	end
	return nil
end

function Gear.fire(player, aim, now)
	local record = issued[player]
	if not record or not Gear.inArena(player) or record.tools.Blaster.Parent~=player.Character then return false end
	if typeof(aim)~="Vector3" or aim.X~=aim.X or aim.Y~=aim.Y or aim.Z~=aim.Z
		or math.abs(aim.X)&gt;100000 or math.abs(aim.Y)&gt;100000 or math.abs(aim.Z)&gt;100000 then return false end
	if now-record.lastShot&lt;.45 then return false end
	local root = player.Character:FindFirstChild("HumanoidRootPart")
	local origin = root.Position+Vector3.new(0,1,0)
	local direction=aim-origin
	if direction.Magnitude&lt;.1 then return false end
	record.lastShot=now
	local params=RaycastParams.new()
	params.FilterType,params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude,{player.Character}
	local hit=workspace:Raycast(origin,direction.Unit*120,params)
	local endpoint=hit and hit.Position or origin+direction.Unit*120
	if hit then
		local model=targetModel(hit.Instance)
		local victim=model and Players:GetPlayerFromCharacter(model)
		local enemy=model and enemies[model]
		if model and ((victim and victim~=player and Gear.inArena(victim)) or enemy) then
			local hum=model:FindFirstChildOfClass("Humanoid")
			local targetRoot=model:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health&gt;0 and targetRoot and Rules.lobbyZone(targetRoot.Position.X,targetRoot.Position.Y,targetRoot.Position.Z)=="VIPActivity" then
				hum:TakeDamage(25)
			end
		end
	end
	callbacks.shot(origin,endpoint)
	return true
end

local spawnAt={0,0}
local lastEnemies=0
function Gear.stepEnemies(now)
	if now-lastEnemies&lt;.25 then return end
	lastEnemies=now
	local fighters={}
	for _,player in ipairs(Players:GetPlayers()) do if Gear.inArena(player) then table.insert(fighters,player) end end
	local occupied={}
	for model,record in pairs(enemies) do
		if not model.Parent or record.hum.Health&lt;=0 or #fighters==0 then
			spawnAt[record.slot]=now+5
			enemies[model]=nil
			model:Destroy()
		else
			occupied[record.slot]=true
			local root=record.root
			if Rules.lobbyZone(root.Position.X,root.Position.Y,root.Position.Z)~="VIPActivity" then
				model:PivotTo(CFrame.new(record.home)) root.AssemblyLinearVelocity=Vector3.zero
			end
			local target,distance=nil,math.huge
			for _,player in ipairs(fighters) do
				local pr=player.Character:FindFirstChild("HumanoidRootPart")
				local gap=(pr.Position-root.Position).Magnitude
				if gap&lt;distance then target,distance=player,gap end
			end
			if target then
				local pr=target.Character:FindFirstChild("HumanoidRootPart")
				if now&gt;=(record.nextPath or 0) and not record.pathPending then
					record.nextPath,record.pathPending=now+1.5,true
					local goal=pr.Position
					task.spawn(function()
						local path=game:GetService("PathfindingService"):CreatePath({AgentRadius=2.4,AgentHeight=6,AgentCanJump=false,WaypointSpacing=4})
						local ok=pcall(function() path:ComputeAsync(root.Position,goal) end)
						if enemies[model]~=record then return end
						record.pathPending=false
						if ok and path.Status==Enum.PathStatus.Success then record.path,record.node=path:GetWaypoints(),2 end
					end)
				end
				local waypoint=record.path and record.path[record.node or 2]
				if waypoint and (Vector3.new(waypoint.Position.X,root.Position.Y,waypoint.Position.Z)-root.Position).Magnitude&lt;2.5 then
					record.node+=1 waypoint=record.path[record.node]
				end
				record.hum:MoveTo(waypoint and waypoint.Position or pr.Position)
				if distance&lt;4.5 and now-record.lastHit&gt;=1.5 then
					local params=RaycastParams.new()
					params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{model}
					local hit=workspace:Raycast(root.Position,pr.Position-root.Position,params)
					if hit and hit.Instance:IsDescendantOf(target.Character) then
						record.lastHit=now
						target.Character:FindFirstChildOfClass("Humanoid"):TakeDamage(10)
					end
				end
			end
		end
	end
	if #fighters==0 then return end
	for slot=1,2 do
		if not occupied[slot] and now&gt;=spawnAt[slot] then
			local home=Vector3.new(205,32,slot==1 and 204 or 244)
			local model=callbacks.creature("Arena Stalker "..slot)
			local root,hum=model:FindFirstChild("HumanoidRootPart"),model:FindFirstChildOfClass("Humanoid")
			model:SetAttribute("VIPArenaEnemy",true)
			hum.DisplayName,hum.WalkSpeed,hum.MaxHealth,hum.Health="RIFT SPARRER",10,100,100
			model.Parent=workspace:WaitForChild("RiftLobby"):WaitForChild("VIPActivity")
			model:PivotTo(CFrame.new(home))
			root:SetNetworkOwner(nil)
			enemies[model]={root=root,hum=hum,home=home,slot=slot,lastHit=now}
		end
	end
end

return Gear
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX006101">
      <Properties>
        <string name="Name">LaunchService</string>
        <ProtectedString name="Source">-- Optional lessons, daily goals and owner-only parkour replays share server authority.
local Rep=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Analytics=game:GetService("AnalyticsService")
local Shared=Rep:WaitForChild("RiftShared")
local Config,Rules=require(Shared.Config),require(Shared.Rules)
local Launch={}
local callbacks,people,lessons=nil,{},{}
local funnel={"Joined","Queued","First Race","First Course","Escaped"}
local function live() return not Run:IsStudio() and game.GameId&gt;0 end
local function analytics(fn)
	if not live() then return end
	task.spawn(function()
		local ok=pcall(fn)
		if not ok then Rep:SetAttribute("AnalyticsDeliveryFailed",true) end
	end)
end
local function fields(stage,reason)
	return {[Enum.AnalyticsCustomFieldKeys.CustomField01.Name]=Rep:GetAttribute("MapId") or "Lobby",
		[Enum.AnalyticsCustomFieldKeys.CustomField02.Name]=tostring(stage or 0),
		[Enum.AnalyticsCustomFieldKeys.CustomField03.Name]=reason or ""}
end
local function reach(player,step)
	local person=people[player]
	if not person or step&lt;=person.funnel then return end
	for index=person.funnel+1,step do
		analytics(function() Analytics:LogOnboardingFunnelStepEvent(player,index,funnel[index]) end)
	end
	person.funnel=step
	player:SetAttribute("LaunchFunnelStep",step)
end
function Launch.init(handlers) callbacks=handlers end
local function daily(profile)
	local day=math.floor(os.time()/86400)
	if not profile.Daily or profile.Daily.day~=day then profile.Daily={day=day,progress={},claimed={}} end
	return profile.Daily,Rules.dailyChallenges(day)
end
function Launch.sync(player)
	local profile=callbacks.profile(player)
	if not profile then return end
	local state,goals=daily(profile)
	player:SetAttribute("ChallengesResetAt",(state.day+1)*86400)
	for index,goal in ipairs(goals) do
		player:SetAttribute("GoalText"..index,goal.text)
		player:SetAttribute("GoalProgress"..index,state.progress[goal.id] or 0)
		player:SetAttribute("GoalTarget"..index,goal.target)
		player:SetAttribute("GoalReward"..index,goal.coins)
		player:SetAttribute("GoalDone"..index,state.claimed[goal.id]==true)
	end
	player:SetAttribute("TutorialSeen",profile.TutorialSeen==true)
	player:SetAttribute("TutorialCompleted",profile.TutorialCompleted==true)
	player:SetAttribute("ParkourFinishes",profile.ParkourFinishes or 0)
	if (profile.ParkourBestMs or 0)&gt;0 then player:SetAttribute("ParkourBest",profile.ParkourBestMs/1000) end
	player:SetAttribute("HasParkourGhost",profile.ParkourGhost~=nil)
end
function Launch.attach(player)
	people[player]={joined=os.clock(),funnel=0,stage=0,events=0,failures=0}
	Launch.sync(player) reach(player,1)
	if callbacks.canStart(player) then reach(player,2) end
end
function Launch.event(player,event,stage)
	local person=people[player]
	local profile=callbacks.profile(player)
	if not person or not profile then return end
	person.stage=stage or person.stage
	if event=="start" then reach(player,3)
	elseif event=="finish" and stage==1 then reach(player,4)
	elseif event=="complete" then reach(player,5) end
	if event=="fall" or event=="catch" then
		person.failures+=1
		if person.failures&lt;=30 then analytics(function() Analytics:LogCustomEvent(player,"RiftFailure",1,fields(stage,event)) end) end
	elseif event=="finish" or event=="complete" then
		person.events+=1
		if person.events&lt;=60 then analytics(function() Analytics:LogCustomEvent(player,"RiftProgress",1,fields(stage,event)) end) end
	end
	local state,goals=daily(profile)
	local changed=false
	for _,goal in ipairs(goals) do
		if goal.event==event and not state.claimed[goal.id] then
			state.progress[goal.id]=math.min(goal.target,(state.progress[goal.id] or 0)+1)
			if state.progress[goal.id]==goal.target then
				state.claimed[goal.id]=true
				profile.Coins=math.min(1000000000,profile.Coins+goal.coins)
			end
			changed=true
		end
	end
	if changed then Launch.sync(player) callbacks.sync(player) end
end
function Launch.ghost(player)
	local profile=callbacks.profile(player)
	callbacks.send(player,"ParkourGhost",profile and profile.ParkourGhost or false)
end
function Launch.parkourFinish(player,seconds,frames,valid)
	local profile=callbacks.profile(player)
	if not profile or not valid or seconds&lt;15 or seconds&gt;3600 then return false end
	local ms=math.floor(seconds*1000+.5)
	profile.ParkourFinishes=(profile.ParkourFinishes or 0)+1
	if (profile.ParkourBestMs or 0)==0 or ms&lt;profile.ParkourBestMs then
		profile.ParkourBestMs=ms
		profile.ParkourGhost=Rules.sanitizeGhost({revision=1,durationMs=ms,frames=frames})
	end
	Launch.event(player,"parkour",0)
	Launch.sync(player) callbacks.sync(player) Launch.ghost(player)
	return true
end
function Launch.isLearning(player) return lessons[player]~=nil end
function Launch.cancel(player)
	lessons[player]=nil
	player:SetAttribute("TutorialActive",false)
	player:SetAttribute("TutorialStep",0)
	if callbacks then callbacks.leave(player) end
end
function Launch.start(player)
	if not callbacks.canStart(player) or lessons[player] then return false end
	local profile=callbacks.profile(player)
	if not profile then return false end
	profile.TutorialSeen=true
	callbacks.enter(player) callbacks.reset(player)
	callbacks.move(player,Vector3.new(-210,32,289),1)
	lessons[player]={step=1,last=Vector3.new(-210,32,289),sampleAt=os.clock(),sprintDistance=0}
	player:SetAttribute("TutorialActive",true) player:SetAttribute("TutorialStep",1)
	Launch.sync(player)
	return true
end
function Launch.skip(player)
	local profile=callbacks.profile(player)
	if not profile or not (callbacks.canStart(player) or lessons[player]) then return end
	profile.TutorialSeen=true
	if lessons[player] then Launch.cancel(player) callbacks.move(player,Vector3.new(0,32,224),-1) end
	Launch.sync(player)
end
function Launch.dash(player)
	local lesson=lessons[player]
	if not lesson then return end
	lesson.dashAt=os.clock()
	if lesson.step==3 and lesson.last.Z&gt;=356 and lesson.last.Z&lt;=394 then lesson.dashed=true end
end
function Launch.step(player,root,hum,sprinting,now)
	local lesson=lessons[player]
	if not lesson then
		local person=people[player]
		if person and now&gt;=(person.dailyAt or 0) then person.dailyAt=now+10 Launch.sync(player) end
		return false
	end
	local position=root.Position
	local delta=position-lesson.last
	local elapsed=math.clamp(now-lesson.sampleAt,.05,1)
	local dash=now-(lesson.dashAt or -100)&lt;.45
	if hum.Health&lt;=0 then Launch.cancel(player) return true end
	if Rules.lobbyZone(position.X,position.Y,position.Z)~="Tutorial" or position.Y&lt;27 or position.Y&gt;49
		or Vector3.new(delta.X,0,delta.Z).Magnitude&gt;(dash and 76 or 40)*elapsed+3 then
		local z=({289,326,359})[lesson.step]
		callbacks.reset(player) callbacks.move(player,Vector3.new(-210,32,z),1)
		lesson.last,lesson.sampleAt=Vector3.new(-210,32,z),now
		lesson.jumped,lesson.dashed,lesson.sprintDistance=false,false,0
		return true
	end
	if lesson.step==1 then
		if hum.FloorMaterial==Enum.Material.Air and position.Y&gt;33.5 and position.Z&gt;=299 and position.Z&lt;=316 then lesson.jumped=true end
		if lesson.jumped and position.Z&gt;=318 and hum.FloorMaterial~=Enum.Material.Air then lesson.step=2 end
	elseif lesson.step==2 then
		if sprinting then lesson.sprintDistance+=math.max(0,delta.Z) end
		if position.Z&gt;=351 and lesson.sprintDistance&gt;=18 then lesson.step=3
		elseif position.Z&gt;357 then callbacks.move(player,Vector3.new(-210,32,326),1) position=root.Position lesson.sprintDistance=0 end
	elseif position.Z&gt;=394 then
		if lesson.dashed then
			local profile=callbacks.profile(player)
			profile.TutorialCompleted=true
			Launch.cancel(player) callbacks.reset(player) callbacks.move(player,Vector3.new(0,32,224),-1)
			Launch.sync(player) callbacks.sync(player)
			analytics(function() Analytics:LogCustomEvent(player,"RiftTutorial",1) end)
			return true
		else callbacks.move(player,Vector3.new(-210,32,359),1) position=root.Position end
	end
	lesson.last,lesson.sampleAt=position,now
	player:SetAttribute("TutorialStep",lesson.step)
	return true
end
function Launch.leave(player)
	local person=people[player]
	if person then analytics(function() Analytics:LogCustomEvent(player,"RiftDeparture",math.min(7200,os.clock()-person.joined),fields(person.stage,"exit")) end) end
	lessons[player],people[player]=nil,nil
end
return Launch
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX006102">
      <Properties>
        <string name="Name">Game</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local Shared = ReplicatedStorage:WaitForChild("RiftShared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Profiles = require(script.Parent.ProfileStore)
local Passes = require(script.Parent.PassService)
local World = require(script.Parent.WorldService)
local Creature = require(script.Parent.CreatureRig)
local Captures = require(script.Parent.CaptureService)
local Styles = require(script.Parent.StyleService)
local Courses = require(script.Parent.CourseService)
local Metrics = require(script.Parent.PlaytestService)
local Navigation = require(script.Parent.CatcherNavigation)
local Mastery = require(script.Parent.MasteryService)
local Practice = require(script.Parent.PracticeService)
local Gear = require(script.Parent.VIPGearService)
local Launch = require(script.Parent.LaunchService)
local Remote = ReplicatedStorage:WaitForChild("RiftAction")
local Arena = workspace:WaitForChild("RiftArena")
Players.CharacterAutoLoads = false
pcall(function() PhysicsService:RegisterCollisionGroup("RiftCharacters") end)
PhysicsService:CollisionGroupSetCollidable("RiftCharacters", "RiftCharacters", false)

local sessions = {}
local bots = {}
local chaserRosterDirty = false
local phase, round, wave, direction, deadline = "Intermission", 0, 0, 1, 0
local practice = false
local quickRetry, retryRequested = false, false
local soloPaused = false
local rng = Random.new()
local lobbyPoint = Vector3.new(0, Config.LobbyFloorY + Config.FloorY, 224)
local function track(player,event,stage) Metrics.event(player,event,stage) Launch.event(player,event,stage) end

local function setCourse(player, stage)
	local state = sessions[player]
	state.stage = stage
	chaserRosterDirty = true
	Metrics.stage(player, stage)
	state.courseBegan = os.clock()
	state.masteryValid = true
	state.routeBoostUntil = 0
	player:SetAttribute("CourseStage", stage)
	player:SetAttribute("CourseStartedAt",workspace:GetServerTimeNow())
	local profile = Profiles.get(player)
	if profile then Mastery.reached(profile,stage) Mastery.sync(player,profile) end
	player:SetAttribute("DashStartedAt", 0)
	if player.Character then player.Character:SetAttribute("DashStartedAt", 0) end
end

local function coursePoint(stage, x, z)
	local course = Config.Courses[stage or 1]
	return Vector3.new(course.x + x, Config.FloorY, course.z + z)
end

local function catcherPoint(stage)
	local x,z=Rules.catcherStation(stage,rng:NextInteger(1,Config.Courses[stage].bots))
	return coursePoint(stage,x,z)
end

local function livingRoot(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health &gt; 0 then return root, humanoid end
	return nil, nil
end

local function syncProfile(player)
	local data = Profiles.get(player)
	if not data then return end
	for _, name in ipairs({ "Coins", "XP", "Wins", "Tags", "Crossings", "Equipped" }) do
		player:SetAttribute(name, data[name])
	end
	player:SetAttribute("Level", Rules.level(data.XP))
	Mastery.sync(player, data)
	local owned = {}
	for _, trail in ipairs(Config.Trails) do
		if Rules.trailAvailable(data, trail, Passes.entitlements(player)) then table.insert(owned, trail.id) end
		if trail.id == data.Equipped and trail.pass and not Passes.owns(player, trail.pass) then player:SetAttribute("Equipped", "None") end
	end
	player:SetAttribute("OwnedTrails", table.concat(owned, ","))
	Styles.sync(player, data, Passes.entitlements(player))
	local board = player:FindFirstChild("leaderstats")
	if board then
		board.Wins.Value = data.Wins
		board.Tags.Value = data.Tags
		board.Level.Value = Rules.level(data.XP)
	end
end

local function notify(player, message)
	if player.Parent then Remote:FireClient(player, "Notice", message) end
end

local function reward(player, coins, xp, stat)
	if practice and not Config.PracticeRewards then return end
	if practice and (stat == "Wins" or stat == "Tags") then return end
	local data = Profiles.get(player)
	if not data then return end
	if sessions[player] and sessions[player].training then return end
	local scale = practice and Config.PracticeRewardScale or 1
	data.Coins += Rules.rewardCoins(math.floor(coins*scale), practice and {} or Passes.entitlements(player))
	data.XP += math.floor(xp*scale)
	if stat then data[stat] += 1 end
	syncProfile(player)
end

local function appearance(player)
	local state = sessions[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not state or not root then return end
	local costume = Creature.apply(character, state.role == "Catcher")
	local profile = Profiles.get(player)
	if costume and profile then
		for _, definition in ipairs(Config.Cosmetics) do
			if definition.slot == "Skin" and definition.id == (profile.SkinEquipped or "DefaultSkin") and Rules.cosmeticAvailable(profile,definition,Passes.entitlements(player)) then Creature.skin(costume,definition.skin) end
		end
	end
	local old = character:FindFirstChild("RiftRole")
	if old then old:Destroy() end
	local highlight = Instance.new("Highlight")
	highlight.Name = "RiftRole"
	highlight.FillColor = state.role == "Catcher" and Color3.fromRGB(180, 105, 255) or Color3.fromRGB(100, 255, 201)
	highlight.FillTransparency = 0.94
	highlight.OutlineTransparency = state.role == "Spectator" and 1 or 0.25
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = character
	for _, name in ipairs({ "RiftTrail", "RiftTrailTop", "RiftTrailBottom" }) do
		local item = root:FindFirstChild(name)
		if item then item:Destroy() end
	end
	Styles.apply(player, profile, Passes.entitlements(player), state.role)
	if profile then
		for _, trail in ipairs(Config.Trails) do
			if trail.id == profile.Equipped and trail.id ~= "None" and Rules.trailAvailable(profile,trail,Passes.entitlements(player)) then
				local top = Instance.new("Attachment")
				top.Name, top.Position, top.Parent = "RiftTrailTop", Vector3.new(0, 1, 0.8), root
				local bottom = Instance.new("Attachment")
				bottom.Name, bottom.Position, bottom.Parent = "RiftTrailBottom", Vector3.new(0, -1, 0.8), root
				local effect = Instance.new("Trail")
				effect.Name = "RiftTrail"
				effect.Attachment0, effect.Attachment1 = top, bottom
				effect.Color = ColorSequence.new(Color3.fromRGB(unpack(trail.rgb)))
				if trail.colors then
					local keys = {}
					for index, rgb in ipairs(trail.colors) do table.insert(keys, ColorSequenceKeypoint.new((index - 1) / (#trail.colors - 1), Color3.fromRGB(unpack(rgb)))) end
					effect.Color = ColorSequence.new(keys)
					effect:SetAttribute("PaletteId", trail.id)
				end
				effect.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
				effect.Lifetime, effect.MinLength, effect.LightEmission = 0.28, 0.15, 0.7
				effect.Parent = root
			end
		end
	end
	local oldBadge = character:FindFirstChild("RiftVIP")
	if oldBadge then oldBadge:Destroy() end
	if Passes.owns(player, "VIP") then
		local badge = Instance.new("BillboardGui")
		badge.Name, badge.Adornee, badge.Size = "RiftVIP", character:FindFirstChild("Head") or root, UDim2.fromOffset(180, 24)
		badge.StudsOffset, badge.MaxDistance, badge.AlwaysOnTop = Vector3.new(0, 3, 0), 70, false
		local text = Instance.new("TextLabel")
		text.Size, text.BackgroundTransparency, text.Text = UDim2.fromScale(1, 1), 1, "VIP  |  " .. player.DisplayName
		text.Font, text.TextSize, text.TextColor3 = Enum.Font.GothamBold, 12, Color3.fromRGB(255, 210, 105)
		text.TextStrokeTransparency, text.Parent = 0.5, badge
		badge.Parent = character
	end
end

local function setRole(player, role)
	local state = sessions[player]
	if not state then return end
	state.role = role
	state.sprinting = false
	player:SetAttribute("Role", role)
	player:SetAttribute("DashStartedAt", 0)
	if player.Character then player.Character:SetAttribute("DashStartedAt", 0) end
	Remote:FireAllClients("DashCancel", player)
	appearance(player)
end

local function teleport(player, position, faceDirection)
	local root, humanoid = livingRoot(player)
	local state = sessions[player]
	if root and state then
		-- Release a garden seat before moving the character into a match.
		if humanoid.Sit then
			local seat = humanoid.SeatPart
			local weld = seat and seat:FindFirstChild("SeatWeld")
			if weld and weld:IsA("Weld") and weld.Part1 and weld.Part1:IsDescendantOf(player.Character) then weld:Destroy() end
			humanoid.Sit = false
		end
		player:SetAttribute("DashStartedAt", 0)
		if player.Character then player.Character:SetAttribute("DashStartedAt", 0) end
		Remote:FireAllClients("DashCancel", player)
		Remote:FireClient(player, "DashStop")
		root.CFrame = CFrame.lookAt(position, position + Vector3.new(0, 0, faceDirection or 1))
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		state.lastPosition = position
		state.sampleAt = os.clock()
		state.movementCredit = 8
		state.graceUntil = os.clock() + Config.PortalGrace
		player:SetAttribute("SafeUntil", workspace:GetServerTimeNow()+Config.PortalGrace)
	end
end

local function resetStamina(player)
	local state = sessions[player]
	state.stamina = Config.StaminaMax
	state.lastDash = -100
	state.lastExertion = -100
	state.exhausted = false
	state.routeBoostUntil = 0
	player:SetAttribute("RouteBoost",false)
	state.crystals, state.crystalCount = {}, 0
	state.staminaPadAt, state.dashPadAt = -100, -100
	state.bonusCrystals = 0
	player:SetAttribute("Stamina", Config.StaminaMax)
	player:SetAttribute("DashReadyAt", 0)
	player:SetAttribute("StaminaBuffReadyAt",0)
	player:SetAttribute("DashBuffReadyAt",0)
end

Passes.init(function(player) syncProfile(player) appearance(player) end, notify)
local function inLobby(player)
	local state = sessions[player]
	return state and not state.training and not state.tutorial and state.ready and (not state.inMatch or state.role == "Escaped")
end
Gear.init({owns=Passes.owns,inLobby=inLobby,creature=function(name)
	local model=Creature.create(name)
	Creature.track(model)
	return model
end,shot=function(from,to) Remote:FireAllClients("VIPShot",{from=from,to=to}) end})
local function visitLounge(player)
	if not inLobby(player) or not livingRoot(player) then return end
	if Passes.owns(player, "VIP") then
		teleport(player, Vector3.new(101, Config.LobbyFloorY + Config.FloorY, 224), -1)
	else
		Remote:FireClient(player, "OpenPasses")
	end
end
World.init({
	inLobby = inLobby,
	openMastery = function(player) Remote:FireClient(player,"OpenMastery") end,
	openShop = function(player) Remote:FireClient(player, "OpenPasses") end,
	openStyles = function(player) Remote:FireClient(player, "OpenCosmetics") end,
	lounge = visitLounge,
	returnLobby = function(player) teleport(player, lobbyPoint, -1) end,
	moveLobby = function(player, position) teleport(player, position, -1) end,
	isVIP = function(player) return Passes.owns(player, "VIP") end,
	notice = notify,
	celebrate = function(position) Remote:FireAllClients("Confetti", position) end,
	tutorial = function(player) Launch.start(player) end,
	parkourBegin = function(player) Launch.ghost(player) end,
	parkourFinish = function(player,seconds,frames,valid) Launch.parkourFinish(player,seconds,frames,valid) end,
})
Launch.init({profile=Profiles.get,sync=syncProfile,send=function(player,action,data) Remote:FireClient(player,action,data) end,
	canStart=function(player) return inLobby(player) and livingRoot(player)~=nil end,
	enter=function(player)
		local state=sessions[player] state.tutorial=true state.inMatch=false
		World.resetParkour(player) Gear.remove(player) setRole(player,"Spectator")
	end,
	leave=function(player) local state=sessions[player] if state then state.tutorial=false end end,
	reset=resetStamina,move=teleport})
Courses.activate(ReplicatedStorage:GetAttribute("MapId"))

Practice.init({
	profile = Profiles.get,
	canStart = function(player)
		local state = sessions[player]
		return state and state.ready and not state.inMatch and livingRoot(player) ~= nil
	end,
	reset = resetStamina, move = teleport,
	enter = function(player)
		sessions[player].training = true
		sessions[player].browsingMastery = false
		sessions[player].completed = false
		World.resetParkour(player)
		setRole(player,"Trainee")
	end,
	leave = function(player)
		local state = sessions[player]
		if not state then return end
		state.training = false
		setRole(player,"Spectator")
		resetStamina(player)
		teleport(player,lobbyPoint,-1)
	end,
	finished = function(player,mapId,stage,elapsed)
		local profile = Profiles.get(player)
		if not profile then return end
		local card = Mastery.finish(player,profile,mapId,stage,elapsed,true)
		if card then Remote:FireClient(player,"MasteryResult",card) end
	end,
})

local function resourcePickup(player,state,interaction,now)
	if interaction.kind == "Stamina" and now-state.staminaPadAt &gt;= Config.PadCooldown and state.stamina &lt; 85 then
		state.staminaPadAt,state.stamina = now,math.min(Config.StaminaMax,state.stamina+Config.PadRecharge)
		player:SetAttribute("StaminaBuffReadyAt",workspace:GetServerTimeNow()+Config.PadCooldown)
		state.exhausted = false
		Remote:FireClient(player,"Recharge",interaction.part.Position,"Stamina")
		notify(player,"Energy!")
		return true
	elseif interaction.kind == "Dash" and now-state.dashPadAt &gt;= Config.PadCooldown and now-state.lastDash &lt; Config.DashCooldown then
		state.dashPadAt,state.lastDash = now,now-Config.DashCooldown
		player:SetAttribute("DashBuffReadyAt",workspace:GetServerTimeNow()+Config.PadCooldown)
		player:SetAttribute("DashReadyAt",workspace:GetServerTimeNow())
		Remote:FireClient(player,"Recharge",interaction.part.Position,"Dash")
		notify(player,"Dash Ready!")
		return true
	end
	return false
end

local function victory(player,position)
	local profile, effect = Profiles.get(player), "Confetti"
	if profile then
		for _, definition in ipairs(Config.Cosmetics) do
			if definition.slot == "Victory" and definition.id == profile.VictoryEquipped and Rules.cosmeticAvailable(profile,definition,Passes.entitlements(player)) then effect = definition.effect end
		end
	end
	Remote:FireAllClients("Victory",{player=player,position=position,effect=effect})
end

local function aliveRunners()
	local result = {}
	for player, state in pairs(sessions) do
		if not state.training and (state.completed or (state.inMatch and (state.role == "Runner" or state.role == "Escaped"))) and player.Parent then
			table.insert(result, player)
		end
	end
	return result
end

local function broadcast(nextPhase, seconds, message)
	phase = nextPhase
	deadline = workspace:GetServerTimeNow() + seconds
	for name, value in pairs({ Phase = phase, Round = round, Wave = wave, Direction = direction,
		Deadline = deadline, Message = message, Practice = practice }) do
		ReplicatedStorage:SetAttribute(name, value)
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { Arena }
rayParams.RespectCanCollide = true

local function clearLine(from, to)
	return workspace:Raycast(from, to - from, rayParams) == nil
end

local function tag(player, attacker)
	local state = sessions[player]
	if not state or state.role ~= "Runner" or phase ~= "Crossing" then return end
	setRole(player, "Catcher")
	state.graceUntil = os.clock() + Config.TagGrace
	if attacker then reward(attacker, Config.TagCoins, Config.TagXP, "Tags") end
	notify(player, "Catch the runners!")
end

Captures.init({
	dodged = function(player)
		local state = sessions[player]
		if not state or state.role ~= "Runner" then return end
		state.graceUntil = os.clock()+Config.MissRecovery
		track(player, "dodge", state.stage)
		notify(player, "Nice Dodge!")
	end,
	canLunge = function(from, to)
		local stage = Rules.courseAt(from.X, from.Z, Config.Courses, Config.StartZ)
		return stage and Rules.inCourse(to.X, to.Z, Config.Courses[stage], Config.StartZ, 0) and Navigation.safeSegment(from, to)
	end,
	valid = function(player, actorRoot, actorPlayer)
		local state = sessions[player]
		local root = livingRoot(player)
		if not state or not root or not state.inMatch or phase ~= "Crossing" then return end
		if not actorPlayer then
			local humanoid = actorRoot.Parent:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.FloorMaterial == Enum.Material.Air or workspace:GetServerTimeNow() &lt; (actorRoot.Parent:GetAttribute("NavigationRecoverUntil") or 0) then return end
		end
		if actorPlayer then
			local actor = sessions[actorPlayer]
			if not actor or not actor.inMatch or actor.role ~= "Catcher" or actor.stage ~= state.stage then return end
		end
		if Rules.courseAt(actorRoot.Position.X, actorRoot.Position.Z, Config.Courses, Config.StartZ) ~= state.stage then return end
		local delta = actorRoot.CFrame:PointToObjectSpace(root.Position)
		if Rules.canGrab(state.role, phase, delta.X, delta.Y, delta.Z, os.clock(), state.graceUntil, actorRoot.Parent:GetAttribute("Archetype")) and clearLine(actorRoot.Position, root.Position) then return root end
	end,
	started = function(player, attacker)
		track(player, "catch", sessions[player].stage)
		setRole(player, "Captured")
		if attacker then reward(attacker, Config.TagCoins, Config.TagXP, "Tags") end
		notify(player, "Gotcha!")
	end,
	finished = function(player)
		local state = sessions[player]
		if not state or not player.Parent then return end
		-- A dodged, unconfirmed reach leaves the runner in the chase.
		if state.role ~= "Captured" then return end
		setRole(player, state.inMatch and "Catcher" or "Spectator")
		if state.inMatch then teleport(player, catcherPoint(state.stage), -1)
		else teleport(player, lobbyPoint, -1) end
		state.graceUntil = os.clock() + Config.TagGrace + .7
		if state.inMatch then notify(player, "Catch the runners!") end
	end,
})

local function createBot(index, stage)
	local model = Creature.create("Rift Stalker " .. stage .. "/" .. index, false)
	local root = model.PrimaryPart
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local kind = Rules.botKind(stage, index)
	Creature.variant(model, kind)
	model.Parent = workspace
	local x,z=Rules.catcherStation(stage,index)
	local spawn=coursePoint(stage,x,z)
	model:PivotTo(CFrame.lookAt(spawn, spawn+Vector3.new(0, 0, -1)))
	root:SetNetworkOwner(nil)
	Creature.track(model)
	humanoid.WalkSpeed, humanoid.JumpPower, humanoid.UseJumpPower = Rules.botSpeed(kind, stage), 45, true
	model:SetAttribute("CourseStage", stage)
	local bot = { index = index, stage = stage, kind = kind, model = model, root = root, humanoid = humanoid, nextCharge = 0, spawnPoint = spawn }
	Navigation.reset(bot, os.clock())
	return bot
end

local function reconcileChasers()
	local counts, current, occupied = {}, {}, {}
	for _, state in pairs(sessions) do
		if state.inMatch and (state.role == "Runner" or state.role == "Captured") then counts[state.stage] = (counts[state.stage] or 0) + 1 end
	end
	local allocation = Rules.chaserAllocation(counts, Config.Courses, Config.MaxActiveBots)
	for index = #bots, 1, -1 do
		local bot = bots[index]
		current[bot.stage] = (current[bot.stage] or 0) + 1
		if current[bot.stage] &gt; allocation[bot.stage] and not Captures.busy(bot.root) then
			current[bot.stage] -= 1
			Navigation.remove(bot)
			bot.model:Destroy()
			table.remove(bots, index)
		end
	end
	for _, bot in ipairs(bots) do occupied[bot.stage] = occupied[bot.stage] or {} occupied[bot.stage][bot.index] = true end
	for stage, wanted in ipairs(allocation) do
		local missing = wanted-(current[stage] or 0)
		for index = 1, Config.Courses[stage].bots do
			if missing &gt; 0 and not (occupied[stage] and occupied[stage][index]) then table.insert(bots, createBot(index, stage)) missing -= 1 end
		end
		ReplicatedStorage:SetAttribute("Chasers_" .. stage, wanted)
	end
	-- Human catchers follow the surviving pack when their section empties.
	local front
	for stage = #Config.Courses, 1, -1 do if (counts[stage] or 0) &gt; 0 then front = stage break end end
	if front then
		for player, state in pairs(sessions) do
			local root = livingRoot(player)
			if state.inMatch and state.role == "Catcher" and (counts[state.stage] or 0) == 0 and root and not Captures.busy(root) then
				setCourse(player, front)
				resetStamina(player)
				teleport(player, catcherPoint(front), -1)
				notify(player, "Next Course!")
			end
		end
	end
end

local function clearBots()
	Captures.cancelAll()
	for _, bot in ipairs(bots) do Navigation.remove(bot) bot.model:Destroy() end
	bots = {}
end

local function closestRunner(bot)
	local target, nearest, targetGrace = nil, math.huge, 0
	for player, state in pairs(sessions) do
		if state.role == "Runner" and state.inMatch and state.stage == bot.stage then
			local root = livingRoot(player)
			if root then
				local dist = (root.Position - bot.root.Position).Magnitude
				if dist &lt; nearest then target, nearest, targetGrace = root, dist, state.graceUntil end
			end
		end
	end
	return target, targetGrace
end

local function stepBot(bot, now)
	if not bot.model.Parent then return end
	if bot.root.Position.Y &lt; -8 or not Rules.inCourse(bot.root.Position.X, bot.root.Position.Z, Config.Courses[bot.stage], Config.StartZ, 2) then
		Captures.cancelActor(bot.root)
		Navigation.recover(bot, now)
		return
	end
	if Captures.busy(bot.root) and not Captures.winding(bot.root) then Navigation.idle(bot, now) return end
	if Captures.winding(bot.root) and bot.chargeAt then bot.chargeAt = nil bot.model:SetAttribute("ChargeStage", nil) end
	if Captures.recovering(bot.root) then bot.humanoid.WalkSpeed = 0 Navigation.idle(bot, now) return end
	bot.humanoid.WalkSpeed = Rules.botSpeed(bot.kind, bot.stage)
	Courses.contact(bot.root.Position, bot.stage, bot.humanoid.FloorMaterial ~= Enum.Material.Air, now)
	local target, targetGrace = closestRunner(bot)
	if not target then Navigation.idle(bot, now) return end
	-- Pursue on arrival. Protection gates grabs and charges, never movement.
	local delta = target.Position - bot.root.Position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if bot.chargeAt then
		local age = now-bot.chargeAt
		if age &lt; Config.ChargeWindup then
			bot.humanoid.WalkSpeed = 0 bot.humanoid:Move(Vector3.zero) return
		elseif age &lt; Config.ChargeWindup+Config.ChargeDuration then
			if not Navigation.safeSegment(bot.root.Position, bot.root.Position+bot.chargeDirection*9) then
				bot.chargeAt, bot.recoverAt = nil, now+1.1
				bot.model:SetAttribute("ChargeStage", nil)
				bot.model:SetAttribute("RecoverUntil", workspace:GetServerTimeNow()+1.1)
				Navigation.reset(bot, now+.5)
				bot.humanoid:Move(Vector3.zero)
				return
			end
			bot.model:SetAttribute("ChargeStage", "Charge")
			bot.humanoid.WalkSpeed = 41
			bot.humanoid:Move(bot.chargeDirection)
			return
		else
			bot.chargeAt, bot.recoverAt = nil, now+1.1
			bot.model:SetAttribute("ChargeStage", nil)
			bot.model:SetAttribute("RecoverUntil", workspace:GetServerTimeNow()+1.1)
		end
	end
	if now &lt; (bot.recoverAt or 0) then bot.humanoid.WalkSpeed = 0 bot.humanoid:Move(Vector3.zero) return end
	if not Captures.winding(bot.root) and bot.kind == "Stalker" and bot.humanoid.FloorMaterial ~= Enum.Material.Air
		and now &gt;= targetGrace and now &gt;= bot.nextCharge and flat.Magnitude &gt; 9 and flat.Magnitude &lt; 24 and math.abs(delta.Y) &lt; 3
		and Navigation.safeSegment(bot.root.Position, bot.root.Position+flat.Unit*(41*Config.ChargeDuration+3)) then
		Navigation.reset(bot, now+Config.ChargeWindup+Config.ChargeDuration)
		bot.chargeAt, bot.nextCharge, bot.chargeDirection = now, now+Config.ChargeCooldown, flat.Unit
		bot.root.CFrame = CFrame.lookAt(bot.root.Position, bot.root.Position+flat.Unit)
		bot.model:SetAttribute("ChargeStage", "Warning")
		Remote:FireAllClients("ChargeWarning", { model = bot.model, duration = Config.ChargeWindup })
		bot.humanoid.WalkSpeed = 0 bot.humanoid:Move(Vector3.zero)
		return
	end
	Navigation.follow(bot, target, now)
end

local function applyParkourRetry(player,state)
	if not state.pendingParkourRetry then return end
	if not World.canRetryParkour(player) then
		state.pendingParkourRetry=nil
		player:SetAttribute("ParkourRetryPending",false)
		return
	end
	if state.ready and not state.spawning and state.clientReadyCharacter==player.Character then
		local root=livingRoot(player)
		local character=player.Character
		-- Hold authority while the new character accepts its first spawn pose.
		if root then root:SetNetworkOwner(nil) end
		if World.retryParkour(player) then
			state.pendingParkourRetry=nil
			player:SetAttribute("ParkourRetryPending",false)
		end
		if root then task.delay(.3,function()
			if player.Parent and player.Character==character and root.Parent then root:SetNetworkOwner(player) end
		end) end
	end
end

local function loadCharacter(player)
	local state=sessions[player]
	if not state then return end
	state.spawning=true
	state.clientReadyCharacter=nil
	local ok=pcall(function() player:LoadCharacterAsync() end)
	state.spawning=false
	if sessions[player]~=state then return end
	if ok then applyParkourRetry(player,state) end
end

local function characterAdded(player, character)
	local state = sessions[player]
	if not state then return end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not root or not humanoid or not player.Parent then return end
	if state.training then Practice.leave(player) end
	local function prepare(item)
		if item:IsA("BasePart") then item.CollisionGroup = "RiftCharacters" end
	end
	for _, item in ipairs(character:GetDescendants()) do prepare(item) end
	character.DescendantAdded:Connect(prepare)
	humanoid.JumpPower, humanoid.UseJumpPower = 45, true
	state.ready = true
	if state.inMatch and state.role == "Catcher" and (phase == "Crossing" or phase == "Ready") then
		teleport(player, catcherPoint(state.stage), -1)
	else
		state.inMatch = false
		setRole(player, "Spectator")
		player:SetAttribute("CourseStage", 0)
		Metrics.stage(player, 0)
		teleport(player, lobbyPoint + Vector3.new(rng:NextNumber(-12, 12), 0, 0), -1)
	end
	appearance(player)
	humanoid.Died:Connect(function()
		Launch.cancel(player)
		World.failParkour(player)
		Gear.remove(player)
		state.ready = false
		if state.inMatch and state.role == "Runner" then setRole(player, "Catcher") end
		if state.role == "Escaped" then state.inMatch = false setRole(player, "Spectator") end
		task.delay(2, function()
			if player.Parent then
				loadCharacter(player)
			end
		end)
	end)
end

local function playerAdded(player)
	if sessions[player] then return end
	local state = { role = "Spectator", stage = 1, inMatch = false, ready = false, stamina = 100, sprinting = false,
		lastDash = -100, lastExertion = -100, graceUntil = 0, catcherTurns = 0, rateTokens = 12,
		rateAt = os.clock(), purchaseAt = -100, lastPosition = nil, sampleAt = os.clock(), exhausted = false, movementCredit = 8 }
	sessions[player] = state
	Metrics.join(player)
	player:SetAttribute("Role", "Spectator")
	player:SetAttribute("Stamina", 100)
	player:SetAttribute("DashReadyAt", 0)
	player:SetAttribute("CourseStage", 0)
	player:SetAttribute("DashStartedAt", 0)
	player:SetAttribute("SoloPaused", false)
	player:SetAttribute("CoursePractice",false)
	player:SetAttribute("PracticeOffsetY",0)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name, leaderstats.Parent = "leaderstats", player
	for _, name in ipairs({ "Wins", "Tags", "Level" }) do
		local value = Instance.new("IntValue")
		value.Name, value.Parent = name, leaderstats
	end
	player.CharacterAdded:Connect(function(character) characterAdded(player, character) end)
	Profiles.load(player)
	if not player.Parent then Profiles.save(player, true) return end
	Passes.load(player)
	syncProfile(player)
	loadCharacter(player)
	Launch.attach(player)
end

Players.PlayerAdded:Connect(playerAdded)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(playerAdded, player) end
Players.PlayerRemoving:Connect(function(player)
	soloPaused, quickRetry = false, false
	for other in pairs(sessions) do other:SetAttribute("SoloPaused", false) end
	Metrics.leave(player)
	Launch.leave(player)
	Captures.remove(player)
	Practice.leave(player,true)
	sessions[player] = nil
	Passes.remove(player)
	Gear.remove(player)
	World.remove(player)
	Profiles.save(player, true)
end)

Remote.OnServerEvent:Connect(function(player, action, payload)
	local state = sessions[player]
	if not state or type(action) ~= "string" then return end
	local now = os.clock()
	state.rateTokens = math.min(12, state.rateTokens + (now - state.rateAt) * 8)
	state.rateAt = now
	if state.rateTokens &lt; 1 then return end
	state.rateTokens -= 1
	if action == "Playtest" then Metrics.sample(player, payload) return end
	if action == "CharacterReady" then
		if payload==player.Character then state.clientReadyCharacter=payload applyParkourRetry(player,state) end
		return
	end
	if action=="TutorialStart" then Launch.start(player) return end
	if action=="TutorialSkip" then Launch.skip(player) return end
	if action=="JourneyReady" then
		if now-(state.journeyRequestAt or -100)&gt;.75 then state.journeyRequestAt=now Launch.sync(player) Launch.ghost(player) end
		return
	end
	if action == "MasteryMenu" and type(payload) == "boolean" then
		if not state.inMatch then
			state.browsingMastery = payload
			if payload and #Players:GetPlayers() == 1 then
				soloPaused,quickRetry = true,false
				player:SetAttribute("SoloPaused",true)
			end
		end
		return
	end
	if action == "PracticeCourse" then
		if type(payload) ~= "table" or type(payload.mapId) ~= "string" then return end
		if now-(state.practiceRequestAt or -100) &lt; .75 then return end
		state.practiceRequestAt = now
		if not Practice.start(player,payload.mapId,payload.stage) then notify(player,"Reach this course in a run first!") end
		return
	end
	if action == "PracticeRetry" then
		if now-(state.practiceRequestAt or -100) &gt;= .3 then state.practiceRequestAt = now Practice.restart(player) end
		return
	end
	if action == "PracticeLeave" then Practice.leave(player) return end
	if action == "Retry" then
		if #Players:GetPlayers() == 1 and (phase == "Results" or (phase == "Intermission" and soloPaused)) then
			soloPaused, retryRequested = false, true
			player:SetAttribute("SoloPaused", false)
		end
		return
	end
	if action == "PauseSolo" then
		if #Players:GetPlayers() == 1 and (phase == "Results" or (phase == "Crossing" and state.role == "Escaped")) then
			soloPaused, quickRetry = true, false
			player:SetAttribute("SoloPaused", true)
		end
		return
	end
	if action == "Vote" then World.voteOnPlate(player, payload) return end
	if action == "RefreshPasses" then Passes.refresh(player) return end
	if action == "VIPFire" then Gear.fire(player,payload,now) return end
	if action == "ParkourRetry" then
		if state.training or (state.inMatch and state.role~="Escaped") or not World.canRetryParkour(player) then return end
		state.pendingParkourRetry=true
		player:SetAttribute("ParkourRetryPending",true)
		applyParkourRetry(player,state)
		return
	end
	if action == "VisitVIP" then
		if now-(state.loungeRequestAt or -100) &gt;= .75 then
			state.loungeRequestAt = now
			visitLounge(player)
		end
		return
	end
	if action == "Trail" or action == "Cosmetic" then
		if type(payload) ~= "string" or #payload &gt; 20 or now - state.purchaseAt &lt; 0.5 then return end
		state.purchaseAt = now
		if phase ~= "Intermission" and phase ~= "Results" and state.inMatch and state.role ~= "Escaped" then
			notify(player, "Customize your style between matches.") return
		end
		local profile = Profiles.get(player)
		if not profile then return end
		if action == "Cosmetic" then
			for _, definition in ipairs(Config.Cosmetics) do
				if definition.id == payload then
					local ok, message = Rules.purchaseCosmetic(profile, definition, Passes.entitlements(player))
					notify(player, message)
					if ok then syncProfile(player) appearance(player) end
					return
				end
			end
			return
		end
		for _, trail in ipairs(Config.Trails) do
			if trail.id == payload then
				local ok, message = Rules.purchase(profile, trail, Passes.entitlements(player))
				notify(player, message)
				if ok then syncProfile(player) appearance(player) end
				return
			end
		end
		return
	end
	if action == "Sprint" and type(payload) == "boolean" then state.sprinting = payload return end
	local training = Practice.get(player)
	local trainingActive = state.tutorial or (training and not training.finished and workspace:GetServerTimeNow() &gt;= training.started)
	if action ~= "Dash" or not (trainingActive or (phase == "Crossing" and state.inMatch and (state.role == "Runner" or state.role == "Catcher"))) then return end
	if typeof(payload) ~= "Vector3" then return end
	if payload.X ~= payload.X or payload.Z ~= payload.Z or math.abs(payload.X) &gt; 1.1 or math.abs(payload.Z) &gt; 1.1 then return end
	local move = Vector3.new(payload.X, 0, payload.Z)
	if move.Magnitude &lt; 0.1 then return end
	if not Rules.canDash(state.stamina, now, state.lastDash, Config.DashCost, Config.DashCooldown) then return end
	local root = livingRoot(player)
	if not root then return end
	if Captures.busy(root) or Captures.isVictim(player) then return end
	state.stamina -= Config.DashCost
	state.lastDash, state.lastExertion = now, now
	-- Confirm the dodge on the server before the next capture recheck. The
	-- client's visible dash can precede its replicated position update.
	if state.role == "Runner" then
		state.graceUntil = math.max(state.graceUntil,now+Config.DashDodgeSeconds)
		Captures.evade(player)
	end
	player:SetAttribute("DashLearned", true)
	if state.tutorial then Launch.dash(player) end
	if not state.training and not state.tutorial then track(player, "dash", state.stage) end
	root.AssemblyLinearVelocity = move.Unit * Config.DashSpeed + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
	player:SetAttribute("DashReadyAt", workspace:GetServerTimeNow() + Config.DashCooldown)
	local dashStarted = workspace:GetServerTimeNow()
	player:SetAttribute("DashStartedAt", dashStarted)
	player.Character:SetAttribute("DashStartedAt", dashStarted)
	Remote:FireClient(player, "Dash", move.Unit)
	Remote:FireAllClients("DashFX", { player = player, direction = move.Unit, started = dashStarted })
end)

local accumulated, nextChaserUpdate = 0, 0
RunService.Heartbeat:Connect(function(dt)
	accumulated += dt
	if accumulated &lt; 0.1 then return end
	local step = math.min(accumulated, 0.5)
	accumulated = 0
	local now = os.clock()
	Captures.step(workspace:GetServerTimeNow())
	Courses.step(now, phase == "Crossing")
	Practice.step(now)
	if phase == "Crossing" and (chaserRosterDirty or now &gt;= nextChaserUpdate) then
		chaserRosterDirty = false
		reconcileChasers()
		nextChaserUpdate = now + 1
	end
	for player, state in pairs(sessions) do
		local root, humanoid = livingRoot(player)
		if root and humanoid then
			local training = Practice.get(player)
			local lesson=state.tutorial==true
			if not training and ((state.role == "Spectator" and not state.inMatch) or state.role == "Escaped") then World.stepLobby(player, root, humanoid) end
			local gearSpeed,gearJump = Gear.update(player,humanoid)
			local busy = (Captures.busy(root) and not Captures.winding(root)) or Captures.isVictim(player)
			local trainingActive = lesson or (training and not training.finished and workspace:GetServerTimeNow() &gt;= training.started)
			local active = trainingActive or (phase == "Crossing" and state.inMatch and not busy and (state.role == "Runner" or state.role == "Catcher"))
			if state.exhausted and state.stamina &gt;= 22 then state.exhausted = false end
			local sprint = active and state.sprinting and humanoid.MoveDirection.Magnitude &gt; 0.05 and not state.exhausted and state.stamina &gt; 0
			if sprint then player:SetAttribute("SprintLearned", true) end
			local boostContact = active and (training and Practice.contact(player,root,humanoid,now) or (not training and Courses.contact(root.Position,state.stage,humanoid.FloorMaterial ~= Enum.Material.Air,now)))
			if boostContact then
				state.routeBoostUntil = now+Config.RouteBoostSeconds
			end
			local boostSpeed = active and now &lt; (state.routeBoostUntil or 0) and Config.RouteBoostSpeed or 0
			player:SetAttribute("RouteBoost", boostSpeed &gt; 0)
			state.stamina, state.lastExertion = Rules.stepStamina(state.stamina, sprint, step, now, state.lastExertion, Config)
			if state.stamina &lt;= 0 then state.exhausted = true end
			player:SetAttribute("Stamina", math.floor(state.stamina))
			local base = (state.role == "Catcher" and Config.CatcherSpeed or Config.WalkSpeed)+boostSpeed
			local fast = (state.role == "Catcher" and Config.CatcherSprintSpeed or Config.SprintSpeed)+boostSpeed
			local locked = (training and workspace:GetServerTimeNow() &lt; training.started) or (state.inMatch and (phase == "Ready" or busy))
			humanoid.WalkSpeed = locked and 0 or (gearSpeed or ((sprint and fast or base)*(Captures.recovering(root) and .35 or 1)))
			humanoid.JumpPower = locked and 0 or (gearJump or 45)
			if Launch.step(player,root,humanoid,sprint,now) then continue end
			if locked and not busy and state.lastPosition then
				local drift = root.Position - state.lastPosition
				if Vector3.new(drift.X, 0, drift.Z).Magnitude &gt; 1.5 then teleport(player, state.lastPosition, direction) end
				state.sampleAt = now
			end
			if training then
				local position = root.Position
				local delta = position-(state.lastPosition or position)
				local distance = Vector3.new(delta.X,0,delta.Z).Magnitude
				local elapsed = math.clamp(now-state.sampleAt,.1,2)
				local speed = now-state.lastDash &lt; Config.DashDuration+.2 and Config.DashSpeed+5 or ((sprint and fast or base)+3)
				local allowed = state.movementCredit+speed*elapsed
				local status = Practice.check(player,root,workspace:GetServerTimeNow(),distance &lt;= allowed)
				if status == "running" or status == "finished" then
					state.lastPosition,state.sampleAt,state.movementCredit = position,now,math.min(10,allowed-distance)
					if status == "running" then
						for _, pickup in ipairs(Practice.pickups(player)) do
							local gap = position-pickup.part.Position
							if Vector3.new(gap.X,0,gap.Z).Magnitude &lt;= 5.5 and math.abs(gap.Y) &lt;= 6 and Practice.clearLine(player,position,pickup.part.Position+Vector3.new(0,3,0)) then resourcePickup(player,state,pickup,now) end
						end
					end
				end
				continue
			end
			if active then
				local position = root.Position
				local course = Config.Courses[state.stage]
				local elapsed = math.clamp(now - state.sampleAt, 0.1, 2)
				local dash = now - state.lastDash &lt; Config.DashDuration + 0.2
				local allowedSpeed = dash and Config.DashSpeed + 5 or (sprint and fast or base) + 3
				local maxDistance = state.movementCredit + allowedSpeed * elapsed
				local previous = state.lastPosition or position
				local delta = position - previous
				local horizontalDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
				if position.Y &lt; -10 then
					track(player, "fall", state.stage)
					tag(player, nil)
					teleport(player, catcherPoint(state.stage), -1)
				elseif not Rules.inCourse(position.X, position.Z, course, Config.StartZ, 2) or horizontalDistance &gt; maxDistance then
					state.masteryValid = false
					teleport(player, previous, direction)
					state.movementCredit = 0
				elseif position.Y &gt; 38 then
					tag(player, nil)
					teleport(player, catcherPoint(state.stage), -1)
				else
					state.movementCredit = math.min(10, maxDistance - horizontalDistance)
					state.lastPosition, state.sampleAt = position, now
					local interactable = table.clone(World.getInteractions(state.stage))
					for _, interaction in ipairs(Courses.interactions(state.stage)) do table.insert(interactable, interaction) end
					for _, interaction in ipairs(interactable) do
						local deltaTo = position - interaction.part.Position
						if Rules.interactionAllowed(state.role, phase, state.inMatch, Vector3.new(deltaTo.X, 0, deltaTo.Z).Magnitude, math.abs(deltaTo.Y)) and clearLine(position, interaction.part.Position + Vector3.new(0, 3, 0)) then
							if resourcePickup(player,state,interaction,now) then
							elseif interaction.kind == "BonusCrystal" and state.role == "Runner" and state.bonusCrystals &lt; 2 and not state.crystals[interaction.part] then
								state.crystals[interaction.part], state.bonusCrystals = true, state.bonusCrystals+1
								reward(player, Config.CrystalCoins, Config.CrystalXP)
								Remote:FireClient(player, "Crystal", interaction.part)
								track(player,"crystal",state.stage)
								notify(player, "Shortcut Bonus!")
							elseif interaction.kind == "Crystal" and state.role == "Runner" and state.crystalCount &lt; Config.CrystalLimit and not state.crystals[interaction.part] then
								state.crystals[interaction.part], state.crystalCount = true, state.crystalCount + 1
								reward(player, Config.CrystalCoins, Config.CrystalXP)
								Remote:FireClient(player, "Crystal", interaction.part)
								track(player,"crystal",state.stage)
								notify(player, "+" .. Rules.rewardCoins(math.floor(Config.CrystalCoins*(practice and Config.PracticeRewardScale or 1)), practice and {} or Passes.entitlements(player)) .. " Coins")
							end
						end
					end
					local onward = Rules.courseFinish(state.role, phase, position.X, position.Z, state.stage, Config)
					if onward and now-state.courseBegan &gt;= Config.MinCourseSeconds then
						track(player, "finish", state.stage)
						local profile = Profiles.get(player)
						local card = profile and state.masteryValid and Mastery.finish(player,profile,ReplicatedStorage:GetAttribute("MapId"),state.stage,now-state.courseBegan,false)
						if card then Remote:FireClient(player,"MasteryResult",card) end
						local firstUnlock = profile and profile.Crossings &lt; 3
						reward(player, Config.CrossingCoins, Config.CrossingXP, "Crossings")
						if firstUnlock and profile.Crossings &gt;= 3 then
							if (profile.TitleEquipped or "NoTitle") == "NoTitle" then profile.TitleEquipped = "CrystalScout" syncProfile(player) appearance(player) end
							Remote:FireClient(player, "ScoutUnlocked")
						end
						if onward == 0 then
							state.completed = true
							track(player, "complete", state.stage)
							setRole(player, "Escaped")
							teleport(player, lobbyPoint, -1)
							notify(player, "You Made It!")
							victory(player,root.Position)
						else
							setCourse(player, onward)
							resetStamina(player)
							teleport(player, coursePoint(onward, 0, -Config.StartZ), 1)
							notify(player, "Next Course!")
							Remote:FireClient(player, "CourseClear", { stage = onward, position = root.Position })
						end
					end
				end
			end
		end
	end
	Gear.stepEnemies(now)
	if phase == "Ready" then
		for _,bot in ipairs(bots) do
			local target = closestRunner(bot)
			if target then Navigation.prime(bot, target, now) end
		end
	end
	if phase ~= "Crossing" then return end
	-- A portal finish changes the roster in this heartbeat, before NPC movement.
	if chaserRosterDirty then
		chaserRosterDirty = false
		reconcileChasers()
		nextChaserUpdate = now + 1
	end
	for _, bot in ipairs(bots) do stepBot(bot, now) end
	local attackers = {}
	for player, state in pairs(sessions) do
		if state.role == "Catcher" and state.inMatch and now &gt;= state.graceUntil then
			local root = livingRoot(player)
			if root and not Captures.busy(root) then table.insert(attackers, { stage = state.stage, root = root, player = player, model = player.Character:FindFirstChild("RiftCatcherCreature") }) end
		end
	end
	for _, bot in ipairs(bots) do if not Captures.busy(bot.root) and not Captures.recovering(bot.root) and bot.model:GetAttribute("ChargeStage") ~= "Warning" and now &gt;= (bot.recoverAt or 0) then table.insert(attackers, { stage = bot.stage, root = bot.root, model = bot.model }) end end
	for player, state in pairs(sessions) do
		if state.role == "Runner" and state.inMatch then
			local root = livingRoot(player)
			if root then
				for _, attacker in ipairs(attackers) do
					if attacker.stage ~= state.stage then continue end
					local delta = attacker.root.CFrame:PointToObjectSpace(root.Position)
					if Rules.canGrab(state.role, phase, delta.X, delta.Y, delta.Z, now, state.graceUntil, attacker.model and attacker.model:GetAttribute("Archetype"))
						and clearLine(attacker.root.Position, root.Position) then
						Captures.tryGrab(player, attacker.model, attacker.root, attacker.player)
						break
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.SaveInterval)
		for player in pairs(sessions) do task.spawn(Profiles.save, player, false) end
	end
end)

game:BindToClose(function()
	Metrics.report(ReplicatedStorage:GetAttribute("MapId"), round)
	local pending = 0
	for player in pairs(sessions) do
		pending += 1
		task.spawn(function() Profiles.save(player, true) pending -= 1 end)
	end
	local endAt = os.clock() + 25
	repeat task.wait(0.1) until pending == 0 or os.clock() &gt;= endAt
end)

local function waitPhase(seconds, stopWhenResolved)
	local untilTime = os.clock() + seconds
	repeat
		task.wait(0.2)
		if phase == "Results" and practice and retryRequested then return end
		if stopWhenResolved then
			local remaining = false
			for _, state in pairs(sessions) do
				if state.inMatch and (state.role == "Runner" or state.role == "Captured") then remaining = true break end
			end
			if not remaining then return end
		end
	until os.clock() &gt;= untilTime
	if stopWhenResolved then
		local settleUntil = os.clock() + Config.CaptureDuration + Config.GrabWindup + .5
		while Captures.hasActive() and os.clock() &lt; settleUntil do task.wait(.1) end
		if Captures.hasActive() then Captures.cancelAll() end
	end
end

while true do
	clearBots()
	practice = false
	retryRequested = false
	wave = 0
	for player, state in pairs(sessions) do
		if state.training or state.tutorial or state.browsingMastery or World.isParkouring(player) or Gear.inArena(player) then continue end
		state.inMatch = false
		state.completed = false
		setRole(player, "Spectator")
		setCourse(player, 1)
		player:SetAttribute("CourseStage", 0)
		Metrics.stage(player, 0)
		resetStamina(player)
		teleport(player, lobbyPoint + Vector3.new(rng:NextNumber(-15, 15), 0, 0), -1)
	end
	World.startVoting()
	broadcast("Intermission", Config.Intermission, "Choose your next run!")
	waitPhase(Config.Intermission, false)
	local participants = {}
	for player, state in pairs(sessions) do
		if state.ready and not state.spawning and not state.training and not state.tutorial and not state.browsingMastery
			and not World.isParkouring(player) and not Gear.inArena(player) and livingRoot(player)
			and not (soloPaused and #Players:GetPlayers() == 1) then table.insert(participants, player) end
	end
	if #participants == 0 then task.wait(1) continue end
	World.choose(rng:NextInteger(1, #Config.Maps))
	Courses.activate(ReplicatedStorage:GetAttribute("MapId"))
	round += 1
	practice = #participants == 1
	if not practice then soloPaused = false end
	direction = 1
	local candidates = {}
	for _, player in ipairs(participants) do
		World.resetParkour(player)
		local state = sessions[player]
		state.inMatch = true
		player:SetAttribute("SoloPaused", false)
		track(player, "start", 1)
		if quickRetry then track(player, "retry", 1) end
		setCourse(player, 1)
		setRole(player, "Runner")
		table.insert(candidates, { id = player, turns = state.catcherTurns })
	end
	if not practice then
		for _ = 1, Rules.initialCatcherCount(#participants, Config.PlayersPerCatcher) do
			local selected = Rules.selectCatcher(candidates, rng:NextInteger(1, #candidates))
			sessions[selected].catcherTurns += 1
			setRole(selected, "Catcher")
			for index, candidate in ipairs(candidates) do if candidate.id == selected then table.remove(candidates, index) break end end
		end
	end
	wave = 1
	local runners, index = aliveRunners(), 0
	for _, player in ipairs(participants) do
		local state = sessions[player]
		resetStamina(player)
		if state.role == "Runner" then
			index += 1
			local x = #runners == 1 and 0 or -60 + (index - 1) * 120 / math.max(1, #runners - 1)
			teleport(player, coursePoint(1, x, -Config.StartZ), 1)
		else teleport(player, catcherPoint(1), -1) end
	end
	reconcileChasers()
	for _, bot in ipairs(bots) do bot.humanoid.WalkSpeed = 0 end
	local readySeconds = Config.ReadySeconds
	broadcast("Ready", readySeconds, "Run to Finish!")
	waitPhase(readySeconds, false)
	for _, bot in ipairs(bots) do bot.humanoid.WalkSpeed = Rules.botSpeed(bot.kind, bot.stage) end
	-- Individual course transitions keep this single shared run clock ticking.
	broadcast("Crossing", Config.RunSeconds, "CLEAR FIVE RIFTS. OUTRUN THE HORDE.")
	for _, player in ipairs(participants) do
		sessions[player].courseBegan = os.clock()
		sessions[player].graceUntil = os.clock()+Config.PortalGrace
		player:SetAttribute("SafeUntil",workspace:GetServerTimeNow()+Config.PortalGrace)
		player:SetAttribute("CourseStartedAt",workspace:GetServerTimeNow())
	end
	waitPhase(Config.RunSeconds, true)
	phase = "Resolving"
	for player, state in pairs(sessions) do
		if state.inMatch and state.role == "Runner" then
			setRole(player, "Catcher")
			notify(player, "Time's Up!")
		end
	end
	local winners = aliveRunners()
	local winnerSet = {}
	for _, player in ipairs(winners) do
		winnerSet[player] = true
		reward(player, Config.WinCoins, Config.WinXP, not practice and "Wins" or nil)
	end
	local resultText = #winners &gt; 0 and (#winners .. " runner" .. (#winners == 1 and "" or "s") .. " survived the valley!") or "The catchers claimed the valley."
	if practice then
		resultText = #winners &gt; 0 and "Practice complete: all five courses cleared!" or "Practice ended: the catchers claimed the valley."
	end
	if #winners == 0 then
		for player, state in pairs(sessions) do
			if state.inMatch and state.role == "Catcher" then reward(player, Config.WinCoins, Config.WinXP, "Wins") end
		end
	end
	clearBots()
	quickRetry = practice and #Players:GetPlayers() == 1 and not soloPaused
	local resultsSeconds = quickRetry and Config.SoloRetrySeconds or Config.ResultsSeconds
	broadcast("Results", resultsSeconds, resultText)
	Metrics.report(ReplicatedStorage:GetAttribute("MapId"), round)
	for player, state in pairs(sessions) do
		if state.training or state.tutorial or World.isParkouring(player) or Gear.inArena(player) then
			state.inMatch=false state.completed=false
			continue
		end
		if state.inMatch then
			Remote:FireClient(player, "Results", { won = winnerSet[player] == true or (not practice and #winners == 0), message = resultText, practice = practice })
		end
		state.inMatch = false
		setRole(player, "Spectator")
		player:SetAttribute("CourseStage", 0)
		Metrics.stage(player, 0)
		teleport(player, lobbyPoint + Vector3.new(rng:NextNumber(-15, 15), 0, 0), -1)
	end
	waitPhase(resultsSeconds, false)
end
</ProtectedString>
        <bool name="Disabled">false</bool>
