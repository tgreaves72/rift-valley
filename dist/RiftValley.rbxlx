		{ id = "ValleyRoyalty", slot = "Title", name = "Valley Royalty", pass = "VIP", text = "VALLEY ROYALTY", rgb = { 255, 211, 126 } },
		{ id = "DefaultSkin", slot = "Skin", name = "Rift Stalker", cost = 0, skin = "Default", rgb = { 183, 122, 255 } },
		{ id = "GroveGuardian", slot = "Skin", name = "Grove Guardian", requirement = { stat = "GroveMedals", amount = 5 }, skin = "Grove", rgb = { 123, 255, 176 } },
		{ id = "RuinsSentinel", slot = "Skin", name = "Ruins Sentinel", requirement = { stat = "RuinsMedals", amount = 5 }, skin = "Ruins", rgb = { 255, 187, 125 } },
		{ id = "HarborPhantom", slot = "Skin", name = "Harbor Phantom", requirement = { stat = "HarborMedals", amount = 5 }, skin = "Harbor", rgb = { 140, 209, 255 } },
		{ id = "DefaultVictory", slot = "Victory", name = "Confetti", cost = 0, effect = "Confetti", rgb = { 201, 173, 255 } },
		{ id = "GroveBurst", slot = "Victory", name = "Crystal Bloom", requirement = { stat = "MedalPoints", amount = 6 }, effect = "Bloom", rgb = { 123, 255, 176 } },
		{ id = "RuinsBurst", slot = "Victory", name = "Sunset Sparks", requirement = { stat = "SilverMedals", amount = 5 }, effect = "Sparks", rgb = { 255, 187, 125 } },
		{ id = "HarborBurst", slot = "Victory", name = "Neon Fireworks", requirement = { stat = "GoldMedals", amount = 5 }, effect = "Fireworks", rgb = { 140, 209, 255 } },
