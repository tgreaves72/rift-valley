          <string name="Name">MusicIds</string>
          <ProtectedString name="Source">-- Public Creator Store releases by APMOfficial. Sources: assets/music/credits.json.
-- Original compositions remain in assets/music for an optional future upload.
return table.freeze({Lobby=1848354536,CrystalGrove=1848090337,SunsetRuins=9042664292,NeonHarbor=1837560230})
